---
import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import FloatingCall from "@/components/widgets/FloatingCall.astro";
import CookieConsent from "@/components/CookieConsent.astro";
import favicon from "@/assets/img/favicon.svg";
import "@/styles/main.scss";

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  pageType?: "website" | "profile";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  showHeader?: boolean;
  showFooter?: boolean;
  keywords?: string;
  lang?: string;
  author?: string;
}

const {
  title = "ORHEA | Masaż we Wrocławiu",
  description = "ORHEA oferuje masaże we Wrocławiu dopasowane do potrzeb ciała, samopoczucia i codziennego rytmu.",
  lang = "pl",
  image,
  imageAlt = "ORHEA — masaże we Wrocławiu",
  canonicalPath = Astro.url.pathname,
  robots = "index, follow",
  pageType = "website",
  jsonLd,
  showHeader = true,
  showFooter = true,
  keywords,
  author = "ORHEA",
} = Astro.props;

const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImageUrl = image ? new URL(image, siteUrl) : null;
const ogType = pageType === "profile" ? "profile" : "website";
const organizationId = new URL("/#organization", siteUrl).toString();
const websiteId = new URL("/#website", siteUrl).toString();
const siteJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: "ORHEA",
      url: new URL("/", siteUrl).toString(),
      areaServed: {
        "@type": "City",
        name: "Wrocław",
      },
    },
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: new URL("/", siteUrl).toString(),
      name: "ORHEA",
      inLanguage: "pl-PL",
      publisher: { "@id": organizationId },
    },
  ],
};

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={author} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="theme-color" content="#5e6446" />
    
    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="icon" type="image/svg+xml" href={favicon.src}>
    
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType}/>
    <meta property="og:site_name" content="ORHEA"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonicalUrl}/>
    {socialImageUrl && <meta property="og:image" content={socialImageUrl.toString()}/>}
    {socialImageUrl && <meta property="og:image:alt" content={imageAlt}/>}
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"}
    />

    <!-- Twitter/X -->
    <meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"}/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl.toString()}/>}
    {socialImageUrl && <meta name="twitter:image:alt" content={imageAlt}/>}

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(siteJsonLd)}
    />

    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

  </head>

  <body>
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    {showHeader && <Header hideOnScroll transition:persist/>}
    <main id="main-content" transition:animate="fade">
      <slot />
    </main>
    <FloatingCall phone="+48 123 456 789"/>
    {showFooter && <Footer transition:persist/>}
    <CookieConsent />
    <script>
      import "@scripts/reveal";
      import "@scripts/custom";
    </script>
  </body>
</html>
