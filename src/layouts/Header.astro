---
import Container from "@/components/layouts/Container.astro";
import Img from "@/components/media/Img.astro";
import Navbar, {
  type NavItem,
  type NavAction,
} from "@/components/widgets/Navbar.astro";

import { massageZoneDefinitions } from "@/data/massage-zones";

// assets
import Logo from "@assets/img/logo.png";
import LogoLight from "@assets/img/logo-light.png";

export interface Props {
  logoAlt?: string;
  brandHref?: string;
  navItems?: NavItem[];
  cta?: NavAction;
  sticky?: boolean;
  hideOnScroll?: boolean;
  class?: string;
}

const servicesChildren: NavItem[] = [...massageZoneDefinitions]
  .sort((a, b) => a.order - b.order)
  .map((zone) => ({
    label: zone.type === "vip" ? "ORHEA VIP" : zone.name,

    href: `/uslugi?strefa=${zone.id}#strefy-masazu`,

    isVip: zone.type === "vip",
  }));

const defaultNavItems: NavItem[] = [
  { label: "Home", href: "/" },
  { label: "Usługi", href: "/uslugi", children: servicesChildren },
  { label: "Cennik", href: "/cennik" },
  { label: "Voucher", href: "/voucher" },
  { label: "O nas", href: "/o-nas" },
  { label: "FAQ", href: "/faq" },
  { label: "Kontakt", href: "/kontakt" },
];

const defaultCta: NavAction = {
  label: "Umów wizytę",
  href: "/rezerwacja",
};

const {
  logoAlt = "Orhea – masaż i terapia ciała",
  brandHref = "/",
  navItems = defaultNavItems,
  cta = defaultCta,
  sticky = true,
  hideOnScroll = false,
  class: className,
  ...restProps
} = Astro.props;
---

<header
  {...restProps}
  data-site-header
  data-hide-on-scroll={hideOnScroll ? "true" : "false"}
  class:list={[
    "site-header",
    sticky && "site-header--sticky",
    hideOnScroll && "site-header--hide-on-scroll",
    className,
  ]}
>
  <Container size="standart">
    <div class="site-header__inner">
      <a
        class="site-header__brand"
        href={brandHref}
        aria-label="Przejdź do strony głównej"
      >
        <Img
          src={Logo}
          alt={logoAlt}
          priority="high"
          kind="content"
          widths={[80, 100]}
          sizes="100px"
          class="header__logo"
        />
        <Img
          src={LogoLight}
          alt={logoAlt}
          priority="high"
          kind="content"
          widths={[80, 100]}
          sizes="100px"
          class="header__logo--light"
        />
      </a>
      <Navbar items={navItems} cta={cta} />
    </div>
  </Container>
</header>

<script>
  const initSiteHeaders = () => {
    const headers =
      document.querySelectorAll<HTMLElement>("[data-site-header]");

    headers.forEach((header) => {
      if (header.dataset.headerInitialized === "true") {
        return;
      }

      header.dataset.headerInitialized = "true";

      if (header.dataset.hideOnScroll !== "true") {
        return;
      }

      let previousScrollY = window.scrollY;

      let ticking = false;

      const minScrollDelta = 6;

      const updateHeader = () => {
        const currentScrollY = Math.max(window.scrollY, 0);

        const delta = currentScrollY - previousScrollY;

        if (currentScrollY <= 20) {
          header.classList.remove("is-hidden");

          previousScrollY = currentScrollY;

          ticking = false;

          return;
        }

        if (Math.abs(delta) < minScrollDelta) {
          ticking = false;
          return;
        }

        const navbar = header.querySelector("[data-navbar]");

        if (navbar?.hasAttribute("data-open")) {
          header.classList.remove("is-hidden");

          previousScrollY = currentScrollY;

          ticking = false;

          return;
        }

        if (delta > 0) {
          header.classList.add("is-hidden");
        } else {
          header.classList.remove("is-hidden");
        }

        previousScrollY = currentScrollY;
        ticking = false;
      };

      window.addEventListener(
        "scroll",
        () => {
          if (ticking) {
            return;
          }

          ticking = true;

          requestAnimationFrame(updateHeader);
        },
        {
          passive: true,
        },
      );
    });
  };

  initSiteHeaders();

  document.addEventListener("astro:page-load", initSiteHeaders);
</script>
