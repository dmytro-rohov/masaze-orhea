---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Button from "@/components/ui/Button.astro";
import Card from "@/components/ui/Card.astro";
import FieldError from "@/components/form/FieldError.astro";
import FormField from "@/components/form/FormField.astro";
import FormGroup from "@/components/form/FormGroup.astro";
import Input from "@/components/form/Input.astro";
import Label from "@/components/form/Label.astro";
import Stack from "@/components/layouts/Stack.astro";
import { getSafeAdminReturnTo } from "@/server/admin/admin-auth.service";

export const prerender = false;

if (Astro.locals.admin) return Astro.redirect("/admin", 302);

const error = Astro.url.searchParams.get("error");
const returnTo = getSafeAdminReturnTo(Astro.url.searchParams.get("next"));

const errorMessage =
  error === "invalid"
    ? "Nieprawidłowy login lub hasło."
    : error === "configuration"
      ? "Logowanie administratora jest chwilowo niedostępne."
      : error === "request"
        ? "Nie udało się zweryfikować żądania. Odśwież stronę i spróbuj ponownie."
        : null;
---

<AdminLayout
  title="Logowanie"
  description="Bezpieczne logowanie do panelu administracyjnego ORHEA."
  showNavigation={false}
>
  <div class="admin-login">
    <Card variant="elevated" padding="lg" class="admin-login__card">
      <Stack space="xl">
        <header class="admin-login__header">
          <p class="admin-page__eyebrow">ORHEA Admin</p>
          <h1>Logowanie</h1>
          <p>Panel jest przeznaczony wyłącznie dla zespołu ORHEA.</p>
        </header>

        <form action="/api/admin/login" method="post" data-admin-login-form>
          <input type="hidden" name="returnTo" value={returnTo} />
          <FormGroup gap="lg">
            <FormField>
              <Label for="admin-username" required>Login</Label>
              <Input
                id="admin-username"
                name="username"
                type="text"
                autocomplete="username"
                maxlength={100}
                required
                invalid={error === "invalid"}
                describedby="admin-login-error"
              />
            </FormField>

            <FormField>
              <Label for="admin-password" required>Hasło</Label>
              <Input
                id="admin-password"
                name="password"
                type="password"
                autocomplete="current-password"
                maxlength={512}
                required
                invalid={error === "invalid"}
                describedby="admin-login-error"
              />
            </FormField>

            <div
              role="alert"
              aria-live="polite"
              tabindex="-1"
              data-admin-login-error
            >
              <FieldError id="admin-login-error">{errorMessage}</FieldError>
            </div>

            <Button type="submit" size="lg" data-admin-login-submit>
              Zaloguj się
            </Button>
          </FormGroup>
        </form>
      </Stack>
    </Card>
  </div>
</AdminLayout>

<script>
  type AdminLoginResponse = {
    success?: boolean;
    redirectTo?: string;
    message?: string;
  };

  const form = document.querySelector<HTMLFormElement>(
    "[data-admin-login-form]",
  );

  if (form && !form.dataset.initialized) {
    form.dataset.initialized = "true";

    const submit = form.querySelector<HTMLButtonElement>(
      "[data-admin-login-submit]",
    );
    const errorRegion = form.querySelector<HTMLElement>(
      "[data-admin-login-error]",
    );
    const errorMessage = form.querySelector<HTMLElement>("#admin-login-error");
    const credentialsFields = Array.from(
      form.querySelectorAll<HTMLInputElement>(
        'input[name="username"], input[name="password"]',
      ),
    );
    let submitting = false;

    const setError = (message: string) => {
      if (errorMessage) errorMessage.textContent = message;

      if (errorRegion) {
        errorRegion.focus();
      }

      credentialsFields.forEach((field) =>
        field.setAttribute("aria-invalid", "true"),
      );
    };

    credentialsFields.forEach((field) => {
      field.addEventListener("input", () => {
        credentialsFields.forEach((credentialField) =>
          credentialField.removeAttribute("aria-invalid"),
        );

        if (errorMessage) errorMessage.textContent = "";
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (submitting || !form.reportValidity()) return;

      submitting = true;
      form.setAttribute("aria-busy", "true");

      if (submit) {
        submit.disabled = true;
        submit.textContent = "Logowanie…";
      }

      if (errorMessage) errorMessage.textContent = "";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          credentials: "same-origin",
          headers: {
            Accept: "application/json",
          },
          body: new URLSearchParams(
            Array.from(new FormData(form).entries()).map(([key, value]) => [
              key,
              String(value),
            ]),
          ),
        });
        const result = (await response.json()) as AdminLoginResponse;

        if (!response.ok || !result.success || !result.redirectTo) {
          setError(
            result.message ??
              "Nie udało się zalogować. Sprawdź dane i spróbuj ponownie.",
          );
          return;
        }

        window.location.assign(result.redirectTo);
      } catch {
        setError(
          "Nie udało się połączyć z panelem. Spróbuj ponownie za chwilę.",
        );
      } finally {
        submitting = false;
        form.removeAttribute("aria-busy");

        if (submit) {
          submit.disabled = false;
          submit.textContent = "Zaloguj się";
        }
      }
    });
  }
</script>
