---
import AdminLayout from "@/layouts/AdminLayout.astro";
import Stack from "@/components/layouts/Stack.astro";
import AdminMassageForm from "@/components/admin/AdminMassageForm.astro";
import { isOwner } from "@/server/admin/admin-authorization.service";
import { getAdminMassageCreateOptions, getAdminMassageEditor } from "@/server/admin/admin-massages.service";

export const prerender = false;
const session = Astro.locals.admin;
if (!session) return Astro.redirect("/admin/login", 302);
if (!isOwner(session)) return new Response("Brak dostępu.", { status: 403 });
const editor = await getAdminMassageEditor(session, Astro.params.id ?? "");
if (!editor) return new Response("Nie znaleziono masażu.", { status: 404 });
const options = await getAdminMassageCreateOptions(session);
---

<AdminLayout title={`Edytuj: ${editor.massage.title}`}>
  <Stack space="xl" class="admin-page">
    <header class="admin-page__header"><p class="admin-page__eyebrow">ORHEA Admin</p><h1>{editor.massage.title}</h1><p>Edytuj ofertę, warianty i treści. Zmiany publiczne są widoczne od razu po zapisaniu.</p></header>
    <AdminMassageForm editor={editor} options={options} />
  </Stack>
</AdminLayout>
