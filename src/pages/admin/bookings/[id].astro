---
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import Tag from "@/components/ui/Tag.astro";
import Select from "@/components/form/Select.astro";
import Stack from "@/components/layouts/Stack.astro";
import AdminLayout from "@/layouts/AdminLayout.astro";
import {
  getAdminBookingById,
  getAdminSpecialistOptions,
} from "@/server/admin/admin-bookings.service";
import {
  adminBookingStatusTransitions,
  type AdminBookingStatus,
} from "@/server/admin/admin-booking-status.service";
import { getBookingZonedDateTime } from "@/server/bookings/booking-time-zone";
import { isOwner } from "@/server/admin/admin-authorization.service";
import { BOOKING_PAYMENT_HOLD_MINUTES } from "@/server/payments/booking-payment.config";

export const prerender = false;

const session = Astro.locals.admin;

if (!session) return Astro.redirect("/admin/login", 302);

const booking = await getAdminBookingById(session, Astro.params.id ?? "");

if (!booking) Astro.response.status = 404;

const dateTimeFormatter = new Intl.DateTimeFormat("pl-PL", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "Europe/Warsaw",
});
const currencyFormatter = new Intl.NumberFormat("pl-PL", {
  style: "currency",
  currency: "PLN",
});

const statusLabels = {
  pending: "Oczekuje",
  confirmed: "Potwierdzona",
  cancelled: "Anulowana",
  completed: "Zakończona",
  rejected: "Odrzucona",
  no_show: "Nieobecność",
} as const;
const calendarSyncLabels = {
  pending: "Oczekuje",
  synced: "Zsynchronizowany",
  failed: "Błąd synchronizacji",
} as const;
const locationVerificationLabels = {
  not_required: "Nie wymaga weryfikacji",
  pending: "Oczekuje na weryfikację",
  approved: "Zaakceptowana",
  rejected: "Odrzucona",
} as const;
const paymentMethodLabels = {
  online: "Online",
  on_site: "Na miejscu",
} as const;
const paymentStatusLabels = {
  unpaid: "Nieopłacona",
  pending: "Oczekuje na płatność",
  paid: "Opłacona",
  failed: "Płatność nieudana",
  refunded: "Zwrócona",
} as const;

const formatDateTime = (value: Date | null) =>
  value ? dateTimeFormatter.format(value) : "—";
const formatHistoryRange = (start: Date | null, end: Date | null) =>
  start && end
    ? `${dateTimeFormatter.format(start)} – ${dateTimeFormatter.format(end)}`
    : "—";
const mobileStreetLine = booking
  ? [booking.mobileStreet, booking.mobileBuildingNumber]
      .filter(Boolean)
      .join(" ") +
    (booking.mobileApartmentNumber ? `/${booking.mobileApartmentNumber}` : "")
  : "";
const mobileAddress =
  booking?.locationType === "mobile"
    ? [
        mobileStreetLine,
        `${booking.mobilePostalCode ?? ""} ${booking.mobileCity ?? ""}`.trim(),
      ]
        .filter(Boolean)
        .join(", ")
    : null;
const effectiveStartAt = booking
  ? (booking.confirmedStartAt ?? booking.requestedStartAt)
  : null;
const effectiveEndAt = booking
  ? (booking.confirmedEndAt ?? booking.requestedEndAt)
  : null;
const lifecycleEvent = booking
  ? booking.status === "confirmed" && booking.confirmedAt
    ? { label: "Potwierdzono wizytę", timestamp: booking.confirmedAt }
    : booking.status === "cancelled" && booking.cancelledAt
      ? { label: "Odwołano wizytę", timestamp: booking.cancelledAt }
      : booking.status === "rejected" && booking.rejectedAt
        ? { label: "Odrzucono wizytę", timestamp: booking.rejectedAt }
        : null
  : null;
const effectiveLocalStart = effectiveStartAt
  ? getBookingZonedDateTime(effectiveStartAt)
  : null;
const rescheduleDate = effectiveLocalStart?.dateKey ?? "";
const rescheduleTime = effectiveLocalStart
  ? `${String(Math.floor(effectiveLocalStart.secondsSinceMidnight / 3600)).padStart(2, "0")}:${String(Math.floor((effectiveLocalStart.secondsSinceMidnight % 3600) / 60)).padStart(2, "0")}`
  : "";
const canReschedule =
  (booking?.status === "pending" || booking?.status === "confirmed") &&
  (booking.paymentMethod !== "online" || (booking.paymentExpiresAt === null &&
    (booking.paymentStatus !== "paid" || booking.calendarSyncStatus !== "pending")));
const owner = isOwner(session);
const canGeneratePaymentLink = owner && booking &&
  !["cancelled", "rejected"].includes(booking.status) &&
  !["paid", "refunded"].includes(booking.paymentStatus) &&
  (booking.paymentMethod === "on_site" || booking.paymentExpiresAt === null) &&
  booking.totalPriceGroszeSnapshot > 0;
const paymentLinkMayBeExpired = booking?.payment?.status === "failed" ||
  (booking?.payment?.status === "pending" &&
    Date.now() - booking.payment.createdAt.getTime() >= BOOKING_PAYMENT_HOLD_MINUTES * 60 * 1000);
const specialistOptions = booking ? await getAdminSpecialistOptions() : [];
const specialistLabels = new Map(
  specialistOptions.map((specialist) => [specialist.id, specialist.name]),
);
if (booking) {
  specialistLabels.set(booking.specialistId, booking.specialistName);
}

const getHistoryActorLabel = (event: {
  actorUsername: string | null;
  actorRole: string | null;
}) =>
  event.actorUsername ??
  (event.actorRole === "owner" ? "Administrator" : "Brak danych o autorze");

const actionConfiguration: Partial<
  Record<
    AdminBookingStatus,
    { label: string; pendingLabel: string; destructive?: boolean }
  >
> = {
  confirmed: {
    label: "Potwierdź wizytę",
    pendingLabel: "Potwierdzanie…",
  },
  rejected: {
    label: "Odrzuć wizytę",
    pendingLabel: "Odrzucanie…",
    destructive: true,
  },
  cancelled: {
    label: "Anuluj wizytę",
    pendingLabel: "Anulowanie…",
    destructive: true,
  },
  completed: {
    label: "Oznacz jako zakończoną",
    pendingLabel: "Zapisywanie…",
  },
  no_show: {
    label: "Nieobecność klienta",
    pendingLabel: "Zapisywanie…",
  },
};
const allowedActions = booking
  ? adminBookingStatusTransitions[booking.status]
      .filter((status) => status !== "confirmed" || booking.paymentMethod !== "online" ||
        (booking.paymentExpiresAt === null && (booking.paymentStatus !== "paid" || booking.calendarSyncStatus !== "pending")))
      .map((status) => {
        const configuration = actionConfiguration[status];

        return configuration ? { status, ...configuration } : null;
      })
      .filter(
        (
          action,
        ): action is {
          status: AdminBookingStatus;
          label: string;
          pendingLabel: string;
          destructive?: boolean;
        } => action !== null,
      )
  : [];
---

<AdminLayout
  title={booking
    ? `Rezerwacja ${booking.id}`
    : "Nie znaleziono rezerwacji"}
  currentPath="/admin/bookings"
>
  <Stack space="xl" class="admin-page">
    <header class="admin-page__header">
      <p class="admin-page__eyebrow">Rezerwacje</p>
      <h1>
        {booking ? "Szczegóły rezerwacji" : "Nie znaleziono rezerwacji"}
      </h1>
      <p>
        {
          booking
            ? "Pełny zapis rezerwacji i dostępne działania administracyjne."
            : "Rezerwacja nie istnieje lub nie masz do niej dostępu."
        }
      </p>
    </header>

    {
      !booking ? (
        <Card variant="outlined" padding="lg" class="admin-error">
          <p><a href="/admin/bookings">Wróć do listy rezerwacji</a></p>
        </Card>
      ) : (
        <>
          <div class="admin-detail-actions">
            <a href="/admin/bookings">← Wróć do listy</a>
          </div>

          <Card
            as="section"
            variant="outlined"
            padding="lg"
            class="admin-booking-actions"
          >
            <div>
              <span
                class:list={[
                  "admin-status",
                  `admin-status--${booking.status.replaceAll("_", "-")}`,
                ]}
              >
                {statusLabels[booking.status]}
              </span>
              <h2>Akcje</h2>
              <p>
                {allowedActions.length > 0 ||
                booking.calendarSyncStatus === "failed"
                  ? "Wybierz dostępne działanie dla rezerwacji."
                  : "Ta rezerwacja ma status końcowy i nie wymaga dalszych działań."}
              </p>
            </div>

            {(allowedActions.length > 0 ||
              booking.calendarSyncStatus === "failed") && (
              <div class="admin-booking-actions__buttons">
                {allowedActions.map((action) => (
                  <form
                    action={`/api/admin/bookings/${booking.id}/status`}
                    method="post"
                    data-booking-status-form
                    data-confirm={action.destructive
                      ? action.status === "cancelled"
                        ? "Czy na pewno chcesz anulować tę wizytę? Powiązane wydarzenie zostanie usunięte z kalendarza."
                        : "Czy na pewno chcesz odrzucić tę wizytę? Powiązane wydarzenie zostanie usunięte z kalendarza."
                      : undefined}
                  >
                    <input type="hidden" name="status" value={action.status} />
                    <Button
                      type="submit"
                      variant={action.destructive ? "danger" : "primary"}
                      data-pending-label={action.pendingLabel}
                    >
                      {action.label}
                    </Button>
                  </form>
                ))}

                {booking.calendarSyncStatus === "failed" && (
                  <form
                    action={`/api/admin/bookings/${booking.id}/calendar-retry`}
                    method="post"
                    data-booking-calendar-retry-form
                  >
                    <Button
                      type="submit"
                      variant="secondary"
                      data-pending-label="Synchronizowanie…"
                    >
                      Ponów synchronizację kalendarza
                    </Button>
                  </form>
                )}
              </div>
            )}

            <p
              class="admin-booking-actions__status"
              role="alert"
              aria-live="polite"
              tabindex="-1"
              data-booking-action-status
            ></p>
          </Card>

          {canReschedule && (
            <Card
              as="section"
              variant="outlined"
              padding="lg"
              class="admin-booking-reschedule"
            >
              <div>
                <h2>Termin i specjalista</h2>
                <p>
                  {owner
                    ? "Docelowy specjalista i termin zostaną sprawdzone razem, a następnie zsynchronizowane z kalendarzem."
                    : "Nowy termin zostanie sprawdzony według Twojej aktualnej dostępności i zsynchronizowany z kalendarzem."}
                </p>
              </div>

              <form
                action={owner
                  ? `/api/admin/bookings/${booking.id}/schedule`
                  : `/api/admin/bookings/${booking.id}/reschedule`}
                method="post"
                novalidate
                data-booking-reschedule-form
              >
                <div class="admin-booking-reschedule__fields">
                  {owner && (
                    <div class="form-field">
                      <label
                        class="label label--required"
                        for="schedule-specialist"
                      >
                        Specjalista
                        <span class="label__required" aria-hidden="true">*</span>
                      </label>
                      <Select
                        id="schedule-specialist"
                        name="specialistId"
                        value={booking.specialistId}
                        options={specialistOptions.map((specialist) => ({
                          value: specialist.id,
                          label: specialist.name,
                        }))}
                        required
                        describedby="booking-reschedule-status"
                      />
                    </div>
                  )}

                  <div class="form-field">
                    <label class="label label--required" for="reschedule-date">
                      Data
                      <span class="label__required" aria-hidden="true">*</span>
                    </label>
                    <input
                      class="input"
                      id="reschedule-date"
                      name="date"
                      type="date"
                      value={rescheduleDate}
                      required
                      aria-describedby="booking-reschedule-status"
                    />
                  </div>

                  <div class="form-field">
                    <label class="label label--required" for="reschedule-time">
                      Godzina
                      <span class="label__required" aria-hidden="true">*</span>
                    </label>
                    <input
                      class="input"
                      id="reschedule-time"
                      name="time"
                      type="time"
                      value={rescheduleTime}
                      step="60"
                      required
                      aria-describedby="booking-reschedule-status"
                    />
                  </div>
                </div>

                <Button
                  type="submit"
                  variant="secondary"
                  data-pending-label="Sprawdzanie zmian…"
                >
                  Zapisz zmiany
                </Button>

                <p
                  id="booking-reschedule-status"
                  class="admin-booking-reschedule__status"
                  role="alert"
                  aria-live="polite"
                  tabindex="-1"
                  data-booking-reschedule-status
                ></p>
              </form>
            </Card>
          )}

          <div class="admin-detail-grid">
            <Card
              as="section"
              variant="default"
              padding="lg"
              class="admin-detail-card"
            >
              <h2>Status i identyfikatory</h2>
              <dl class="admin-detail-list">
                <div><dt>ID rezerwacji</dt><dd>{booking.id}</dd></div>
                <div><dt>Status</dt><dd>{statusLabels[booking.status]}</dd></div>
                <div>
                  <dt>Źródło</dt>
                  <dd>
                    {booking.source === "admin"
                      ? "Dodana ręcznie przez administratora"
                      : "Formularz rezerwacji klienta"}
                  </dd>
                </div>
                {booking.source === "admin" && (
                  <div>
                    <dt>Utworzył</dt>
                    <dd>{booking.createdByUsername ?? "Administrator"}</dd>
                  </div>
                )}
                {booking.availabilityOverride && (
                  <div>
                    <dt>Dostępność</dt>
                    <dd>Utworzona mimo konfliktu dostępności</dd>
                  </div>
                )}
                <div>
                  <dt>Synchronizacja kalendarza</dt>
                  <dd>{calendarSyncLabels[booking.calendarSyncStatus]}</dd>
                </div>
                <div>
                  <dt>Błąd synchronizacji</dt>
                  <dd>{booking.calendarSyncLastError ?? "Brak błędu"}</dd>
                </div>
                <div>
                  <dt>ID wydarzenia Google</dt>
                  <dd>{booking.googleCalendarEventId ?? "Brak wydarzenia"}</dd>
                </div>
              </dl>
              {booking.availabilityOverride &&
                Array.isArray(booking.availabilityOverrideReasons) && (
                  <div class="admin-booking-override-reasons">
                    <h3>Zapisane ostrzeżenia</h3>
                    <ul>
                      {booking.availabilityOverrideReasons.map((reason) => (
                        <li>{reason.message}</li>
                      ))}
                    </ul>
                  </div>
                )}
            </Card>

            <Card
              as="section"
              variant="default"
              padding="lg"
              class="admin-detail-card"
            >
              <h2>Usługa</h2>
              <dl class="admin-detail-list">
                <div><dt>Masaż</dt><dd>{booking.massageNameSnapshot}</dd></div>
                <div>
                  <dt>Wariant</dt>
                  <dd>
                    {booking.durationLabelSnapshot ??
                      (booking.durationMinutesSnapshot
                        ? `${booking.durationMinutesSnapshot} min`
                        : "—")}
                  </dd>
                </div>
                <div>
                  <dt>Czas masażu</dt>
                  <dd>
                    {booking.durationMinutesSnapshot
                      ? `${booking.durationMinutesSnapshot} min`
                      : booking.durationLabelSnapshot ?? "—"}
                  </dd>
                </div>
                <div>
                  <dt>Czas slotu</dt>
                  <dd>{booking.bookingSlotMinutesSnapshot} min</dd>
                </div>
                <div>
                  <dt>Cena bazowa</dt>
                  <dd>
                    {currencyFormatter.format(booking.priceGroszeSnapshot / 100)}
                  </dd>
                </div>
                <div>
                  <dt>Dodatki</dt>
                  <dd>
                    {booking.selectedAddons.length === 0
                      ? "Brak dodatków"
                      : booking.selectedAddons.map((addon) => `${addon.name} (+${currencyFormatter.format(addon.priceGrosze / 100)})`).join(", ")}
                  </dd>
                </div>
                <div>
                  <dt>Cena dodatków</dt>
                  <dd>{currencyFormatter.format((booking.totalPriceGroszeSnapshot - booking.priceGroszeSnapshot) / 100)}</dd>
                </div>
                <div>
                  <dt>Razem</dt>
                  <dd>{currencyFormatter.format(booking.totalPriceGroszeSnapshot / 100)}</dd>
                </div>
                <div><dt>Specjalista</dt><dd>{booking.specialistName}</dd></div>
              </dl>
            </Card>

            <Card
              as="section"
              variant="default"
              padding="lg"
              class="admin-detail-card"
            >
              <h2>Płatność</h2>
              <dl class="admin-detail-list">
                <div>
                  <dt>Metoda</dt>
                  <dd data-booking-payment-method>{paymentMethodLabels[booking.paymentMethod]}</dd>
                </div>
                <div>
                  <dt>Status</dt>
                  <dd>
                    <Tag
                      data-booking-payment-status
                      variant={booking.paymentStatus === "paid"
                        ? "success"
                        : booking.paymentStatus === "failed"
                          ? "danger"
                          : booking.paymentStatus === "refunded"
                            ? "muted"
                            : "warning"}
                    >
                      {paymentStatusLabels[booking.paymentStatus]}
                    </Tag>
                  </dd>
                </div>
                <div>
                  <dt>Kwota</dt>
                  <dd>{currencyFormatter.format(booking.totalPriceGroszeSnapshot / 100)}</dd>
                </div>
                {booking.paymentMethod === "online" && booking.payment?.paidAt && (
                  <div><dt>Opłacono</dt><dd>{formatDateTime(booking.payment.paidAt)}</dd></div>
                )}
                {booking.paymentMethod === "online" && booking.paymentStatus === "paid" && (
                  <div><dt>Zwrot</dt><dd>Anulowanie lub odrzucenie wizyty nie zwraca automatycznie płatności Stripe.</dd></div>
                )}
                {booking.paymentMethod === "online" && booking.paymentStatus === "paid" && booking.paymentExpiresAt && (
                  <div><dt>Uwaga</dt><dd>Płatność wymaga ręcznego wyjaśnienia terminu. Nie utworzono wydarzenia Google.</dd></div>
                )}
                {booking.paymentStatus === "paid" && ["cancelled", "rejected"].includes(booking.status) && (
                  <div><dt>Uwaga</dt><dd>Płatność wpłynęła po anulowaniu lub odrzuceniu rezerwacji. Wymaga ręcznego wyjaśnienia.</dd></div>
                )}
              </dl>
              {canGeneratePaymentLink && (
                <div class="admin-booking-payment" data-booking-payment-link data-booking-id={booking.id}>
                  <p>{paymentLinkMayBeExpired
                    ? "Poprzedni link wygasł, nie powiódł się albo może być już nieaktywny. Stripe zostanie sprawdzony przed utworzeniem nowego."
                    : booking.paymentStatus === "pending"
                      ? "Link płatniczy został utworzony. Możesz pobrać go ponownie lub wysłać klientowi."
                      : "Utwórz bezpieczny link Stripe dla tej rezerwacji."}</p>
                  <div class="admin-booking-actions__buttons">
                    <Button type="button" variant="secondary" data-payment-generate>
                      {paymentLinkMayBeExpired ? "Wygeneruj nowy link" : booking.paymentStatus === "pending" ? "Pobierz link" : "Wygeneruj link do płatności"}
                    </Button>
                    <span hidden data-payment-copy-wrapper><Button type="button" variant="secondary" data-payment-copy>Kopiuj link</Button></span>
                    <Button type="button" variant="secondary" data-payment-send>Wyślij link e-mailem</Button>
                  </div>
                  <p role="status" aria-live="polite" tabindex="-1" data-payment-link-status></p>
                </div>
              )}
            </Card>

            <Card
              as="section"
              variant="default"
              padding="lg"
              class="admin-detail-card"
            >
              <h2>Termin</h2>
              <dl class="admin-detail-list">
                <div>
                  <dt>Rezerwacja utworzona</dt>
                  <dd>{formatDateTime(booking.createdAt)}</dd>
                </div>
                <div>
                  <dt>Termin masażu — od</dt>
                  <dd>{formatDateTime(effectiveStartAt)}</dd>
                </div>
                <div>
                  <dt>Termin masażu — do</dt>
                  <dd>{formatDateTime(effectiveEndAt)}</dd>
                </div>
                {lifecycleEvent && (
                  <div>
                    <dt>{lifecycleEvent.label}</dt>
                    <dd>{formatDateTime(lifecycleEvent.timestamp)}</dd>
                  </div>
                )}
              </dl>
            </Card>

            <Card
              as="section"
              variant="default"
              padding="lg"
              class="admin-detail-card"
            >
              <h2>Klient</h2>
              <dl class="admin-detail-list">
                <div>
                  <dt>Imię i nazwisko</dt>
                  <dd>{booking.customerFirstName} {booking.customerLastName}</dd>
                </div>
                <div>
                  <dt>E-mail</dt>
                  <dd>
                    <a href={`mailto:${booking.customerEmail}`}>
                      {booking.customerEmail}
                    </a>
                  </dd>
                </div>
                <div>
                  <dt>Telefon</dt>
                  <dd>
                    {booking.customerPhone ? (
                      <a href={`tel:${booking.customerPhone}`}>
                        {booking.customerPhone}
                      </a>
                    ) : "Brak numeru telefonu"}
                  </dd>
                </div>
              </dl>
            </Card>

            <Card
              as="section"
              variant="default"
              padding="lg"
              class="admin-detail-card"
            >
              <h2>Uwagi klienta</h2>
              <p class="admin-customer-notes">
                {booking.notes?.trim() || "Brak uwag"}
              </p>
            </Card>

            <Card
              as="section"
              variant="default"
              padding="lg"
              class="admin-detail-card"
            >
              <h2>Miejsce wizyty</h2>
              <dl class="admin-detail-list">
                <div>
                  <dt>Rodzaj</dt>
                  <dd>
                    {booking.locationType === "salon"
                      ? "Salon ORHEA"
                      : "Usługa mobilna"}
                  </dd>
                </div>
                <div><dt>Adres mobilny</dt><dd>{mobileAddress ?? "—"}</dd></div>
                <div>
                  <dt>Weryfikacja lokalizacji</dt>
                  <dd>
                    {locationVerificationLabels[
                      booking.locationVerificationStatus
                    ]}
                  </dd>
                </div>
              </dl>
            </Card>

            <Card
              as="section"
              variant="default"
              padding="lg"
              class="admin-detail-card"
            >
              <h2>Historia techniczna</h2>
              <dl class="admin-detail-list">
                <div>
                  <dt>Utworzono</dt>
                  <dd>{formatDateTime(booking.createdAt)}</dd>
                </div>
                <div>
                  <dt>Ostatnia aktualizacja</dt>
                  <dd>{formatDateTime(booking.updatedAt)}</dd>
                </div>
                <div>
                  <dt>Ostatnia próba synchronizacji</dt>
                  <dd>{formatDateTime(booking.calendarSyncAttemptedAt)}</dd>
                </div>
                <div>
                  <dt>Zsynchronizowano</dt>
                  <dd>{formatDateTime(booking.calendarSyncedAt)}</dd>
                </div>
              </dl>
            </Card>
          </div>

          <Card
            as="section"
            variant="default"
            padding="lg"
            class="admin-list-card"
          >
            <div class="admin-list-card__header">
              <div>
                <h2>Historia rezerwacji</h2>
                <p>Operacyjne zmiany statusu, terminu i specjalisty.</p>
              </div>
            </div>

            {booking.history.length > 0 ? (
              <ul class="admin-record-list admin-booking-history">
                {booking.history.map((event) => (
                  <li>
                    <div>
                      {event.eventType === "status_changed" && (
                        <>
                          <strong>Status zmieniono</strong>
                          <span>
                            {event.fromStatus
                              ? statusLabels[event.fromStatus]
                              : "—"}
                            {" → "}
                            {event.toStatus ? statusLabels[event.toStatus] : "—"}
                          </span>
                        </>
                      )}

                      {event.eventType === "rescheduled" && (
                        <>
                          <strong>Termin zmieniono</strong>
                          <span>
                            {formatHistoryRange(
                              event.previousStartAt,
                              event.previousEndAt,
                            )}
                            {" → "}
                            {formatHistoryRange(event.newStartAt, event.newEndAt)}
                          </span>
                        </>
                      )}

                      {event.eventType === "specialist_changed" && (
                        <>
                          <strong>Specjalistę zmieniono</strong>
                          <span>
                            {specialistLabels.get(
                              event.previousSpecialistId ?? "",
                            ) ?? event.previousSpecialistId ?? "—"}
                            {" → "}
                            {specialistLabels.get(event.newSpecialistId ?? "") ??
                              event.newSpecialistId ??
                              "—"}
                          </span>
                        </>
                      )}

                      {event.eventType === "payment_link_created" && <strong>Utworzono link do płatności</strong>}
                      {event.eventType === "payment_link_sent" && <strong>Wysłano link do płatności</strong>}
                      {event.eventType === "payment_paid" && <strong>Otrzymano płatność Stripe</strong>}

                      <span>Przez: {event.eventType === "payment_paid" ? "Stripe" : getHistoryActorLabel(event)}</span>
                    </div>

                    <div class="admin-record-list__meta">
                      <time datetime={event.createdAt.toISOString()}>
                        {formatDateTime(event.createdAt)}
                      </time>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="admin-empty-state">Brak historii zmian rezerwacji.</p>
            )}
          </Card>
        </>
      )
    }
  </Stack>
</AdminLayout>

<script>
  type BookingActionResponse = {
    success?: boolean;
    message?: string;
    warning?: string;
  };

  const bookingMutationWarningKey = "orhea-admin-booking-mutation-warning";

  const reloadAfterBookingMutation = (result: BookingActionResponse) => {
    if (result.warning) {
      sessionStorage.setItem(bookingMutationWarningKey, result.warning);
    }

    window.location.reload();
  };

  const restoreBookingMutationWarning = () => {
    const warning = sessionStorage.getItem(bookingMutationWarningKey);
    if (!warning) return;

    sessionStorage.removeItem(bookingMutationWarningKey);
    const statusRegion = document.querySelector<HTMLElement>(
      "[data-booking-action-status]",
    );

    if (statusRegion) {
      statusRegion.textContent = warning;
      statusRegion.focus();
    }
  };

  const initBookingStatusForms = () => {
    const forms = Array.from(
      document.querySelectorAll<HTMLFormElement>(
        "[data-booking-status-form]",
      ),
    );

    forms.forEach((form) => {
      if (form.dataset.initialized === "true") return;
      form.dataset.initialized = "true";

      const controller = new AbortController();

      form.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          const submitButton = form.querySelector<HTMLButtonElement>(
            'button[type="submit"]',
          );
          const statusRegion = document.querySelector<HTMLElement>(
            "[data-booking-action-status]",
          );
          const confirmationMessage = form.dataset.confirm;

          if (!submitButton || submitButton.disabled) return;
          if (confirmationMessage && !window.confirm(confirmationMessage)) {
            return;
          }

          const originalLabel = submitButton.textContent ?? "Zapisz";
          const pendingLabel =
            submitButton.dataset.pendingLabel ?? "Zapisywanie…";
          let requestSucceeded = false;

          forms.forEach((currentForm) => {
            const button = currentForm.querySelector<HTMLButtonElement>(
              'button[type="submit"]',
            );
            if (button) button.disabled = true;
          });
          submitButton.textContent = pendingLabel;
          if (statusRegion) statusRegion.textContent = "";

          try {
            const response = await fetch(form.action, {
              method: "POST",
              credentials: "same-origin",
              headers: {
                Accept: "application/json",
                "Content-Type": "application/x-www-form-urlencoded",
              },
              body: new URLSearchParams(
                Array.from(new FormData(form).entries()).map(([key, value]) => [
                  key,
                  String(value),
                ]),
              ),
              signal: controller.signal,
            });
            const result = (await response.json()) as BookingActionResponse;

            if (!response.ok || !result.success) {
              throw new Error(
                result.message ?? "Nie udało się zmienić statusu rezerwacji.",
              );
            }

            requestSucceeded = true;
            reloadAfterBookingMutation(result);
          } catch (error) {
            if (error instanceof DOMException && error.name === "AbortError") {
              return;
            }

            if (statusRegion) {
              statusRegion.textContent =
                error instanceof Error
                  ? error.message
                  : "Nie udało się zmienić statusu rezerwacji.";
              statusRegion.focus();
            }
          } finally {
            if (!requestSucceeded) {
              forms.forEach((currentForm) => {
                const button = currentForm.querySelector<HTMLButtonElement>(
                  'button[type="submit"]',
                );
                if (button) button.disabled = false;
              });
              submitButton.textContent = originalLabel;
            }
          }
        },
        { signal: controller.signal },
      );

      document.addEventListener(
        "astro:before-swap",
        () => controller.abort(),
        { once: true, signal: controller.signal },
      );
    });
  };

  initBookingStatusForms();
  document.addEventListener("astro:page-load", initBookingStatusForms);
  restoreBookingMutationWarning();
  document.addEventListener("astro:page-load", restoreBookingMutationWarning);

  const initBookingCalendarRetryForm = () => {
    const form = document.querySelector<HTMLFormElement>(
      "[data-booking-calendar-retry-form]",
    );

    if (!form || form.dataset.initialized === "true") return;
    form.dataset.initialized = "true";

    const controller = new AbortController();
    const submitButton = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const statusRegion = document.querySelector<HTMLElement>(
      "[data-booking-action-status]",
    );

    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        if (!submitButton || submitButton.disabled) return;

        const originalLabel =
          submitButton.textContent ?? "Ponów synchronizację kalendarza";
        const pendingLabel =
          submitButton.dataset.pendingLabel ?? "Synchronizowanie…";
        let requestSucceeded = false;

        submitButton.disabled = true;
        submitButton.textContent = pendingLabel;
        if (statusRegion) statusRegion.textContent = "";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            credentials: "same-origin",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/x-www-form-urlencoded",
            },
            body: new URLSearchParams(),
            signal: controller.signal,
          });
          const result = (await response.json()) as BookingActionResponse;

          if (!response.ok || !result.success) {
            throw new Error(
              result.message ??
                "Nie udało się ponowić synchronizacji kalendarza.",
            );
          }

          requestSucceeded = true;
          reloadAfterBookingMutation(result);
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") {
            return;
          }

          if (statusRegion) {
            statusRegion.textContent =
              error instanceof Error
                ? error.message
                : "Nie udało się ponowić synchronizacji kalendarza.";
            statusRegion.focus();
          }
        } finally {
          if (!requestSucceeded) {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }
        }
      },
      { signal: controller.signal },
    );

    document.addEventListener(
      "astro:before-swap",
      () => controller.abort(),
      { once: true, signal: controller.signal },
    );
  };

  initBookingCalendarRetryForm();
  document.addEventListener(
    "astro:page-load",
    initBookingCalendarRetryForm,
  );

  const initBookingRescheduleForm = () => {
    const form = document.querySelector<HTMLFormElement>(
      "[data-booking-reschedule-form]",
    );

    if (!form || form.dataset.initialized === "true") return;
    form.dataset.initialized = "true";

    const controller = new AbortController();
    const submitButton = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    const statusRegion = form.querySelector<HTMLElement>(
      "[data-booking-reschedule-status]",
    );

    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        if (!submitButton || submitButton.disabled) return;

        if (!form.checkValidity()) {
          if (statusRegion) {
            statusRegion.textContent =
              "Wybierz specjalistę oraz podaj datę i godzinę wizyty.";
            statusRegion.focus();
          }
          form.querySelector<HTMLInputElement>(":invalid")?.focus();
          return;
        }

        const originalLabel = submitButton.textContent ?? "Zapisz zmiany";
        const pendingLabel =
          submitButton.dataset.pendingLabel ?? "Sprawdzanie terminu…";
        let requestSucceeded = false;

        submitButton.disabled = true;
        submitButton.textContent = pendingLabel;
        if (statusRegion) statusRegion.textContent = "";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            credentials: "same-origin",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/x-www-form-urlencoded",
            },
            body: new URLSearchParams(
              Array.from(new FormData(form).entries()).map(([key, value]) => [
                key,
                String(value),
              ]),
            ),
            signal: controller.signal,
          });
          const result = (await response.json()) as BookingActionResponse;

          if (!response.ok || !result.success) {
            throw new Error(
              result.message ?? "Nie udało się zapisać zmian rezerwacji.",
            );
          }

          requestSucceeded = true;
          reloadAfterBookingMutation(result);
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") {
            return;
          }

          if (statusRegion) {
            statusRegion.textContent =
              error instanceof Error
                ? error.message
                  : "Nie udało się zapisać zmian rezerwacji.";
            statusRegion.focus();
          }
        } finally {
          if (!requestSucceeded) {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }
        }
      },
      { signal: controller.signal },
    );

    document.addEventListener(
      "astro:before-swap",
      () => controller.abort(),
      { once: true, signal: controller.signal },
    );
  };

  initBookingRescheduleForm();
  document.addEventListener("astro:page-load", initBookingRescheduleForm);

  const initBookingPaymentLink = () => {
    const root = document.querySelector<HTMLElement>("[data-booking-payment-link]");
    if (!root || root.dataset.initialized === "true") return;
    root.dataset.initialized = "true";

    const bookingId = root.dataset.bookingId;
    const generate = root.querySelector<HTMLButtonElement>("[data-payment-generate]");
    const copy = root.querySelector<HTMLButtonElement>("[data-payment-copy]");
    const copyWrapper = root.querySelector<HTMLElement>("[data-payment-copy-wrapper]");
    const send = root.querySelector<HTMLButtonElement>("[data-payment-send]");
    const status = root.querySelector<HTMLElement>("[data-payment-link-status]");
    if (!bookingId || !generate || !copy || !copyWrapper || !send || !status) return;

    let checkoutUrl: string | null = null;
    const buttons = [generate, copy, send];
    const controller = new AbortController();
    const requestLink = async (action: "generate" | "send") => {
      root.setAttribute("aria-busy", "true");
      buttons.forEach((button) => { button.disabled = true; });
      status.textContent = action === "send" ? "Wysyłanie linku…" : "Przygotowywanie linku…";
      try {
        const endpoint = `/api/admin/bookings/${bookingId}/payment-link${action === "send" ? "/send" : ""}`;
        const response = await fetch(endpoint, {
          method: "POST",
          credentials: "same-origin",
          headers: { Accept: "application/json" },
          signal: controller.signal,
        });
        const result = await response.json() as { success?: boolean; message?: string; checkoutUrl?: string; reused?: boolean };
        if (!response.ok || !result.success || !result.checkoutUrl) {
          throw new Error(result.message ?? "Nie udało się przygotować linku.");
        }
        checkoutUrl = result.checkoutUrl;
        copyWrapper.hidden = false;
        generate.textContent = "Pobierz link ponownie";
        const method = document.querySelector<HTMLElement>("[data-booking-payment-method]");
        const paymentStatus = document.querySelector<HTMLElement>("[data-booking-payment-status]");
        if (method) method.textContent = "Online";
        if (paymentStatus) paymentStatus.textContent = "Oczekuje na płatność";
        status.textContent = action === "send"
          ? "Link został wysłany klientowi e-mailem."
          : result.reused ? "Pobrano aktywny link Stripe." : "Utworzono nowy link Stripe.";
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        status.textContent = error instanceof Error ? error.message : "Nie udało się przygotować linku.";
        status.focus();
      } finally {
        root.removeAttribute("aria-busy");
        buttons.forEach((button) => { button.disabled = false; });
      }
    };

    generate.addEventListener("click", () => { void requestLink("generate"); }, { signal: controller.signal });
    send.addEventListener("click", () => { void requestLink("send"); }, { signal: controller.signal });
    copy.addEventListener("click", async () => {
      if (!checkoutUrl) return;
      try {
        await navigator.clipboard.writeText(checkoutUrl);
        status.textContent = "Link skopiowany.";
      } catch {
        status.textContent = "Nie udało się skopiować linku. Spróbuj ponownie w bezpiecznej przeglądarce.";
        status.focus();
      }
    }, { signal: controller.signal });

    document.addEventListener("astro:before-swap", () => controller.abort(), { once: true, signal: controller.signal });
  };

  initBookingPaymentLink();
  document.addEventListener("astro:page-load", initBookingPaymentLink);
</script>
