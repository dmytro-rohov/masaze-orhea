            type: "video/mp4",
          }
        ],
        label: "Masaż relaksacyjny",
      },
    ]}
  initialActiveIndex={2}
  action={{
    label: "Zobacz ofertę",
    href: "/uslugi",
  }}
/>

<MassageZones tone="inverse"/>

<VipRitual/>

<FirstVisitSteps/>

<FAQ
  title="FAQ"
  description="Szybkie odpowiedzi na pytania, które słyszymy najczęściej. Resztę znajdziesz na stronie FAQ."
  items={homeFaqItems}
  accordionVariant="boxed"
  footerTitle="Nie znalazłeś odpowiedzi?"
  footerDescription="Skontaktuj się z nami — chętnie pomożemy."
  action={{
    label: "Umów wizytę",
    href: "/rezerwacja",
  }}
/>

<CTA
  title="Umów wizytę i daj ciału chwilę spokoju"
  description="Wybierz dogodny termin lub napisz do nas - pomożemy Ci dobrać masaż dopasowany do Twoich potrzeb."
  primaryAction={{
    label: "Umów wizytę",
    href: "/rezerwacja",
    icon: "ic-calendar",
  }}
  secondaryAction={{
    label: "Kup Voucher",
    href: "/voucher",
  }}
/>
</BaseLayout>