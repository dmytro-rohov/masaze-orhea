---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/widgets/Hero.astro";
import MassageTechniques from "@/components/widgets/MassageTechniques.astro";
import MassageTechniquesRow from "@/components/widgets/MassageTechniquesRow.astro";
import MassageZones from "@/components/widgets/MassageZones.astro";
import VipRitual from "@/components/widgets/VipRitual.astro";
import FirstVisitSteps from "@/components/widgets/FirstVisitSteps.astro";
import CTA from "@/components/widgets/CTA.astro";
import FAQ from "@/components/widgets/FAQ.astro";
import { homeFaqItems } from "@/data/faq";

// assets
import Logo from "@assets/img/logo.png";
import heroImage from "@/assets/img/hero-banner.png";
import massagePoster from "@/assets/img/hero-banner.png";

// videos
import heroVideoWebm from "@/assets/video/hero-video.webm";
import heroVideoMp4 from "@/assets/video/hero-video.mp4";

import video1Webm from "@/assets/video/video-1.webm";
import video1Mp4 from "@/assets/video/video-1.mp4";

import video2Webm from "@/assets/video/video-2.webm";
import video2Mp4 from "@/assets/video/video-2.mp4";

import video3Webm from "@/assets/video/video-3.webm";
import video3Mp4 from "@/assets/video/video-3.mp4";

import video4Webm from "@/assets/video/video-4.webm";
import video4Mp4 from "@/assets/video/video-4.mp4";

import videoFaceWebm from "@/assets/video/video-face.webm";
import videoFaceMp4 from "@/assets/video/video-face.mp4";

// for SEO
const siteUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL("/", siteUrl).toString();
const defaultImageUrl = new URL(
  "/og-cover.jpg",
  siteUrl,
).toString();

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Website",
  description: "Website description.",

  isPartOf: {
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    url: siteUrl.toString(),
    name: "Website",
  },

  primaryImageOfPage: {
    "@type": "ImageObject",
    url: defaultImageUrl,
  },
};


---

<BaseLayout
  canonicalPath="/"
  image="/og-cover.jpg"
  imageAlt="Image alt text"
  robots="index, follow, max-image-preview:large"
  pageType="profile"
  jsonLd={pageJsonLd}
>

<Hero
  title={"Masaż we Wrocławiu dla \n ciała zmęczonego stresem, pracą i treningiem"}
  description="Dobierz masaż do tego, czego dziś potrzebuje Twoje ciało — relaksu, rozluźnienia napięć albo regeneracji po wysiłku."
  image={heroImage}
  videoSources={[
    {
      src: heroVideoWebm,
      type: "video/webm",
    },
    {
      src: heroVideoMp4,
      type: "video/mp4",
    },
  ]}
  tone="inverse"
  imageAlt="Sesja masażu terapeutycznego ze świecami i miękkimi ręcznikami."
  primaryAction={{
  label: "Umów wizytę",
  href: "/rezerwacja",
  icon: "ic-calendar",
  }},
  secondaryAction={{
    label: "Dobierz masaż",
    href: "/uslugi",
  }},
  features={[
    {
      label: "Indywidualne podejście",
      icon: "ic-leaf",
      iconSize: "1.5rem",
    },
    {
      label: "Spokojna atmosfera",
      icon: "ic-lotus",
      iconSize: "1.7rem",
    },
    {
      label: "Wrocław",
      icon: "ic-location",
      iconSize: "1.5rem",
    },
  ]}

/>

