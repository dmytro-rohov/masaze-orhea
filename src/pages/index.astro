<MassageTechniquesRow
  eyebrow="ORHEA"
  eyebrowImage={Logo}
  eyebrowImageAlt="obacz, jak pracujemy. Każda technika ma swój cel i zastosowanie — wybierz tę, która najlepiej odpowiada Twoim potrzebom."
  title="Techniki masażu dopasowane do Twoich potrzeb"
  description="Zobacz, jak pracujemy. Każda technika ma swój cel i zastosowanie — wybierz tę, która najlepiej odpowiada Twoim potrzebom."
  videos={[
      {
        sources: [
          {
            src: video1Webm,
            type: "video/webm",
          },
          {
            src: video1Mp4,
            type: "video/mp4",
          }
        ],
        label: "Masaż relaksacyjny",
      },
      {
        sources: [
          {
            src: video2Webm,
            type: "video/webm",
          },
          {
            src: video2Mp4,
            type: "video/mp4",
          }
        ],
        label: "Masaż relaksacyjny",
      },
      {
        sources: [
          {
            src: video3Webm,
            type: "video/webm",
          },
