---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/widgets/Hero.astro";
import MassageTechniques from "@/components/widgets/MassageTechniques.astro";
import MassageZones from "@/components/widgets/MassageZones.astro";

// assets
import Logo from "@assets/img/logo.png";
import heroImage from "@/assets/img/hero-banner.png";
import massagePoster from "@/assets/img/hero-banner.png";

// videos
import test1Webm from "@/assets/video/test-1.webm";
import test1Mp4 from "@/assets/video/test-1.mp4";


// for SEO
const siteUrl = Astro.site ?? Astro.url.origin;
const pageUrl = new URL("/", siteUrl).toString();
const defaultImageUrl = new URL(
  "/og-cover.jpg",
  siteUrl,
).toString();

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${pageUrl}#webpage`,
  url: pageUrl,
  name: "Website",
  description: "Website description.",

  isPartOf: {
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    url: siteUrl.toString(),
    name: "Website",
  },

  primaryImageOfPage: {
    "@type": "ImageObject",
    url: defaultImageUrl,
  },
};


---

<BaseLayout
  canonicalPath="/"
  image="/og-cover.jpg"
  imageAlt="Image alt text"
  robots="index, follow, max-image-preview:large"
  pageType="profile"
  jsonLd={pageJsonLd}
>

<Hero
  title={"Masaż we Wrocławiu dla \n ciała zmęczonego stresem, pracą i treningiem"}
  description="Dobierz masaż do tego, czego dziś potrzebuje Twoje ciało — relaksu, rozluźnienia napięć albo regeneracji po wysiłku."
  image={heroImage}
  tone="inverse"
  imageAlt="Sesja masażu terapeutycznego ze świecami i miękkimi ręcznikami."
  primaryAction={{
  label: "Umów wizytę",
  href: "/kontakt",
}},
secondaryAction={{
  label: "Dobierz masaż",
  href: "/uslugi",
}}/>

<MassageTechniques
  eyebrow="ORHEA"
  eyebrowImage={Logo}
  eyebrowImageAlt=""
  title="Techniki masażu dopasowane do Twoich potrzeb"
  description="Zobacz, jak pracujemy. Każda technika ma swój cel i zastosowanie — wybierz tę, która najlepiej odpowiada Twoim potrzebom."
  videos={[
      {
        sources: [
          {
            src: test1Webm,
            type: "video/webm",
          },
          {
            src: test1Mp4,
            type: "video/mp4",
          }
        ],
        label: "Masaż relaksacyjny",
      },
      {
        sources: [
          {
            src: test1Webm,
            type: "video/webm",
          },
          {
            src: test1Mp4,
            type: "video/mp4",
          }
        ],
        label: "Masaż relaksacyjny",
      },
      {
        sources: [
          {
            src: test1Webm,
            type: "video/webm",
          },
          {
            src: test1Mp4,
            type: "video/mp4",
          }
        ],
        label: "Masaż relaksacyjny",
      },
      {
        sources: [
          {
            src: test1Webm,
            type: "video/webm",
          },
          {
            src: test1Mp4,
            type: "video/mp4",
          }
        ],
        label: "Masaż relaksacyjny",
      },
      {
        sources: [
          {
            src: test1Webm,
            type: "video/webm",
          },
          {
            src: test1Mp4,
            type: "video/mp4",
          }
        ],
        label: "Masaż relaksacyjny",
      },
    ]}
  initialActiveIndex={2}
  action={{
    label: "Zobacz ofertę",
    href: "/uslugi",
  }}
/>

<MassageZones tone="inverse"/>

</BaseLayout>