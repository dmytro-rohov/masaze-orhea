---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import ReservationFlow from "@/components/widgets/ReservationFlow.astro";
import { resolveVoucherBookingByToken } from "@/server/vouchers/voucher-reservation.service";

export const prerender = false;

let voucher = null;
let unavailable = false;

try {
  voucher = await resolveVoucherBookingByToken(Astro.params.token ?? "");
  if (voucher.state !== "active") {
    voucher = null;
    unavailable = true;
    Astro.response.status = 409;
  }
} catch {
  unavailable = true;
  Astro.response.status = 404;
}
---

<BaseLayout
  title={unavailable ? "Voucher niedostępny | ORHEA" : "Zarezerwuj wizytę z voucherem | ORHEA"}
  description="Rezerwacja wizyty z voucherem ORHEA."
  canonicalPath="/rezerwacja/voucher"
  robots="noindex, nofollow"
>
  <main class="section">
    {voucher ? (
      <>
        <Container>
          <Stack space="sm">
            <p class="eyebrow">Voucher ORHEA</p>
            <h1>Umów wizytę z voucherem</h1>
            <p>Wybierz specjalistę i dogodny termin. Usługa objęta voucherem jest już opłacona.</p>
          </Stack>
        </Container>
        <ReservationFlow voucherContext={voucher} voucherToken={Astro.params.token ?? ""} />
      </>
    ) : (
      <Container>
        <Stack space="md">
          <>
            <h1>Voucher jest niedostępny</h1>
            <p>Sprawdź kod vouchera lub skontaktuj się z ORHEA.</p>
          </>
        </Stack>
      </Container>
    )}
  </main>
</BaseLayout>
