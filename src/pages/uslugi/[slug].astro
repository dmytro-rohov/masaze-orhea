---
import BaseLayout from "@/layouts/BaseLayout.astro";

import Hero from "@/components/widgets/Hero.astro";
import MassageDetails from "@/components/widgets/MassageDetails.astro";
import RelatedMassages from "@/components/widgets/RelatedMassages.astro";

import { getMassageDurationLabel, getMassageFullName, getMassagePriceLabel, getPrimaryMassageVariant, getMassageBookingPath, getMassageOfferPath } from "@/lib/catalog/massage";
import { getPublicMassageBySlug, getMassagePageContent } from "@/server/catalog/massage-catalog.service";

import { getMassageZoneById } from "@/data/massage-zones";

import { getMassageVisual } from "@/data/massage-visuals";

// Service pages must pass through middleware so the production preview cannot be bypassed.
export const prerender = false;

const massage = await getPublicMassageBySlug(Astro.params.slug ?? "", true);
const content = massage ? await getMassagePageContent(massage.id) : null;

if (!massage) return new Response("Nie znaleziono usługi.", { status: 404 });
const zone = getMassageZoneById(massage.zoneId);

if (!zone) {
  throw new Error(
    `Massage page: brak strefy "${massage.zoneId}" dla masażu "${massage.id}".`,
  );
}

const visual = getMassageVisual(massage);
const primaryVariant = getPrimaryMassageVariant(massage);

const heroFeatures = [
  {
    label: getMassageDurationLabel(massage),
    icon: "ic-clock-2",
    iconSize: "1.4rem",
  },
  {
    label: getMassagePriceLabel(massage),
    icon: "ic-price",
    iconSize: "1.4rem",
  },
  ...(massage.voucherAvailable
    ? [
        {
          label: "idealny na prezent",
          icon: "ic-gift-bold",
          iconSize: "1.4rem",
        },
      ]
    : []),
];

const pageTitle = getMassageFullName(massage);
const seoTitle = `${pageTitle} | ORHEA Wrocław`;
const seoDescription = massage.shortDescription;
const canonicalPath = getMassageOfferPath(massage);
const bookingHref = getMassageBookingPath(massage);
const isVipRitual = massage.zoneId === "vip";

const pageJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: pageTitle,
  description: seoDescription,
  provider: {
    "@type": "LocalBusiness",
    name: "ORHEA",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Wrocław",
      addressCountry: "PL",
    },
  },
  areaServed: "Wrocław",
  ...(primaryVariant && massage.isActive ? { offers: {
    "@type": "Offer",
    price: primaryVariant.priceGrosze / 100,
    priceCurrency: "PLN",
    availability: "https://schema.org/InStock",
    url: new URL(canonicalPath, Astro.site ?? Astro.url.origin).toString(),
  }} : {}),
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalPath={canonicalPath}
  image={visual.heroImage.src}
  imageAlt={visual.heroImageAlt}
  robots={massage.isActive ? "index, follow, max-image-preview:large" : "noindex, follow"}
  jsonLd={pageJsonLd}
  bodyClass={isVipRitual ? "is-vip-service is-active-vip is-vip-mode" : undefined}
>
  <Hero
    eyebrow={zone.name}
    title={massage.serviceName ?? massage.title}
    description={massage.shortDescription}
    image={visual.heroImage}
    videoSources={visual.heroVideoSources}
    tone="inverse"
    features={heroFeatures}
    class="massage-offer"
    primaryAction={massage.isActive && massage.bookingAvailable && massage.variants.length > 0
      ? {
          label: "Zarezerwuj termin",
          href: bookingHref,
          icon: "ic-calendar",
          iconSize: "1.1rem",
        }
      : undefined}
    secondaryAction={massage.isActive && massage.voucherAvailable && massage.variants.length > 0
      ? {
          label: "Kup voucher",
          href: "/voucher",
        }
      : undefined}
  />

  {content && <MassageDetails massage={massage} content={content} />}

  {content && <RelatedMassages
    currentMassageId={massage.id}
    massageIds={content.relatedMassageIds}
  />}
</BaseLayout>
