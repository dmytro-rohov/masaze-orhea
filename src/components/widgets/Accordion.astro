---
import Img from "@/components/media/Img.astro";
import type { ImageMetadata } from "astro";

export type AccordionItem = {
  id?: string;
  title: string;
  content: string;
  image?: ImageMetadata;
  imageAlt?: string;
  open?: boolean;
};

export interface Props {
  items: AccordionItem[];
  variant?: "default" | "boxed" | "minimal";
  name?: string;
  class?: string;
}

const {
  items,
  variant = "default",
  class: className,
  name = "accordion",
  ...restProps
} = Astro.props;
---

<div
  {...restProps}
  class:list={["accordion", `accordion--${variant}`, className]}
  data-accordion
  data-accordion-name={name}
>
  {
    items.map((item) => (
      <details
        id={item.id}
        class="accordion__item"
        open={item.open}
        data-accordion-item
        data-accordion-item-id={item.id}
      >
        <summary class="accordion__summary" data-accordion-summary>
          <span class="accordion__title">{item.title}</span>

          <span class="accordion__icon" aria-hidden="true" />
        </summary>

        <div class="accordion__content" data-accordion-content>
          <div
            class:list={[
              "accordion__content-inner",
              item.image && "accordion__content-inner--with-image",
            ]}
          >
            <div class="accordion__text">
              <p>{item.content}</p>
            </div>

            {item.image && (
              <div class="accordion__media">
                <Img
                  src={item.image}
                  alt={item.imageAlt ?? ""}
                  kind={item.imageAlt ? undefined : "decorative"}
                  class="accordion__image"
                  widths={[480, 720, 960]}
                  sizes="(max-width: 768px) 100vw, 40vw"
                />
              </div>
            )}
          </div>
        </div>
      </details>
    ))
  }
</div>

<script>
  const initAccordions = () => {
    const accordions =
      document.querySelectorAll<HTMLElement>("[data-accordion]");

    accordions.forEach((accordion) => {
      if (accordion.dataset.initialized === "true") {
        return;
      }

      accordion.dataset.initialized = "true";

      const items = Array.from(
        accordion.querySelectorAll<HTMLDetailsElement>("[data-accordion-item]"),
      );

      type AccordionState = {
        item: HTMLDetailsElement;
        summary: HTMLElement;
        content: HTMLElement;
        animation: Animation | null;
        isClosing: boolean;
        isExpanding: boolean;
      };

      const states = new Map<HTMLDetailsElement, AccordionState>();

      items.forEach((item) => {
        const summary = item.querySelector<HTMLElement>(
          "[data-accordion-summary]",
        );

        const content = item.querySelector<HTMLElement>(
          "[data-accordion-content]",
        );

        if (!summary || !content) {
          return;
        }

        states.set(item, {
          item,
          summary,
          content,
          animation: null,
          isClosing: false,
          isExpanding: false,
        });
      });

      const getBorderBlockSize = (element: HTMLElement) => {
        const styles = window.getComputedStyle(element);

        const borderTop = Number.parseFloat(styles.borderTopWidth) || 0;

        const borderBottom = Number.parseFloat(styles.borderBottomWidth) || 0;

        return borderTop + borderBottom;
      };

      const getCollapsedHeight = (state: AccordionState) => {
        const itemStyles = window.getComputedStyle(state.item);

        const paddingTop = Number.parseFloat(itemStyles.paddingTop) || 0;

        const paddingBottom = Number.parseFloat(itemStyles.paddingBottom) || 0;

        const borderBlock = getBorderBlockSize(state.item);

        const summaryHeight = state.summary.getBoundingClientRect().height;

        return summaryHeight + paddingTop + paddingBottom + borderBlock;
      };

      /*
       * Rzeczywista wysokość otwartego details.
       *
       * scrollHeight zawiera content + padding,
       * ale nie border, więc dokładamy border.
       */
      const getExpandedHeight = (state: AccordionState) => {
        return state.item.scrollHeight + getBorderBlockSize(state.item);
      };

      /*
       * Aktualna renderowana wysokość.
       *
       * getBoundingClientRect() zachowuje wartości
       * subpikselowe, więc jest dokładniejsze od offsetHeight.
       */
      const getCurrentHeight = (state: AccordionState) => {
        return state.item.getBoundingClientRect().height;
      };

      /*
       * Anulowanie starej animacji bez uruchamiania
       * jej starego oncancel.
       *
       * Zapobiega sytuacji:
       *
       * cancel()
       * → oncancel
       * → height = ""
       * → nowa animacja
       *
       * co mogłoby powodować pojedynczy frame ze skokiem.
       */
      const cancelAnimation = (state: AccordionState) => {
        if (!state.animation) {
          return;
        }

        state.animation.onfinish = null;
        state.animation.oncancel = null;

        state.animation.cancel();
        state.animation = null;
      };

      const closeItem = (state: AccordionState) => {
        if (!state.item.open || state.isClosing) {
          return;
        }

        const startHeight = getCurrentHeight(state);

        const endHeight = getCollapsedHeight(state);

        cancelAnimation(state);

        state.isClosing = true;
        state.isExpanding = false;

        state.item.classList.add("is-closing");

        /*
         * Zamrażamy dokładnie aktualny wymiar,
         * zanim rozpocznie się animacja.
         */
        state.item.style.height = `${startHeight}px`;

        state.item.style.overflow = "hidden";

        state.animation = state.item.animate(
          {
            height: [`${startHeight}px`, `${endHeight}px`],
          },
          {
            duration: 650,
            easing: "cubic-bezier(0.16, 1, 0.3, 1)",
            fill: "forwards",
          },
        );

        state.animation.onfinish = () => {
          /*
           * Najpierw ustawiamy dokładną wysokość
           * końcową, potem zmieniamy natywny stan.
           */
          state.item.style.height = `${endHeight}px`;

          state.item.open = false;

          state.item.classList.remove("is-closing");

          state.animation = null;
          state.isClosing = false;

          /*
           * Dopiero w następnym frame oddajemy wysokość
           * z powrotem CSS-owi.
           *
           * Dzięki temu browser nie wykonuje przeliczenia
           * w tej samej klatce co koniec WAAPI.
           */
          requestAnimationFrame(() => {
            state.item.style.height = "";
            state.item.style.overflow = "";
          });
        };

        state.animation.oncancel = () => {
          state.animation = null;
          state.isClosing = false;

          state.item.classList.remove("is-closing");
        };
      };

      const expandItem = (state: AccordionState) => {
        cancelAnimation(state);

        state.isExpanding = true;
        state.isClosing = false;

        state.item.classList.remove("is-closing");

        /*
         * Stan początkowy liczymy jako rzeczywistą
         * collapsed wysokość całego details.
         */
        const startHeight = getCollapsedHeight(state);

        state.item.style.height = `${startHeight}px`;

        state.item.style.overflow = "hidden";

        /*
         * Content musi istnieć w layoucie,
         * zanim będziemy mogli zmierzyć expanded state.
         */
        state.item.open = true;

        /*
         * Force layout po zmianie open.
         */
        void state.item.offsetHeight;

        const endHeight = getExpandedHeight(state);

        state.animation = state.item.animate(
          {
            height: [`${startHeight}px`, `${endHeight}px`],
          },
          {
            duration: 650,
            easing: "cubic-bezier(0.16, 1, 0.3, 1)",
            fill: "forwards",
          },
        );

        state.animation.onfinish = () => {
          state.item.style.height = `${endHeight}px`;

          state.animation = null;
          state.isExpanding = false;

          requestAnimationFrame(() => {
            state.item.style.height = "";
            state.item.style.overflow = "";
          });
        };

        state.animation.oncancel = () => {
          state.animation = null;
          state.isExpanding = false;
        };
      };

      const openItem = (state: AccordionState) => {
        /*
         * Zamykamy wszystkie inne otwarte itemy
         * tylko w obrębie tego accordiona.
         */
        states.forEach((otherState) => {
          if (otherState === state) {
            return;
          }

          if (otherState.item.open) {
            closeItem(otherState);
          }
        });

        /*
         * Jeśli ten element był w trakcie close,
         * zaczynamy clean expansion.
         */
        cancelAnimation(state);

        state.isClosing = false;

        state.item.classList.remove("is-closing");

        requestAnimationFrame(() => {
          expandItem(state);
        });
      };

      states.forEach((state) => {
        state.summary.addEventListener("click", (event) => {
          event.preventDefault();

          if (state.item.open && !state.isClosing) {
            if (state.isExpanding) {
              return;
            }

            closeItem(state);

            return;
          }

          openItem(state);
        });
      });

      const initiallyOpen = items.filter((item) => item.open);

      initiallyOpen.slice(1).forEach((item) => {
        item.open = false;
      });
    });
  };

  initAccordions();

  document.addEventListener("astro:page-load", initAccordions);
</script>
