---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Cluster from "@/components/layouts/Cluster.astro";
import Grid from "@/components/layouts/Grid.astro";
import Sidebar from "@/components/layouts/Sidebar.astro";
import StatusModal from "@/components/ui/StatusModal.astro";

import Card from "@/components/ui/Card.astro";
import Link from "@/components/ui/Link.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";

import Icon from "@/components/media/Icon.astro";

import FormGroup from "@/components/form/FormGroup.astro";
import FormField from "@/components/form/FormField.astro";
import Label from "@/components/form/Label.astro";
import FieldError from "@/components/form/FieldError.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import Checkbox from "@/components/form/Checkbox.astro";
import Radio from "@/components/form/Radio.astro";

import Tabs from "@/components/widgets/Tabs.astro";
import TabsPanel from "@/components/widgets/TabsPanel.astro";
import MassageCards from "@/components/widgets/MassageCards.astro";
import Specialists from "@/components/widgets/Specialists.astro";
import ReservationProgress from "@/components/widgets/ReservationProgress.astro";
import ReservationInquiryForm from "@/components/widgets/ReservationInquiryForm.astro";

import BookingCalendar from "@/components/widgets/BookingCalendar.astro";

import BookingSummary from "@/components/widgets/BookingSummary.astro";

import { getBookableMassages } from "@/server/catalog/massage-catalog.service";

import {
  massageZoneDefinitions,
} from "@/data/massage-zones";

import type { SpecialistId } from "@/data/specialists";

import { contactDetails } from "@/data/contact";

import eventInquiryImage from "@/assets/img/hero-contact.png";
import travelInquiryImage from "@/assets/img/aside-map.png";

export interface Props {
  initialMassageId?: string;
  initialSpecialistId?: SpecialistId;
  class?: string;
}

const { initialMassageId, initialSpecialistId, class: className } = Astro.props;

const bookableMassages = await getBookableMassages();

const initialMassage = initialMassageId
  ? bookableMassages.find((massage) => massage.id === initialMassageId)
  : undefined;

const initialVariantIndex = undefined;

const bookingZoneOrder = massageZoneDefinitions.filter((zone) => zone.type === "standard").map((zone) => zone.id);

const bookingZones = bookingZoneOrder
  .map((zoneId) => {
    const zone = massageZoneDefinitions.find((item) => item.id === zoneId);

    if (!zone) {
      throw new Error(`Reservation: brak konfiguracji strefy "${zoneId}".`);
    }

    return {
      ...zone,

      massages: bookableMassages.filter((massage) => massage.zoneId === zoneId),
    };
  })
  .filter((zone) => zone.massages.length > 0);

const vipMassages = bookableMassages.filter(
  (massage) => massage.zoneId === "vip",
);


const initialZone: string = initialMassage && initialMassage.zoneId !== "vip"
  ? initialMassage.zoneId
  : bookingZones[0]?.id ?? "inne";

const tabs: Array<{ id: string; label: string }> = [
  ...bookingZones.map((zone) => ({ id: zone.id, label: zone.name })),
  { id: "inne", label: "Inne" },
];

const inquiryOffers = [
  {
    id: "event-organization",
    title: "Organizacja eventów",
    description:
      "Indywidualna organizacja strefy masażu i relaksu podczas wydarzeń firmowych lub prywatnych.",
    image: eventInquiryImage,
    imageAlt: "Zapytanie o organizację eventu z ORHEA",
  },
  {
    id: "client-travel",
    title: "Dojazd do klienta",
    description:
      "Zapytaj o masaż lub rytuał z dojazdem w ustalonym miejscu i terminie.",
    image: travelInquiryImage,
    imageAlt: "Zapytanie o dojazd ORHEA do klienta",
  },
];

const progressSteps = [
  {
    id: 1,
    label: "Masaż",
    targetId: "reservation-massage",
  },
  {
    id: 2,
    label: "Specjalista",
    targetId: "reservation-specialist",
  },
  {
    id: 3,
    label: "Termin",
    targetId: "reservation-date",
  },
  {
    id: 4,
    label: "Miejsce",
    targetId: "reservation-location",
  },
  {
    id: 5,
    label: "Dane",
    targetId: "reservation-customer",
  },
  {
    id: 6,
    label: "Potwierdzenie",
    targetId: "reservation-summary",
  },
];

const warsawMonthParts = new Intl.DateTimeFormat("en-CA", {
  timeZone: "Europe/Warsaw",
  year: "numeric",
  month: "2-digit",
}).formatToParts(new Date());
const calendarMonth = `${warsawMonthParts.find((part) => part.type === "year")?.value}-${warsawMonthParts.find((part) => part.type === "month")?.value}`;

const initialCompletedSteps: number[] = [];

if (initialMassage && initialVariantIndex !== undefined) {
  initialCompletedSteps.push(1);
}

if (initialSpecialistId) {
  initialCompletedSteps.push(2);
}

const initialCurrentStep =
  [1, 2, 3, 4, 5].find((step) => !initialCompletedSteps.includes(step)) ?? 6;
---

<div
  class:list={["reservation-flow", className]}
  data-reservation-flow
  data-initial-massage={initialMassageId}
  data-initial-variant={initialVariantIndex}
  data-initial-specialist={initialSpecialistId ?? ""}
  data-salon-address={contactDetails.address}
>
  <Container
    class="reservation-progress-container"
    data-standard-booking-progress
  >
    <ReservationProgress
      steps={progressSteps}
      currentStep={initialCurrentStep}
      completedSteps={initialCompletedSteps}
    />
  </Container>

  <form class="reservation-form" data-reservation-form novalidate>
    <input
      type="hidden"
      name="massageId"
      value={initialMassageId ?? ""}
      data-booking-massage-id
    />

    <input
      type="hidden"
      name="variantIndex"
      value={initialVariantIndex ?? ""}
      data-booking-variant-index
    />

    <input type="hidden" name="date" value="" data-booking-date-input />

    <input type="hidden" name="startAt" value="" data-booking-start-at-input />

    <Section
      
      id="reservation-massage"
      class="reservation-step reservation-step--massage"
    >
      <Container>
        <Stack space="2xl">
          <SectionHeading
            heading="Wybierz masaż, na który chcesz umówić się"
            description="Wybierz usługę i konkretny wariant czasu. Cena zawsze wynika z aktualnej oferty ORHEA."
            data-reveal="up"
          />

          <div class:list={["reservation-massage-selector", vipMassages.length === 0 && "has-no-vip"]} data-vip-selection-scope>
            <div
              class="reservation-massage-selector__main"
              data-vip-standard-offers
            >
              <Tabs
                items={tabs}
                initialActiveId={initialZone}
                ariaLabel="Strefy masaży dostępnych do rezerwacji"
                class="reservation-massage-tabs"
                transitionDuration={200}
              >
                {
                  bookingZones.map((zone) => (
                    <TabsPanel
                      id={zone.id}
                      active={zone.id === initialZone}
                      class="reservation-massage-panel"
                    >
                      <MassageCards
                        massages={zone.massages}
                        mode="booking-select"
                        selectedMassageId={initialMassageId}
                        selectedVariantIndex={initialVariantIndex}
                        actionLabel="Wybieram ten masaż"
                        dualScrollbar
                        class="reservation-massage-cards"
                      />
                    </TabsPanel>
                  ))
                }
                <TabsPanel
                  id="inne"
                  active={initialZone === "inne"}
                  class="reservation-massage-panel reservation-massage-panel--inquiry"
                >
                  <MassageCards
                    mode="inquiry-select"
                    inquiryOffers={inquiryOffers}
                    actionLabel="Wybierz"
                    dualScrollbar
                    class="reservation-massage-cards reservation-inquiry-cards"
                  />
                </TabsPanel>
              </Tabs>
            </div>

            {vipMassages.length > 0 && <aside
              class="reservation-massage-selector__vip"
              aria-label="ORHEA VIP"
              data-vip-offer
            >
              <MassageCards
                massages={vipMassages}
                mode="booking-select"
                selectedMassageId={initialMassageId}
                selectedVariantIndex={initialVariantIndex}
                actionLabel="Wybieram ORHEA VIP"
                class="reservation-massage-vip-card"
              />
            </aside>}
          </div>

          <FieldError data-booking-massage-error />
          <div data-booking-addons-state hidden>
            <p data-booking-addons-status role="status" aria-live="polite"></p>
            <button
              type="button"
              class="button button--secondary button--sm"
              data-booking-addons-retry
              hidden
            >Ponów pobieranie dodatków</button>
          </div>
        </Stack>
      </Container>
    </Section>

    <Section
      class="reservation-step reservation-addons-section"
      data-booking-addons-section
      data-standard-booking-section
      hidden
    >
      <Container>
        <Stack space="lg">
          <SectionHeading
            heading="Dodatki do wizyty"
            description="Wybierz opcjonalne dodatki. Ich cena i czas są uwzględniane w dostępnych terminach."
          />
          <div class="reservation-addons-list" data-booking-addons-list></div>
        </Stack>
      </Container>
    </Section>

    <Specialists
      id="reservation-specialist"
      mode="select"
      selectedSpecialistId={initialSpecialistId ?? null}
      heading="Wybierz specjalistę"
      description="Wybierz Adriana albo Aleksandrę. Specjalista jest wymagany do ukończenia rezerwacji."
      class="reservation-step reservation-specialists"
      data-standard-booking-section
    />

    <Section
      
      id="reservation-date"
      class="reservation-step reservation-date-section"
      data-standard-booking-section
    >
      <Container>
        <Stack space="2xl">
          <SectionHeading
            heading="Wybierz dogodny termin"
            description="Wybierz dzień, a następnie jeden z aktualnie dostępnych terminów wybranego specjalisty."
            data-reveal="up"
          />

          <BookingCalendar month={calendarMonth} />

          <FieldError data-booking-date-error />
        </Stack>
      </Container>
    </Section>

    <Section
      
      tone="inverse"
      id="reservation-location"
      class="reservation-step reservation-location-section"
      data-standard-booking-section
    >
      <Container>
        <Stack space="2xl">
          <SectionHeading
            heading="Miejsce wizyty"
            description="Wybierz masaż w salonie ORHEA albo zapytaj o realizację usługi mobilnej."
            data-reveal="up"
          />

          <fieldset class="reservation-fieldset">
            <legend class="sr-only"> Wybierz miejsce realizacji masażu </legend>

            <Grid
              columns="2"
              gap="xl"
              class="reservation-location-options reservation-location-options--salon-only"
            >
              <Card
                as="div"
                padding="lg"
                class="reservation-location-card is-selected"
                data-location-card="salon"
                data-reveal="up"
              >
                <Cluster align="start" space="lg" class="reservation-location-card__cluster">
                  <Radio
                    id="booking-location-salon"
                    name="locationType"
                    value="salon"
                    checked
                    required
                    class="radio--big"
                  />

                  <div class="reservation-location-card__content">
                    <div class="reservation-location-card__stack">
                      <Stack as="div" space="sm" class="reservation-location-card__content--pt1">
                        <h3>Salon ORHEA</h3>
                        <p>
                          <Icon
                            class="icon-w-f"
                            name="ic-location"
                            size="1rem"
                          />
                          {contactDetails.address}
                        </p>
                      </Stack>

                      <Stack as="div" space="sm" class="reservation-location-card__content--pt2">
                        <p class="reservation-card__description">
                          Spokojna, przygotowana przestrzeń do masażu i rytuałów
                          ORHEA.
                        </p>
                        <Link
                          href={contactDetails.directionsHref}
                          class="button button--secondary"
                        >
                          Pokaż na mapie
                        </Link>
                      </Stack>
                    </div>

                    <!-- <Img
                      src={roomImage}
                      alt="Wnętrze gabinetu masażu ORHEA"
                      class="reservation-location-card__image"
                      widths={[320, 480, 640]}
                      sizes="(max-width: 768px) 100vw, 24vw"
                    /> -->
                  </div>
                </Cluster>
              </Card>

              <!-- <Card
                as="div"
                padding="lg"
                class="reservation-location-card"
                data-location-card="mobile"
                data-retained-mobile-location
                data-reveal="up"
                style="--reveal-delay: 70ms;"
                hidden
              >
                <Cluster align="start" space="lg">
                  <Radio
                    id="booking-location-mobile"
                    name="locationType"
                    value="mobile"
                    required
                    class="radio--big"
                  />

                  <Stack space="md">
                    <h3>Wariant z dojazdem</h3>

                    <p class="reservation-card__description">
                      Usługa mobilna wymaga dodatkowego potwierdzenia. Po
                      przesłaniu zgłoszenia ORHEA zweryfikuje możliwość
                      realizacji masażu pod wskazanym adresem.
                    </p>

                    <div data-mobile-address hidden>
                      <Grid
                        columns="2"
                        gap="md"
                        class="reservation-address-grid"
                      >
                        <FormField>
                          <Label for="booking-street" required> Ulica </Label>

                          <Input
                            id="booking-street"
                            name="mobileStreet"
                            autocomplete="street-address"
                            maxlength={150}
                            required
                            disabled
                            describedby="booking-street-error"
                          />

                          <FieldError
                            id="booking-street-error"
                            data-error-for="mobileStreet"
                          />
                        </FormField>

                        <FormField>
                          <Label for="booking-building" required>
                            Numer budynku
                          </Label>

                          <Input
                            id="booking-building"
                            name="mobileBuilding"
                            autocomplete="address-line2"
                            maxlength={20}
                            required
                            disabled
                            describedby="booking-building-error"
                          />

                          <FieldError
                            id="booking-building-error"
                            data-error-for="mobileBuilding"
                          />
                        </FormField>

                        <FormField>
                          <Label for="booking-apartment">
                            Numer mieszkania
                          </Label>

                          <Input
                            id="booking-apartment"
                            name="mobileApartment"
                            autocomplete="address-line3"
                            maxlength={20}
                            disabled
                          />
                        </FormField>

                        <FormField>
                          <Label for="booking-postal-code" required>
                            Kod pocztowy
                          </Label>

                          <Input
                            id="booking-postal-code"
                            name="mobilePostalCode"
                            autocomplete="postal-code"
                            inputmode="numeric"
                            pattern="[0-9]{2}-[0-9]{3}"
                            placeholder="00-000"
                            required
                            disabled
                            describedby="booking-postal-code-error"
                          />

                          <FieldError
                            id="booking-postal-code-error"
                            data-error-for="mobilePostalCode"
                          />
                        </FormField>

                        <FormField class="reservation-address-grid__city">
                          <Label for="booking-city" required> Miasto </Label>

                          <Input
                            id="booking-city"
                            name="mobileCity"
                            autocomplete="address-level2"
                            maxlength={100}
                            required
                            disabled
                            describedby="booking-city-error"
                          />

                          <FieldError
                            id="booking-city-error"
                            data-error-for="mobileCity"
                          />
                        </FormField>
                      </Grid>
                    </div>
                  </Stack>
                </Cluster>
              </Card> -->
            </Grid>
          </fieldset>
        </Stack>
      </Container>
    </Section>

    <Section
      
      id="reservation-customer"
      class="reservation-step reservation-customer-section"
      data-standard-booking-section
    >
      <Container>
        <Stack space="2xl">
          <SectionHeading
            heading="Twoje dane"
            description="Podaj dane kontaktowe potrzebne do przyszłego potwierdzenia rezerwacji."
            data-reveal="up"
          />

          <Sidebar
            side="right"
            width="25rem"
            gap="xl"
            class="reservation-customer-layout"
          >
            <Card
              as="div"
              padding="lg"
              class="reservation-customer-card"
              data-reveal="up"
            >
              <FormGroup gap="lg">
                <Grid columns="2" gap="md" class="reservation-customer-grid">
                  <FormField>
                    <Label for="booking-first-name" required> Imię </Label>

                    <Input
                      id="booking-first-name"
                      name="firstName"
                      autocomplete="given-name"
                      minlength={2}
                      maxlength={100}
                      required
                      describedby="booking-first-name-error"
                    />

                    <FieldError
                      id="booking-first-name-error"
                      data-error-for="firstName"
                    />
                  </FormField>

                  <FormField>
                    <Label for="booking-last-name" required> Nazwisko </Label>

                    <Input
                      id="booking-last-name"
                      name="lastName"
                      autocomplete="family-name"
                      minlength={2}
                      maxlength={100}
                      required
                      describedby="booking-last-name-error"
                    />

                    <FieldError
                      id="booking-last-name-error"
                      data-error-for="lastName"
                    />
                  </FormField>

                  <FormField>
                    <Label for="booking-email" required> E-mail </Label>

                    <Input
                      id="booking-email"
                      name="email"
                      type="email"
                      autocomplete="email"
                      maxlength={254}
                      required
                      describedby="booking-email-error"
                    />

                    <FieldError
                      id="booking-email-error"
                      data-error-for="email"
                    />
                  </FormField>

                  <FormField>
                    <Label for="booking-phone" required> Telefon </Label>

                    <Input
                      id="booking-phone"
                      name="phone"
                      type="tel"
                      autocomplete="tel"
                      inputmode="tel"
                      maxlength={20}
                      pattern="[+0-9][0-9 ()\-]{6,19}"
                      required
                      describedby="booking-phone-error"
                    />

                    <FieldError
                      id="booking-phone-error"
                      data-error-for="phone"
                    />
                  </FormField>
                </Grid>

                <FormField>
                  <Label for="booking-notes"> Uwagi do wizyty </Label>

                  <Textarea
                    id="booking-notes"
                    name="notes"
                    rows={6}
                    maxlength={500}
                    placeholder="Np. preferencje dotyczące masażu lub ważne informacje organizacyjne."
                  />
                </FormField>
              </FormGroup>
            </Card>

            <div id="reservation-summary" class="reservation-summary-column">
              <BookingSummary>
                <fieldset class="reservation-payment-method">
                  <legend>Jak chcesz zapłacić?</legend>
                  <Radio id="booking-payment-online" name="paymentMethod" value="online" required>
                    Zapłać online
                  </Radio>
                  <Radio id="booking-payment-on-site" name="paymentMethod" value="on_site" required>
                    Zapłać na miejscu
                  </Radio>
                  <FieldError id="booking-payment-error" data-error-for="paymentMethod" />
                </fieldset>
                <FormField>
                  <Checkbox
                    id="booking-consent"
                    name="termsAccepted"
                    value="true"
                    required
                    describedby="booking-consent-error"
                  >
                    Zapoznałam/em się z{" "}
                    <Link href="/regulamin" class="link--underline">
                      Regulaminem
                    </Link>{" "}
                    i{" "}
                    <Link href="/polityka-prywatnosci" class="link--underline">
                      Polityką prywatności
                    </Link>
                    .
                  </Checkbox>

                  <FieldError
                    id="booking-consent-error"
                    data-error-for="termsAccepted"
                  />
                </FormField>
              </BookingSummary>

              <p
                class="reservation-status"
                data-booking-status
                role="status"
                aria-live="polite"
                tabindex="-1"
              >
              </p>
            </div>
          </Sidebar>
        </Stack>
      </Container>
    </Section>
  </form>

  <ReservationInquiryForm />

  <StatusModal
    id="reservation-booking-success"
    variant="success"
    title="Rezerwacja została wysłana"
    message="Dziękujemy. Twoja rezerwacja została zapisana i oczekuje na potwierdzenie przez ORHEA. Skontaktujemy się z Tobą, jeśli będzie potrzebne dodatkowe potwierdzenie terminu lub miejsca wizyty."
    closeLabel="Zamknij"
  />
</div>

<script>
  type MassageId = string;
  import { scrollToSection } from "@/lib/client/scrollToSection";

  import type { SpecialistId } from "@/data/specialists";

  type ReservationState = {
    massageId: MassageId | null;
    variantIndex: number | null;
    addonIds: string[];

    specialistId: SpecialistId | null;

    date: string | null;
    slot: BookingAvailabilitySlot | null;

    locationType: "salon" | "mobile" | null;

    mobileAddress: {
      street: string;
      building: string;
      apartment: string;
      postalCode: string;
      city: string;
    };

    customer: {
      firstName: string;
      lastName: string;
      email: string;
      phone: string;
    };

    notes: string;
  };

  type BookingVariantView = {
    variantIndex: number;
    variantCode: string;
    duration: string;
    pricePLN: number;
  };

  type BookingAddonView = {
    id: string;
    name: string;
    description: string | null;
    priceGrosze: number;
    slotExtensionMinutes: number;
  };

  type BookingAvailabilitySlot = {
    startAt: string;
    endAt: string;
  };

  type BookingWindow = {
    minNoticeMinutes: number;
    maxAdvanceDays: number;
  };

  type BookingAvailabilityResponse = {
    success: boolean;
    specialistId?: SpecialistId;
    bookingWindow?: BookingWindow;
    slots?: BookingAvailabilitySlot[];
  };

  const initReservationFlows = () => {
    document
      .querySelectorAll<HTMLElement>("[data-reservation-flow]")
      .forEach((root) => {
        if (root.dataset.reservationInitialized === "true") {
          return;
        }

        root.dataset.reservationInitialized = "true";

        const form = root.querySelector<HTMLFormElement>(
          "[data-reservation-form]",
        );

        if (!form) {
          return;
        }

        const controller = new AbortController();

        const progressContainer = root.querySelector<HTMLElement>(
          ".reservation-progress-container",
        );

        const query = <T extends Element>(selector: string) =>
          root.querySelector<T>(selector);

        const queryAll = <T extends Element>(selector: string) =>
          Array.from(root.querySelectorAll<T>(selector));

        const initialVariant = root.dataset.initialVariant;
        const initialMassageId =
          (root.dataset.initialMassage as MassageId | undefined) || null;
        const initialVariantIndex =
          initialVariant === undefined || initialVariant === ""
            ? null
            : Number(initialVariant);
        const initialSpecialistId =
          (root.dataset.initialSpecialist as SpecialistId | undefined) || null;

        const state: ReservationState = {
          massageId: initialMassageId,

          variantIndex: initialVariantIndex,
          addonIds: [],

          specialistId: initialSpecialistId,

          date: null,
          slot: null,

          locationType: "salon",

          mobileAddress: {
            street: "",
            building: "",
            apartment: "",
            postalCode: "",
            city: "",
          },

          customer: {
            firstName: "",
            lastName: "",
            email: "",
            phone: "",
          },

          notes: "",
        };

        const money = new Intl.NumberFormat("pl-PL", {
          style: "currency",
          currency: "PLN",
          maximumFractionDigits: 2,
        });

        let availableAddons: BookingAddonView[] = [];
        let addonsReady = !initialMassageId;
        let addonsController: AbortController | null = null;
        let addonsRequestSequence = 0;

        let progressFrame: number | null = null;
        let availabilityController: AbortController | null = null;
        let availabilityRequestSequence = 0;
        let bookingWindowController: AbortController | null = null;
        let bookingWindowRequestSequence = 0;
        let bookingWindowSpecialistId: SpecialistId | null = null;
        let submitting = false;
        let bookingSucceeded = false;
        const publicCreationKey = crypto.randomUUID();

        const updatePaymentCopy = () => {
          const online = query<HTMLInputElement>('[name="paymentMethod"][value="online"]')?.checked;
          const submit = query<HTMLButtonElement>(".booking-summary__submit");
          const note = query<HTMLElement>("[data-booking-payment-note]");
          if (submit) submit.textContent = online ? "Przejdź do płatności" : "Potwierdź rezerwację";
          if (note) note.textContent = online
            ? "Termin zostanie czasowo zablokowany. Rezerwacja oczekuje na płatność i późniejsze potwierdzenie przez ORHEA."
            : "Po wysłaniu rezerwacja będzie oczekiwać na potwierdzenie terminu przez ORHEA.";
        };
        queryAll<HTMLInputElement>('[name="paymentMethod"]').forEach((radio) => {
          radio.addEventListener("change", updatePaymentCopy, { signal: controller.signal });
        });

        const paymentReturn = new URLSearchParams(window.location.search).get("payment");
        if (paymentReturn === "success" || paymentReturn === "cancel") {
          const returnStatus = root.querySelector<HTMLElement>("[data-booking-status]");
          if (returnStatus) {
            returnStatus.textContent = paymentReturn === "success"
              ? "Jeśli płatność się powiodła, potwierdzenie otrzymasz e-mailem. Sam powrót ze Stripe nie potwierdza płatności."
              : "Płatność nie została potwierdzona. Termin pozostaje czasowo zablokowany do wygaśnięcia sesji.";
          }
        }

        const updateProgressPosition = () => {
          if (!progressContainer) {
            return;
          }

          const flowRect = root.getBoundingClientRect();

          const shouldStop = flowRect.bottom <= window.innerHeight;

          progressContainer.classList.toggle("is-stopped", shouldStop);
        };

        const requestProgressPositionUpdate = () => {
          if (progressFrame !== null) {
            return;
          }

          progressFrame = window.requestAnimationFrame(() => {
            updateProgressPosition();

            progressFrame = null;
          });
        };

        window.addEventListener("scroll", requestProgressPositionUpdate, {
          passive: true,
          signal: controller.signal,
        });

        window.addEventListener("resize", requestProgressPositionUpdate, {
          signal: controller.signal,
        });

        const setText = (selector: string, value: string) => {
          const node = query<HTMLElement>(selector);

          if (node) {
            node.textContent = value;
          }
        };

        const setError = (selector: string, message: string) => {
          setText(selector, message);
        };

        const getSelectedMassage = () => {
          if (!state.massageId) {
            return null;
          }

          return query<HTMLElement>(
            `[data-booking-massage-card][data-massage-id="${state.massageId}"]`,
          );
        };

        const getSelectedVariant = () => {
          const card = getSelectedMassage();

          if (!card || state.variantIndex === null) {
            return null;
          }

          const variants = JSON.parse(
            card.dataset.variants ?? "[]",
          ) as BookingVariantView[];

          return (
            variants.find(
              (variant) => variant.variantIndex === state.variantIndex,
            ) ?? null
          );
        };

        const renderAddons = () => {
          const section = query<HTMLElement>("[data-booking-addons-section]");
          const list = query<HTMLElement>("[data-booking-addons-list]");
          if (!section || !list) return;

          list.replaceChildren();
          section.hidden =
            root.dataset.reservationMode === "inquiry" ||
            availableAddons.length === 0;

          for (const addon of availableAddons) {
            const label = document.createElement("label");
            label.className = "checkbox reservation-addon";
            const input = document.createElement("input");
            input.className = "checkbox__input";
            input.type = "checkbox";
            input.name = "bookingAddon";
            input.value = addon.id;
            input.checked = state.addonIds.includes(addon.id);
            const control = document.createElement("span");
            control.className = "checkbox__control";
            control.setAttribute("aria-hidden", "true");
            const content = document.createElement("span");
            content.className = "checkbox__label reservation-addon__content";
            const name = document.createElement("strong");
            name.textContent = addon.name;
            const price = document.createElement("span");
            price.className = "reservation-addon__price";
            price.textContent = `+${money.format(addon.priceGrosze / 100)}`;
            content.append(name, price);
            if (addon.description) {
              const description = document.createElement("span");
              description.className = "reservation-addon__description";
              description.textContent = addon.description;
              content.append(description);
            }
            label.append(input, control, content);
            list.append(label);
          }
        };

        const clearAddons = () => {
          addonsController?.abort();
          addonsController = null;
          addonsRequestSequence += 1;
          availableAddons = [];
          state.addonIds = [];
          addonsReady = false;
          renderAddons();
          const stateBox = query<HTMLElement>("[data-booking-addons-state]");
          if (stateBox) stateBox.hidden = true;
        };

        const loadAddons = async () => {
          if (!state.massageId || state.variantIndex === null) return;
          addonsController?.abort();
          const controller = new AbortController();
          addonsController = controller;
          const requestId = ++addonsRequestSequence;
          addonsReady = false;
          clearAvailability();
          const stateBox = query<HTMLElement>("[data-booking-addons-state]");
          const retry = query<HTMLButtonElement>("[data-booking-addons-retry]");
          if (stateBox) stateBox.hidden = false;
          if (retry) retry.hidden = true;
          setText("[data-booking-addons-status]", "Pobieramy dodatki…");

          try {
            const response = await fetch(
              `/api/bookings/addons?${new URLSearchParams({ massageId: state.massageId })}`,
              {
                headers: { accept: "application/json" },
                signal: controller.signal,
              },
            );
            const body = (await response.json()) as {
              success?: boolean;
              addons?: BookingAddonView[];
            };
            if (controller.signal.aborted || requestId !== addonsRequestSequence) {
              return;
            }
            if (!response.ok || !body.success || !Array.isArray(body.addons)) {
              throw new Error("BOOKING_ADDONS_LOAD_FAILED");
            }
            availableAddons = body.addons;
            addonsReady = true;
            renderAddons();
            if (stateBox) stateBox.hidden = true;
            updateSummary();
            if (state.date) void fetchAvailability();
          } catch {
            if (controller.signal.aborted || requestId !== addonsRequestSequence) {
              return;
            }
            availableAddons = [];
            renderAddons();
            setText(
              "[data-booking-addons-status]",
              "Nie udało się pobrać dodatków. Spróbuj ponownie.",
            );
            if (retry) retry.hidden = false;
          } finally {
            if (requestId === addonsRequestSequence) addonsController = null;
          }
        };

        const clearSelectedSlot = () => {
          state.slot = null;

          const startAtInput = query<HTMLInputElement>(
            "[data-booking-start-at-input]",
          );

          if (startAtInput) {
            startAtInput.value = "";
          }

          queryAll<HTMLButtonElement>("[data-booking-time]").forEach(
            (button) => {
              button.classList.remove("is-selected");
              button.setAttribute("aria-pressed", "false");
            },
          );
        };

        const clearAvailability = () => {
          availabilityController?.abort();
          availabilityController = null;
          availabilityRequestSequence += 1;
          clearSelectedSlot();

          const slotList = query<HTMLElement>("[data-booking-slot-list]");

          if (slotList) {
            slotList.replaceChildren();
            slotList.hidden = true;
            slotList.setAttribute("aria-busy", "false");
          }
        };

        const clearSelectedDate = () => {
          state.date = null;
          clearAvailability();

          const calendar = query<HTMLElement>("[data-booking-calendar]");

          if (calendar) {
            calendar.dataset.bookingSelectedDate = "";
          }

          const dateInput = query<HTMLInputElement>(
            "[data-booking-date-input]",
          );

          if (dateInput) {
            dateInput.value = "";
          }
        };

        const setCalendarWindow = (bookingWindow: BookingWindow | null) => {
          query<HTMLElement>("[data-booking-calendar]")?.dispatchEvent(
            new CustomEvent("booking:set-calendar-window", {
              detail: {
                maxAdvanceDays: bookingWindow?.maxAdvanceDays,
              },
            }),
          );
        };

        const clearBookingWindow = () => {
          bookingWindowController?.abort();
          bookingWindowController = null;
          bookingWindowRequestSequence += 1;
          bookingWindowSpecialistId = null;
          setCalendarWindow(null);
        };

        const addressIsComplete = () => {
          const address = state.mobileAddress;

          return Boolean(
            address.street &&
            address.building &&
            address.postalCode &&
            address.city,
          );
        };

        const customerIsComplete = () => {
          const fields = ["firstName", "lastName", "email", "phone"];

          const consent =
            query<HTMLInputElement>('[name="termsAccepted"]')?.checked ?? false;

          return (
            fields.every((name) => {
              const field = query<HTMLInputElement>(`[name="${name}"]`);

              return Boolean(field?.value && field.validity.valid);
            }) && consent
          );
        };

        const updateProgress = () => {
          const completed = new Set<number>();

          if (state.massageId && state.variantIndex !== null) {
            completed.add(1);
          }

          if (state.specialistId !== null) {
            completed.add(2);
          }

          if (state.date && state.slot) {
            completed.add(3);
          }

          if (
            state.locationType === "salon" ||
            (state.locationType === "mobile" && addressIsComplete())
          ) {
            completed.add(4);
          }

          if (customerIsComplete()) {
            completed.add(5);
          }

          if (bookingSucceeded) {
            completed.add(6);
          }

          const current = bookingSucceeded
            ? null
            : ([1, 2, 3, 4, 5].find((step) => !completed.has(step)) ?? 6);

          queryAll<HTMLElement>("[data-progress-step]").forEach((item) => {
            const step = Number(item.dataset.progressStep);

            const isCompleted = completed.has(step);

            const isCurrent = step === current;

            item.classList.toggle("is-completed", isCompleted);

            item.classList.toggle("is-active", isCurrent);

            const button = item.querySelector<HTMLButtonElement>("button");

            const number = item.querySelector<HTMLElement>(
              ".reservation-progress__number",
            );

            if (button) {
              if (isCurrent) {
                button.setAttribute("aria-current", "step");
              } else {
                button.removeAttribute("aria-current");
              }
            }

            if (number) {
              number.textContent = isCompleted
                ? "✓"
                : String(step).padStart(2, "0");
            }
          });
        };

        const updateCalendarAvailability = () => {
          const hasService = Boolean(
            state.massageId && state.variantIndex !== null,
          );

          const hasSpecialist = state.specialistId !== null;
          const prerequisitesReady = hasService && hasSpecialist;
          const calendar = query<HTMLElement>("[data-booking-calendar]");

          if (calendar) {
            calendar.dataset.bookingPrerequisitesReady =
              String(prerequisitesReady);

            const maxDate = calendar.dataset.bookingMaxDate ?? "";

            queryAll<HTMLButtonElement>("[data-booking-date]").forEach(
              (button) => {
                button.disabled =
                  !prerequisitesReady ||
                  !maxDate ||
                  button.dataset.bookingDatePast === "true" ||
                  button.dataset.bookingDateOutOfRange === "true";
              },
            );
          }

          if (!hasService) {
            setText(
              "[data-booking-slot-hint]",
              "Najpierw wybierz masaż i jego wariant.",
            );
          } else if (!hasSpecialist) {
            setText(
              "[data-booking-slot-hint]",
              "Najpierw wybierz Adriana albo Aleksandrę.",
            );
          } else if (!state.date) {
            setText(
              "[data-booking-slot-hint]",
              "Wybierz dzień, aby sprawdzić dostępne godziny.",
            );
          }
        };

        const updateSummary = () => {
          const card = getSelectedMassage();

          const variant = getSelectedVariant();

          const massageName = card
            ? [card.dataset.massageTitle, card.dataset.massageService]
                .filter(Boolean)
                .join(" — ")
            : "Jeszcze nie wybrano";

          const specialist =
            query<HTMLInputElement>(
              '[name="specialistId"]:checked',
            )?.closest<HTMLElement>("[data-booking-specialist-card]")?.dataset
              .specialistName ?? "Jeszcze nie wybrano";

          const dateTime = state.slot
            ? new Intl.DateTimeFormat("pl-PL", {
                dateStyle: "long",
                timeStyle: "short",
                timeZone: "Europe/Warsaw",
              }).format(new Date(state.slot.startAt))
            : "Jeszcze nie wybrano";

          const address = state.mobileAddress;

          const location =
            state.locationType === null
              ? "Jeszcze nie wybrano"
              : state.locationType === "salon"
                ? `Salon ORHEA — ${root.dataset.salonAddress ?? "Wrocław"}`
                : [
                    address.street,
                    address.building,
                    address.apartment,
                    address.postalCode,
                    address.city,
                  ]
                    .filter(Boolean)
                    .join(" ") || "Usługa mobilna — adres do uzupełnienia";

          setText("[data-summary-massage]", massageName);

          setText("[data-summary-variant]", variant?.duration ?? "—");

          const addonsPriceGrosze = availableAddons
            .filter((addon) => state.addonIds.includes(addon.id))
            .reduce((sum, addon) => sum + addon.priceGrosze, 0);
          const addonsRow = query<HTMLElement>("[data-summary-addons-row]");
          if (addonsRow) addonsRow.hidden = state.addonIds.length === 0;
          setText(
            "[data-summary-base-price]",
            variant ? money.format(variant.pricePLN) : "—",
          );
          setText("[data-summary-addons-price]", money.format(addonsPriceGrosze / 100));

          setText(
            "[data-summary-price]",
            variant ? money.format(variant.pricePLN + addonsPriceGrosze / 100) : "—",
          );

          setText("[data-summary-specialist]", specialist);

          setText(
            "[data-booking-specialist-note]",
            state.specialistId
              ? `Dostępność jest sprawdzana dla specjalisty: ${specialist}.`
              : "Najpierw wybierz Adriana albo Aleksandrę.",
          );

          setText("[data-summary-date]", dateTime);

          setText("[data-summary-location]", location);

          updateCalendarAvailability();
          updateProgress();

          root.dispatchEvent(
            new CustomEvent("reservation:state-change", {
              bubbles: true,

              detail: {
                state: structuredClone(state),
              },
            }),
          );
        };

        const formatWarsawTime = (iso: string) =>
          new Intl.DateTimeFormat("pl-PL", {
            hour: "2-digit",
            minute: "2-digit",
            hourCycle: "h23",
            timeZone: "Europe/Warsaw",
          }).format(new Date(iso));

        const renderAvailabilitySlots = (slots: BookingAvailabilitySlot[]) => {
          const slotList = query<HTMLElement>("[data-booking-slot-list]");

          if (!slotList) {
            return;
          }

          slotList.replaceChildren();

          slots.forEach((slot) => {
            const label = formatWarsawTime(slot.startAt);
            const button = document.createElement("button");

            button.type = "button";
            button.className = "booking-calendar__slot";
            button.dataset.bookingTime = label;
            button.dataset.bookingStartAt = slot.startAt;
            button.dataset.bookingEndAt = slot.endAt;
            button.setAttribute("aria-label", `Wybierz godzinę ${label}`);
            button.setAttribute("aria-pressed", "false");
            button.textContent = label;
            slotList.append(button);
          });

          slotList.hidden = slots.length === 0;
        };

        const applyBookingWindow = (
          specialistId: SpecialistId,
          bookingWindow: BookingWindow,
        ) => {
          if (
            specialistId !== state.specialistId ||
            !Number.isInteger(bookingWindow.minNoticeMinutes) ||
            bookingWindow.minNoticeMinutes < 0 ||
            !Number.isInteger(bookingWindow.maxAdvanceDays) ||
            bookingWindow.maxAdvanceDays < 0
          ) {
            return false;
          }

          bookingWindowSpecialistId = specialistId;
          setCalendarWindow(bookingWindow);
          return true;
        };

        const fetchBookingWindow = async () => {
          const variant = getSelectedVariant();

          if (!state.massageId || !variant || !state.specialistId) {
            clearBookingWindow();
            updateCalendarAvailability();
            return false;
          }

          if (bookingWindowSpecialistId === state.specialistId) {
            return true;
          }

          bookingWindowController?.abort();
          const requestId = ++bookingWindowRequestSequence;
          const requestController = new AbortController();
          const specialistId = state.specialistId;
          bookingWindowController = requestController;
          setText(
            "[data-booking-slot-hint]",
            "Sprawdzamy zakres dostępnych terminów…",
          );

          try {
            const response = await fetch(
              `/api/availability?${new URLSearchParams({ specialistId })}`,
              {
                headers: { accept: "application/json" },
                signal: requestController.signal,
              },
            );
            const body = (await response.json()) as BookingAvailabilityResponse;

            if (
              requestId !== bookingWindowRequestSequence ||
              requestController.signal.aborted ||
              specialistId !== state.specialistId
            ) {
              return false;
            }

            if (
              !response.ok ||
              !body.success ||
              body.specialistId !== specialistId ||
              !body.bookingWindow ||
              !applyBookingWindow(specialistId, body.bookingWindow)
            ) {
              setCalendarWindow(null);
              setText(
                "[data-booking-slot-hint]",
                response.status === 503
                  ? "Dostępność terminów jest chwilowo niedostępna. Spróbuj ponownie później."
                  : "Nie udało się pobrać zakresu dostępnych terminów.",
              );
              return false;
            }

            updateCalendarAvailability();
            return true;
          } catch (error) {
            if (error instanceof DOMException && error.name === "AbortError") {
              return false;
            }

            if (requestId === bookingWindowRequestSequence) {
              setCalendarWindow(null);
              setText(
                "[data-booking-slot-hint]",
                "Nie udało się pobrać zakresu dostępnych terminów.",
              );
            }

            return false;
          } finally {
            if (requestId === bookingWindowRequestSequence) {
              bookingWindowController = null;
            }
          }
        };

        const fetchAvailability = async () => {
          const variant = getSelectedVariant();

          if (
            !state.massageId ||
            !variant ||
            !addonsReady ||
            !state.specialistId ||
            !state.date ||
            bookingWindowSpecialistId !== state.specialistId
          ) {
            clearAvailability();
            updateCalendarAvailability();
            return;
          }

          clearAvailability();

          const requestId = ++availabilityRequestSequence;
          const requestController = new AbortController();
          availabilityController = requestController;
          const slotList = query<HTMLElement>("[data-booking-slot-list]");

          slotList?.setAttribute("aria-busy", "true");
          setText("[data-booking-slot-hint]", "Sprawdzamy dostępne godziny…");

          const searchParams = new URLSearchParams({
            specialistId: state.specialistId,
            massageId: state.massageId,
            variantCode: variant.variantCode,
            date: state.date,
          });
          state.addonIds.forEach((id) => searchParams.append("addonId", id));

          try {
            const response = await fetch(`/api/availability?${searchParams}`, {
              headers: { accept: "application/json" },
              signal: requestController.signal,
            });
            const body = (await response.json()) as BookingAvailabilityResponse;

            if (
              requestId !== availabilityRequestSequence ||
              requestController.signal.aborted
            ) {
              return;
            }

            if (!response.ok || !body.success) {
              renderAvailabilitySlots([]);
              setText(
                "[data-booking-slot-hint]",
                response.status === 400
                  ? "Sprawdź wybrany masaż, wariant, specjalistę i datę."
                  : response.status === 503
                    ? "Dostępność terminów jest chwilowo niedostępna. Spróbuj ponownie później."
                    : "Nie udało się pobrać terminów. Spróbuj ponownie.",
              );
              return;
            }

            if (
              body.specialistId &&
              body.bookingWindow &&
              !applyBookingWindow(body.specialistId, body.bookingWindow)
            ) {
              renderAvailabilitySlots([]);
              setText(
                "[data-booking-slot-hint]",
                "Nie udało się potwierdzić zakresu dostępnych terminów.",
              );
              return;
            }

            const slots = Array.isArray(body.slots)
              ? body.slots.filter(
                  (slot) =>
                    typeof slot?.startAt === "string" &&
                    typeof slot?.endAt === "string",
                )
              : [];

            renderAvailabilitySlots(slots);
            setText(
              "[data-booking-slot-hint]",
              slots.length > 0
                ? "Wybierz jedną z dostępnych godzin."
                : "Brak dostępnych godzin w wybranym dniu. Wybierz inną datę.",
            );
          } catch (error) {
            if (error instanceof DOMException && error.name === "AbortError") {
              return;
            }

            if (requestId === availabilityRequestSequence) {
              renderAvailabilitySlots([]);
              setText(
                "[data-booking-slot-hint]",
                "Nie udało się pobrać terminów. Spróbuj ponownie.",
              );
            }
          } finally {
            if (requestId === availabilityRequestSequence) {
              slotList?.setAttribute("aria-busy", "false");
              availabilityController = null;
            }
          }
        };

        const selectMassage = (card: HTMLElement, variantIndex: number) => {
          activateStandardFlow();

          const massageId = card.dataset.massageId as MassageId | undefined;

          if (!massageId) {
            return;
          }

          const changed =
            state.massageId !== massageId ||
            state.variantIndex !== variantIndex;
          const massageChanged = state.massageId !== massageId;

          if (massageChanged) clearAddons();

          state.massageId = massageId;

          state.variantIndex = variantIndex;

          const massageInput = query<HTMLInputElement>(
            "[data-booking-massage-id]",
          );

          const variantInput = query<HTMLInputElement>(
            "[data-booking-variant-index]",
          );

          if (massageInput) {
            massageInput.value = massageId;
          }

          if (variantInput) {
            variantInput.value = String(variantIndex);
          }

          queryAll<HTMLElement>("[data-booking-massage-card]").forEach(
            (item) => {
              if (item !== card) {
                const radios = item.querySelectorAll<HTMLInputElement>(
                  'input[type="radio"]',
                );
                if (radios.length === 1) radios[0].checked = false;
              }

              item.classList.toggle("is-selected", item === card);

              item
                .querySelector<HTMLButtonElement>("[data-select-booking]")
                ?.setAttribute("aria-pressed", String(item === card));
            },
          );

          setError("[data-booking-massage-error]", "");

          queryAll<HTMLElement>("[data-booking-card-error]").forEach(
            (error) => {
              error.textContent = "";
            },
          );

          if (changed) {
            clearAvailability();
          }

          updateSummary();

          if (massageChanged || !addonsReady) void loadAddons();

          void (async () => {
            const bookingWindowReady = await fetchBookingWindow();

            if (changed && state.date && bookingWindowReady) {
              await fetchAvailability();
            }
          })();
        };

        const setConditionalFields = (
          container: HTMLElement | null,
          visible: boolean,
        ) => {
          if (!container) {
            return;
          }

          container.hidden = !visible;

          container
            .querySelectorAll<HTMLInputElement>("input")
            .forEach((field) => {
              field.disabled = !visible;
            });
        };

        const activateStandardFlow = () => {
          root.dataset.reservationMode = "booking";

          const progress = query<HTMLElement>(
            "[data-standard-booking-progress]",
          );
          if (progress) progress.hidden = false;

          queryAll<HTMLElement>("[data-standard-booking-section]").forEach(
            (section) => {
              section.hidden = section.hasAttribute("data-booking-addons-section")
                ? availableAddons.length === 0
                : false;
            },
          );

          const inquiry = query<HTMLElement>("[data-reservation-inquiry]");
          if (inquiry) inquiry.hidden = true;

          queryAll<HTMLElement>("[data-inquiry-offer-card]").forEach((card) => {
            card.classList.remove("is-selected");
            card
              .querySelector<HTMLButtonElement>("[data-select-inquiry]")
              ?.setAttribute("aria-pressed", "false");
          });
        };

        const activateInquiryFlow = (card: HTMLElement) => {
          const inquiryType = card.dataset.inquiryType;
          const inquiryTitle = card.dataset.inquiryTitle;

          if (!inquiryType || !inquiryTitle) return;

          clearSelectedDate();
          clearBookingWindow();
          state.massageId = null;
          state.variantIndex = null;
          clearAddons();

          const massageInput = query<HTMLInputElement>(
            "[data-booking-massage-id]",
          );
          const variantInput = query<HTMLInputElement>(
            "[data-booking-variant-index]",
          );
          if (massageInput) massageInput.value = "";
          if (variantInput) variantInput.value = "";

          queryAll<HTMLElement>("[data-booking-massage-card]").forEach(
            (item) => {
              item.classList.remove("is-selected");
              item
                .querySelector<HTMLButtonElement>("[data-select-booking]")
                ?.setAttribute("aria-pressed", "false");
            },
          );

          queryAll<HTMLElement>("[data-inquiry-offer-card]").forEach((item) => {
            const selected = item === card;
            item.classList.toggle("is-selected", selected);
            item
              .querySelector<HTMLButtonElement>("[data-select-inquiry]")
              ?.setAttribute("aria-pressed", String(selected));
          });

          root.dataset.reservationMode = "inquiry";
          const progress = query<HTMLElement>(
            "[data-standard-booking-progress]",
          );
          if (progress) progress.hidden = true;
          queryAll<HTMLElement>("[data-standard-booking-section]").forEach(
            (section) => {
              section.hidden = true;
            },
          );

          const inquiry = query<HTMLElement>("[data-reservation-inquiry]");
          if (inquiry) inquiry.hidden = false;
          const typeInput = query<HTMLInputElement>(
            "[data-inquiry-type-input]",
          );
          const titleInput = query<HTMLInputElement>(
            "[data-inquiry-title-input]",
          );
          if (typeInput) typeInput.value = inquiryType;
          if (titleInput) titleInput.value = inquiryTitle;
          setText("[data-inquiry-selected-title]", inquiryTitle);

          window.requestAnimationFrame(() => scrollToSection(inquiry));
        };

        const resetReservationFlow = () => {
          activateStandardFlow();
          clearSelectedDate();
          clearBookingWindow();
          form.reset();
          bookingSucceeded = false;

          state.massageId = initialMassageId;
          state.variantIndex = initialVariantIndex;
          clearAddons();
          state.specialistId = initialSpecialistId;
          state.date = null;
          state.slot = null;
          state.locationType = "salon";
          state.mobileAddress = {
            street: "",
            building: "",
            apartment: "",
            postalCode: "",
            city: "",
          };
          state.customer = {
            firstName: "",
            lastName: "",
            email: "",
            phone: "",
          };
          state.notes = "";

          const massageInput = query<HTMLInputElement>(
            "[data-booking-massage-id]",
          );
          const variantInput = query<HTMLInputElement>(
            "[data-booking-variant-index]",
          );
          const dateInput = query<HTMLInputElement>(
            "[data-booking-date-input]",
          );
          const startAtInput = query<HTMLInputElement>(
            "[data-booking-start-at-input]",
          );

          if (massageInput) {
            massageInput.value = initialMassageId ?? "";
          }

          if (variantInput) {
            variantInput.value =
              initialVariantIndex === null ? "" : String(initialVariantIndex);
          }

          if (dateInput) {
            dateInput.value = "";
          }

          if (startAtInput) {
            startAtInput.value = "";
          }

          queryAll<HTMLElement>("[data-booking-massage-card]").forEach(
            (card) => {
              const isInitiallySelected =
                card.dataset.massageId === initialMassageId &&
                initialVariantIndex !== null;

              card.classList.toggle("is-selected", isInitiallySelected);
              card
                .querySelector<HTMLButtonElement>("[data-select-booking]")
                ?.setAttribute("aria-pressed", String(isInitiallySelected));
            },
          );

          queryAll<HTMLElement>("[data-booking-specialist-card]").forEach(
            (card) => {
              const radio = card.querySelector<HTMLInputElement>(
                'input[name="specialistId"]',
              );
              card.classList.toggle(
                "is-selected",
                radio?.value === initialSpecialistId,
              );
            },
          );

          queryAll<HTMLElement>("[data-location-card]").forEach((card) => {
            card.classList.toggle(
              "is-selected",
              card.dataset.locationCard === "salon",
            );
          });

          queryAll<HTMLElement>(
            "[data-error-for], [data-booking-massage-error], [data-booking-specialist-error], [data-booking-date-error], [data-booking-card-error]",
          ).forEach((error) => {
            error.textContent = "";
          });

          queryAll<HTMLElement>("[aria-invalid]").forEach((field) => {
            field.removeAttribute("aria-invalid");
          });

          setText("[data-booking-status]", "");
          setConditionalFields(
            query<HTMLElement>("[data-mobile-address]"),
            false,
          );

          query<HTMLElement>("[data-booking-calendar]")?.dispatchEvent(
            new CustomEvent("booking:calendar-reset"),
          );

          updateSummary();
          if (state.massageId && state.variantIndex !== null) void loadAddons();
          void fetchBookingWindow();
        };

        const successModal = query<HTMLDialogElement>(
          "#reservation-booking-success",
        );

        const openSuccessModal = () => {
          document.dispatchEvent(
            new CustomEvent("status-modal:open", {
              detail: {
                id: "reservation-booking-success",
              },
            }),
          );
        };

        successModal?.addEventListener(
          "close",
          () => {
            resetReservationFlow();
          },
          {
            signal: controller.signal,
          },
        );

        root.addEventListener(
          "booking:calendar-window-change",
          (event) => {
            if (!(event instanceof CustomEvent)) {
              return;
            }

            const maxDate = (event.detail as { maxDate?: unknown }).maxDate;

            if (
              typeof maxDate === "string" &&
              maxDate &&
              state.date &&
              state.date > maxDate
            ) {
              clearSelectedDate();
              updateSummary();
            }
          },
          { signal: controller.signal },
        );

        root.addEventListener(
          "booking:month-change",
          (event) => {
            if (!(event instanceof CustomEvent)) {
              return;
            }

            const month = (event.detail as { month?: unknown }).month;

            if (
              typeof month !== "string" ||
              !state.date ||
              state.date.startsWith(`${month}-`)
            ) {
              updateCalendarAvailability();
              return;
            }

            clearSelectedDate();
            updateSummary();
          },
          { signal: controller.signal },
        );

        root.addEventListener(
          "tabs:change",
          (event) => {
            if (!(event instanceof CustomEvent)) return;
            const source = event.target;
            if (
              !(source instanceof HTMLElement) ||
              !source.classList.contains("reservation-massage-tabs")
            ) {
              return;
            }

            if ((event.detail as { id?: string }).id !== "inne") {
              activateStandardFlow();
            }

            scrollToSection(query<HTMLElement>("#reservation-massage"));
          },
          { signal: controller.signal },
        );

        root.addEventListener(
          "click",
          (event) => {
            const target = event.target;

            if (!(target instanceof Element)) {
              return;
            }

            if (target.closest("[data-booking-addons-retry]")) {
              void loadAddons();
              return;
            }

            const locationCard = target.closest<HTMLElement>(
              "[data-location-card]",
            );

            if (locationCard) {
              if (target.closest("a, button, input, label")) {
                return;
              }

              const locationRadio =
                locationCard.querySelector<HTMLInputElement>(
                  'input[type="radio"][name="locationType"]',
                );

              if (
                locationRadio &&
                !locationRadio.disabled &&
                !locationRadio.checked
              ) {
                locationRadio.checked = true;

                locationRadio.dispatchEvent(
                  new Event("change", {
                    bubbles: true,
                  }),
                );
              }

              return;
            }

            const specialistCard = target.closest<HTMLElement>(
              "[data-booking-specialist-card]",
            );

            if (specialistCard && !target.closest("input, label")) {
              const specialistRadio =
                specialistCard.querySelector<HTMLInputElement>(
                  'input[type="radio"][name="specialistId"]',
                );

              if (specialistRadio && !specialistRadio.disabled) {
                specialistRadio.checked = true;
                specialistRadio.dispatchEvent(
                  new Event("change", { bubbles: true }),
                );
              }
              return;
            }

            const inquiryButton = target.closest<HTMLButtonElement>(
              "[data-select-inquiry]",
            );

            if (inquiryButton) {
              const inquiryCard = inquiryButton.closest<HTMLElement>(
                "[data-inquiry-offer-card]",
              );
              if (inquiryCard) activateInquiryFlow(inquiryCard);
              return;
            }

            const selectButton = target.closest<HTMLButtonElement>(
              "[data-select-booking]",
            );

            if (selectButton) {
              const card = selectButton.closest<HTMLElement>(
                "[data-booking-massage-card]",
              );

              let selectedVariant = card?.querySelector<HTMLInputElement>(
                'input[type="radio"]:checked',
              );

              const variantRadios = card
                ? Array.from(
                    card.querySelectorAll<HTMLInputElement>(
                      'input[type="radio"]',
                    ),
                  )
                : [];

              if (!selectedVariant && variantRadios.length === 1) {
                variantRadios[0].checked = true;
                selectedVariant = variantRadios[0];
              }

              const error = card?.querySelector<HTMLElement>(
                "[data-booking-card-error]",
              );

              if (!card || !selectedVariant) {
                if (error) {
                  error.textContent = "Wybierz konkretny wariant czasu i ceny.";
                }

                card
                  ?.querySelector<HTMLInputElement>('input[type="radio"]')
                  ?.focus();

                return;
              }

              selectMassage(card, Number(selectedVariant.value));

              return;
            }

            const dateButton = target.closest<HTMLButtonElement>(
              "[data-booking-date]",
            );

            if (
              dateButton?.dataset.bookingDate &&
              !dateButton.disabled &&
              dateButton.dataset.bookingDateOutOfRange !== "true"
            ) {
              clearAvailability();
              state.date = dateButton.dataset.bookingDate;

              const calendar = query<HTMLElement>("[data-booking-calendar]");

              if (calendar) {
                calendar.dataset.bookingSelectedDate = state.date;
              }

              const dateInput = query<HTMLInputElement>(
                "[data-booking-date-input]",
              );

              if (dateInput) {
                dateInput.value = state.date;
              }

              queryAll<HTMLButtonElement>("[data-booking-date]").forEach(
                (button) => {
                  const selected = button === dateButton;

                  button.classList.toggle("is-selected", selected);

                  button.setAttribute("aria-pressed", String(selected));
                },
              );

              setError("[data-booking-date-error]", "");

              updateSummary();
              void fetchAvailability();

              return;
            }

            const timeButton = target.closest<HTMLButtonElement>(
              "[data-booking-time]",
            );

            if (
              timeButton?.dataset.bookingStartAt &&
              timeButton.dataset.bookingEndAt &&
              state.date
            ) {
              state.slot = {
                startAt: timeButton.dataset.bookingStartAt,
                endAt: timeButton.dataset.bookingEndAt,
              };

              const startAtInput = query<HTMLInputElement>(
                "[data-booking-start-at-input]",
              );

              if (startAtInput) {
                startAtInput.value = state.slot.startAt;
              }

              queryAll<HTMLButtonElement>("[data-booking-time]").forEach(
                (button) => {
                  const selected = button === timeButton;

                  button.classList.toggle("is-selected", selected);

                  button.setAttribute("aria-pressed", String(selected));
                },
              );

              setError("[data-booking-date-error]", "");

              updateSummary();

              return;
            }

            const progressTarget = target.closest<HTMLElement>(
              "[data-progress-target]",
            )?.dataset.progressTarget;

            const changeTarget = target.closest<HTMLElement>(
              "[data-booking-change]",
            )?.dataset.bookingChange;

            const sectionId = progressTarget ?? changeTarget;

            if (sectionId) {
              scrollToSection(document.getElementById(sectionId));
            }
          },
          {
            signal: controller.signal,
          },
        );

        root.addEventListener(
          "change",
          (event) => {
            const field = event.target;

            if (!(
              field instanceof HTMLInputElement ||
              field instanceof HTMLTextAreaElement
            )) {
              return;
            }

            if (field instanceof HTMLInputElement && field.name === "bookingAddon") {
              if (!availableAddons.some((addon) => addon.id === field.value)) return;
              if (field.checked && state.addonIds.length >= 12) {
                field.checked = false;
                const stateBox = query<HTMLElement>("[data-booking-addons-state]");
                if (stateBox) stateBox.hidden = false;
                setText("[data-booking-addons-status]", "Możesz wybrać maksymalnie 12 dodatków.");
                return;
              }
              state.addonIds = field.checked
                ? [...state.addonIds, field.value]
                : state.addonIds.filter((id) => id !== field.value);
              clearAvailability();
              updateSummary();
              if (state.date) void fetchAvailability();
              return;
            }

            if (field.name.startsWith("booking-variant-")) {
              const card = field.closest<HTMLElement>(
                "[data-booking-massage-card]",
              );

              if (card?.classList.contains("is-selected")) {
                selectMassage(card, Number(field.value));
              }
            }

            if (field.name === "specialistId") {
              const nextSpecialist = field.value as SpecialistId;
              const changed = state.specialistId !== nextSpecialist;

              if (changed) {
                clearAvailability();
                clearBookingWindow();
              }

              state.specialistId = nextSpecialist;

              queryAll<HTMLElement>("[data-booking-specialist-card]").forEach(
                (card) => {
                  card.classList.toggle("is-selected", card.contains(field));
                },
              );

              queryAll<HTMLInputElement>('[name="specialistId"]').forEach(
                (radio) => radio.removeAttribute("aria-invalid"),
              );

              setError("[data-booking-specialist-error]", "");

              if (changed) {
                void (async () => {
                  const bookingWindowReady = await fetchBookingWindow();

                  if (state.date && bookingWindowReady) {
                    await fetchAvailability();
                  }
                })();
              }
            }

            if (field.name === "locationType") {
              state.locationType =
                field.value === "mobile" ? "mobile" : "salon";

              setConditionalFields(
                query<HTMLElement>("[data-mobile-address]"),

                state.locationType === "mobile",
              );

              queryAll<HTMLElement>("[data-location-card]").forEach((card) => {
                card.classList.toggle(
                  "is-selected",

                  card.dataset.locationCard === state.locationType,
                );
              });
            }

            updateSummary();
          },
          {
            signal: controller.signal,
          },
        );

        form.addEventListener(
          "input",
          (event) => {
            const field = event.target;

            if (!(
              field instanceof HTMLInputElement ||
              field instanceof HTMLTextAreaElement
            )) {
              return;
            }

            const customerKey =
              field.name as keyof ReservationState["customer"];

            const addressMap: Record<
              string,
              keyof ReservationState["mobileAddress"]
            > = {
              mobileStreet: "street",

              mobileBuilding: "building",

              mobileApartment: "apartment",

              mobilePostalCode: "postalCode",

              mobileCity: "city",
            };

            if (customerKey in state.customer) {
              state.customer[customerKey] = field.value;
            }

            if (addressMap[field.name]) {
              state.mobileAddress[addressMap[field.name]] = field.value;
            }

            if (field.name === "notes") {
              state.notes = field.value;
            }

            field.removeAttribute("aria-invalid");

            const error = query<HTMLElement>(
              `[data-error-for="${field.name}"]`,
            );

            if (error) {
              error.textContent = "";
            }

            updateSummary();
          },
          {
            signal: controller.signal,
          },
        );

        const getValidationMessage = (
          field: HTMLInputElement | HTMLTextAreaElement,
        ) => {
          if (field.name === "termsAccepted" && field.validity.valueMissing) {
            return "Zaakceptuj Regulamin i Politykę prywatności, aby wysłać rezerwację.";
          }

          if (field.type === "email" && field.validity.typeMismatch) {
            return "Podaj poprawny adres e-mail.";
          }

          if (field.name === "phone" && field.validity.patternMismatch) {
            return "Podaj poprawny numer telefonu.";
          }

          if (
            field.name === "mobilePostalCode" &&
            field.validity.patternMismatch
          ) {
            return "Podaj kod pocztowy w formacie 00-000.";
          }

          if (field.validity.tooShort) {
            return "Podaj co najmniej wymaganą liczbę znaków.";
          }

          if (field.validity.valueMissing) {
            return "Uzupełnij to pole.";
          }

          return "Sprawdź poprawność tego pola.";
        };

        form.addEventListener(
          "invalid",
          (event) => {
            const field = event.target;

            if (!(
              field instanceof HTMLInputElement ||
              field instanceof HTMLTextAreaElement
            )) {
              return;
            }

            field.setAttribute("aria-invalid", "true");

            const error = query<HTMLElement>(
              `[data-error-for="${field.name}"]`,
            );

            if (error) {
              error.textContent = getValidationMessage(field);
            }
          },
          {
            capture: true,

            signal: controller.signal,
          },
        );

        form.addEventListener(
          "submit",
          async (event) => {
            event.preventDefault();

            if (submitting) {
              return;
            }

            const status = query<HTMLElement>("[data-booking-status]");
            const submitButton = query<HTMLButtonElement>(
              '.booking-summary__submit[type="submit"]',
            );

            let selectionValid = true;

            if (!state.massageId || state.variantIndex === null) {
              setError(
                "[data-booking-massage-error]",
                "Wybierz masaż i konkretny wariant czasu.",
              );

              selectionValid = false;
            }

            if (!addonsReady) {
              const stateBox = query<HTMLElement>("[data-booking-addons-state]");
              if (stateBox) stateBox.hidden = false;
              setText("[data-booking-addons-status]", "Poczekaj na pobranie dodatków przed wysłaniem rezerwacji.");
              selectionValid = false;
            }

            if (state.specialistId === null) {
              setError(
                "[data-booking-specialist-error]",
                "Wybierz Adriana albo Aleksandrę.",
              );

              queryAll<HTMLInputElement>('[name="specialistId"]').forEach(
                (radio) => radio.setAttribute("aria-invalid", "true"),
              );

              selectionValid = false;
            }

            if (!state.date || !state.slot) {
              setError(
                "[data-booking-date-error]",
                "Wybierz dostępny dzień i godzinę.",
              );

              selectionValid = false;
            }

            const fieldsValid = form.checkValidity();

            if (!selectionValid || !fieldsValid) {
              if (status) {
                status.textContent =
                  "Uzupełnij wymagane pola i wybory rezerwacji.";
              }

              if (!fieldsValid) {
                form
                  .querySelector<HTMLElement>(
                    "input:invalid, textarea:invalid, select:invalid",
                  )
                  ?.focus();
              }

              return;
            }

            const variant = getSelectedVariant();
            const paymentMethod = query<HTMLInputElement>('[name="paymentMethod"]:checked')?.value;
            const consent =
              query<HTMLInputElement>('[name="termsAccepted"]')?.checked ??
              false;

            if (
              !variant ||
              !state.massageId ||
              !state.specialistId ||
              !state.slot ||
              !state.locationType
            ) {
              return;
            }

            const payload = {
              massageId: state.massageId,
              paymentMethod,
              publicCreationKey,
              variantCode: variant.variantCode,
              addonIds: [...state.addonIds],
              specialistId: state.specialistId,
              startAt: state.slot.startAt,
              locationType: state.locationType,
              mobileAddress:
                state.locationType === "mobile"
                  ? {
                      street: state.mobileAddress.street,
                      buildingNumber: state.mobileAddress.building,
                      apartmentNumber:
                        state.mobileAddress.apartment || undefined,
                      postalCode: state.mobileAddress.postalCode,
                      city: state.mobileAddress.city,
                    }
                  : undefined,
              customer: { ...state.customer },
              contactByEmail: true,
              contactByPhone: false,
              notes: state.notes || undefined,
              termsAccepted: consent,
              privacyAccepted: consent,
            };

            submitting = true;

            if (submitButton) {
              submitButton.disabled = true;
            }

            if (status) {
              status.textContent = "Wysyłamy rezerwację…";
            }

            try {
              const response = await fetch("/api/bookings", {
                method: "POST",
                headers: {
                  accept: "application/json",
                  "content-type": "application/json",
                },
                body: JSON.stringify(payload),
              });
              const body = (await response.json()) as {
                success?: boolean;
                message?: string;
                code?: string;
                booking?: { checkoutUrl?: string };
              };

              if (response.status === 409 && body.code === "slot_unavailable") {
                clearSelectedSlot();
                updateSummary();
                setError(
                  "[data-booking-date-error]",
                  "Wybrany termin nie jest już dostępny.",
                );

                if (status) {
                  status.textContent = "Wybrany termin nie jest już dostępny.";
                  status.focus();
                }

                await fetchAvailability();
                return;
              }

              if (!response.ok || !body.success) {
                if (status) {
                  status.textContent =
                    response.status === 400 || response.status === 503
                      ? body.message || "Nie można teraz wysłać tej rezerwacji."
                      : "Nie udało się wysłać rezerwacji. Spróbuj ponownie.";
                  status.focus();
                }
                return;
              }

              if (paymentMethod === "online" && body.booking?.checkoutUrl) {
                if (status) status.textContent = "Przekierowujemy do bezpiecznej płatności…";
                window.location.assign(body.booking.checkoutUrl);
                return;
              }

              if (status) {
                status.textContent =
                  body.message ||
                  "Rezerwacja została przyjęta i oczekuje na potwierdzenie.";
              }

              bookingSucceeded = true;
              updateProgress();
              openSuccessModal();
            } catch {
              if (status) {
                status.textContent =
                  "Nie udało się wysłać rezerwacji. Sprawdź połączenie i spróbuj ponownie.";
                status.focus();
              }
            } finally {
              submitting = false;

              if (submitButton) {
                submitButton.disabled = false;
              }
            }
          },
          {
            signal: controller.signal,
          },
        );

        document.addEventListener(
          "astro:before-swap",
          () => {
            if (progressFrame !== null) {
              window.cancelAnimationFrame(progressFrame);

              progressFrame = null;
            }

            availabilityController?.abort();
            addonsController?.abort();
            bookingWindowController?.abort();
            controller.abort();
          },
          {
            once: true,
            signal: controller.signal,
          },
        );

        const initialCard = getSelectedMassage();

        if (initialCard && state.variantIndex !== null) {
          initialCard.classList.add("is-selected");
        }

        setConditionalFields(
          query<HTMLElement>("[data-mobile-address]"),
          false,
        );
        activateStandardFlow();
        updateProgressPosition();

        updateSummary();
        if (state.massageId && state.variantIndex !== null) void loadAddons();
        void fetchBookingWindow();
      });
  };

  initReservationFlows();

  document.addEventListener("astro:page-load", initReservationFlows);
</script>
