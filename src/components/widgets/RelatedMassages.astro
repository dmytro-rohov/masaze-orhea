---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";

import Icon from "@/components/media/Icon.astro";

import MassageCards from "@/components/widgets/MassageCards.astro";

import { getPublicMassageCatalog } from "@/server/catalog/massage-catalog.service";

export interface Props {
  currentMassageId: string;
  massageIds?: string[];
  title?: string;
  description?: string;
  class?: string;
}

const {
  currentMassageId,
  massageIds = [],
  title = "Zobacz podobne masaże",
  description = "Sprawdź inne masaże, które mogą odpowiadać Twoim potrzebom.",
  class: className,
  ...restProps
} = Astro.props;

const catalog = await getPublicMassageCatalog();
const currentMassage = catalog.find((massage) => massage.id === currentMassageId);
const candidates = [
  ...massageIds.map((id) => catalog.find((massage) => massage.id === id)),
  ...catalog.filter((massage) => massage.zoneId === currentMassage?.zoneId),
  ...catalog.filter((massage) => currentMassage?.zoneId === "vip" || massage.zoneId !== "vip"),
];
const relatedMassages = candidates.filter((massage, index, all): massage is (typeof catalog)[number] =>
  Boolean(massage && massage.id !== currentMassageId && all.findIndex((item) => item?.id === massage.id) === index),
).slice(0, 3);
---

{
  relatedMassages.length > 0 && (
    <Section {...restProps} class:list={["related-massages", className]}>
      <Container>
        <Stack space="xl">
          <Stack
            space="xs"
            class="related-massages__header"
            data-reveal="up"
          >
            <h2 class="massage-details__section-title">
              <Icon name="ic-branch-top" size="2rem" class="icon-w-f" />
              {title}
            </h2>

            {description && (
              <p class="related-massages__description">{description}</p>
            )}
          </Stack>

          <MassageCards massages={relatedMassages} />
        </Stack>
      </Container>
    </Section>
  )
}
