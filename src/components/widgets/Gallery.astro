---
import type { ImageMetadata } from "astro";

import Img from "@/components/media/Img.astro";

export type GalleryImage = {
  src: ImageMetadata | string;
  alt: string;
  sizes?: string;
};

export interface Props {
  images: GalleryImage[];
  class?: string;
}

const { images, class: className, ...restProps } = Astro.props;
---

<ul {...restProps} class:list={["gallery", className]}>
  {
    images.map((image) => (
      <li class="gallery__item">
        <Img
          src={image.src}
          alt={image.alt}
          class="gallery__image"
          widths={[320, 480, 720, 960]}
          sizes={image.sizes ?? "(max-width: 640px) 88vw, 28vw"}
        />
      </li>
    ))
  }
</ul>
