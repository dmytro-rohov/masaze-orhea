---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";

import Video from "@/components/media/Video.astro";
import Link from "@/components/ui/Link.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import type { ImageMetadata } from "astro";

// assets
import BgImageRight from "@assets/img/olive-with-fruits-right.png";
import imgFlowers from "@/assets/img/flowers.png";

type VideoSource = {
  src: string;
  type: "video/webm" | "video/mp4" | string;
};

type MassageVideo = {
  src?: string;
  sources?: VideoSource[];
  poster?: string;
  label: string;
};

type Action = {
  label: string;
  href: string;
};

export interface Props {
  eyebrow?: string;
  eyebrowImage?: ImageMetadata;
  eyebrowImageAlt?: string;
  title?: string;
  description?: string;
  videos: MassageVideo[];
  initialActiveIndex?: number;
  action?: Action;
  class?: string;
}

const {
  eyebrow,
  eyebrowImage,
  title = "Techniki masażu dopasowane do Twoich potrzeb",
  description = "Zobacz, jak pracujemy. Każda technika ma swój cel i zastosowanie — wybierz tę, która najlepiej odpowiada Twoim potrzebom.",
  videos,
  initialActiveIndex = 2,
  action,
  class: className,
  ...restProps
} = Astro.props;

const safeInitialActiveIndex = Math.min(
  Math.max(initialActiveIndex, 0),
  Math.max(videos.length - 1, 0),
);
---

<Section {...restProps} class:list={["massage-techniques", className]}>
  <Container>
    <Stack class="massage-techniques__content" space="xl">
      <Stack class="massage-header" space="md">
        {
          eyebrowImage ? (
            <Img
              src={eyebrowImage}
              alt="Orhea – masaż i terapia ciała"
              class="eyebrow-image"
            />
          ) : eyebrow ? (
            <span class="hero__eyebrow">{eyebrow}</span>
          ) : null
        }

        <h2 class="massage-techniques__title">
          {title}
        </h2>

        {
          description && (
            <p class="massage-techniques__description">{description}</p>
          )
        }
      </Stack>

      <div
        class="massage-techniques__gallery"
        data-massage-gallery
        data-active-index={safeInitialActiveIndex}
        style={`--item-count: ${videos.length};`}
      >
        {
          videos.map((video, index) => {
            const isActive = index === safeInitialActiveIndex;

            return (
              <>
                <button
                  class:list={[
                    "massage-techniques__item",
                    isActive && "is-active",
                  ]}
                  style={`--item-index: ${index}; --active-translate-x: 0px;`}
                  type="button"
                  aria-label={`Odtwórz: ${video.label}`}
                  aria-pressed={isActive ? "true" : "false"}
                  data-massage-video-trigger
                  data-massage-index={index}
                >
                  <Video
                    src={video.src}
                    sources={video.sources}
                    poster={video.poster}
                    label={video.label}
                    controls={false}
                    autoplay={false}
                    muted={true}
                    loop={false}
                    playsinline={true}
                    preload="metadata"
                    class="massage-techniques__video"
                    data-massage-video
                  />
                </button>

                <div
                  class:list={[
                    "massage-techniques__ghost",
                    isActive && "is-active",
                  ]}
                  style={`--item-index: ${index};`}
                  data-massage-video-ghost
                  data-massage-index={index}
                  aria-hidden="true"
                >
                  <Video
                    src={video.src}
                    sources={video.sources}
                    poster={video.poster}
                    label=""
                    controls={false}
                    autoplay={false}
                    muted={true}
                    loop={true}
                    playsinline={true}
                    preload="none"
                    class="massage-techniques__ghost-video"
                    data-massage-ghost-video
                  />
                </div>
              </>
            );
          })
        }
      </div>

      {
        action && (
          <div class="massage-techniques__actions">
            <Link href={action.href} class="button button--primary">
              <span class="button__label">
                <span class="button__label-front">{action.label}</span>

                <span class="button__label-back" aria-hidden="true">
                  {action.label}
                </span>
              </span>
            </Link>
          </div>
        )
      }
    </Stack>

    <Img
      src={BgImageRight}
      alt=""
      kind="decorative"
      class="image-decorative image-decorative--right"
    />

    <div class="image-wrapper">
      <Img
        src={imgFlowers}
        alt=""
        kind="decorative"
        class="massage__image-decor"
      />
    </div>
  </Container>

  <Icon name="ic-massage-bg" class="icon-w-f icon-bg" />
</Section>

<script>
  const initMassageTechniqueGalleries = () => {
    const galleries = document.querySelectorAll<HTMLElement>(
      "[data-massage-gallery]",
    );

    galleries.forEach((gallery) => {
      if (gallery.dataset.initialized === "true") {
        return;
      }

      gallery.dataset.initialized = "true";

      const triggers = Array.from(
        gallery.querySelectorAll<HTMLButtonElement>(
          "[data-massage-video-trigger]",
        ),
      );

      const ghosts = Array.from(
        gallery.querySelectorAll<HTMLElement>("[data-massage-video-ghost]"),
      );

      const hoverMedia = window.matchMedia(
        "(hover: hover) and (pointer: fine)",
      );

      const desktopGallery = window.matchMedia("(min-width: 769px)");

      const getTriggerVideo = (trigger: HTMLButtonElement) => {
        return trigger.querySelector<HTMLVideoElement>("[data-massage-video]");
      };

      const getGhostVideo = (ghost: HTMLElement) => {
        return ghost.querySelector<HTMLVideoElement>(
          "[data-massage-ghost-video]",
        );
      };

      const stopPreview = (trigger: HTMLButtonElement, reset = true) => {
        if (trigger.classList.contains("is-active")) {
          return;
        }

        const video = getTriggerVideo(trigger);

        if (!video) {
          return;
        }

        video.pause();

        if (reset) {
          try {
            video.currentTime = 0;
          } catch {
            // Preview reset can fail before the media metadata is available.
          }
        }
      };

      const playPreview = async (trigger: HTMLButtonElement) => {
        if (trigger.classList.contains("is-active") || !hoverMedia.matches) {
          return;
        }

        const video = getTriggerVideo(trigger);

        if (!video) {
          return;
        }

        try {
          await video.play();
        } catch {
          // Preview playback is optional and may be blocked by the browser.
        }
      };

      const deactivateGhost = (ghost: HTMLElement) => {
        ghost.classList.remove("is-active");

        const ghostVideo = getGhostVideo(ghost);

        if (!ghostVideo) {
          return;
        }

        ghostVideo.pause();

        try {
          ghostVideo.currentTime = 0;
        } catch {
          // Ghost reset can fail before the media metadata is available.
        }
      };

      const activateGhost = async (index: number) => {
        ghosts.forEach((ghost, ghostIndex) => {
          if (ghostIndex !== index) {
            deactivateGhost(ghost);
          }
        });

        const ghost = ghosts[index];

        if (!ghost) {
          return;
        }

        ghost.classList.add("is-active");

        const ghostVideo = getGhostVideo(ghost);

        if (!ghostVideo) {
          return;
        }

        try {
          ghostVideo.currentTime = 0;
        } catch {
          // Ghost reset can fail before the media metadata is available.
        }

        try {
          await ghostVideo.play();
        } catch {
          // Ghost preview is decorative, so failure is harmless.
        }
      };

      const updateActiveTranslation = (index: number) => {
        if (!desktopGallery.matches) {
          triggers.forEach((trigger) => {
            trigger.style.setProperty("--active-translate-x", "0px");
          });

          return;
        }

        const trigger = triggers[index];

        const ghost = ghosts[index];

        if (!trigger || !ghost) {
          return;
        }

        const galleryRect = gallery.getBoundingClientRect();

        const ghostRect = ghost.getBoundingClientRect();

        const galleryCenter = galleryRect.left + galleryRect.width / 2;

        const slotCenter = ghostRect.left + ghostRect.width / 2;

        const translateX = galleryCenter - slotCenter;

        trigger.style.setProperty("--active-translate-x", `${translateX}px`);
      };

      const deactivateVideo = (trigger: HTMLButtonElement) => {
        const video = getTriggerVideo(trigger);

        trigger.classList.remove("is-active");
        trigger.setAttribute("aria-pressed", "false");

        if (!video) {
          return;
        }

        video.pause();

        try {
          video.currentTime = 0;
        } catch {
          // Metadata may not be available yet.
        }
      };

      const activateVideo = async (
        trigger: HTMLButtonElement,
        index: number,
      ) => {
        updateActiveTranslation(index);

        triggers.forEach((currentTrigger) => {
          if (currentTrigger !== trigger) {
            deactivateVideo(currentTrigger);
          }
        });

        trigger.classList.add("is-active");

        trigger.setAttribute("aria-pressed", "true");

        gallery.dataset.activeIndex = String(index);

        void activateGhost(index);

        const video = getTriggerVideo(trigger);

        if (!video) {
          return;
        }

        try {
          await video.play();
        } catch {
          // Muted inline video normally plays automatically.
        }
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener("click", () => {
          void activateVideo(trigger, index);
        });

        trigger.addEventListener("pointerenter", () => {
          void playPreview(trigger);
        });

        trigger.addEventListener("pointerleave", () => {
          stopPreview(trigger);
        });

        trigger.addEventListener("focus", () => {
          void playPreview(trigger);
        });

        trigger.addEventListener("blur", () => {
          stopPreview(trigger);
        });
      });

      const updateCurrentPosition = () => {
        const activeIndex = Number(gallery.dataset.activeIndex ?? 0);

        updateActiveTranslation(activeIndex);
      };

      const resizeObserver = new ResizeObserver(() => {
        updateCurrentPosition();
      });

      resizeObserver.observe(gallery);

      const initialIndex = Number(gallery.dataset.activeIndex ?? 0);

      updateActiveTranslation(initialIndex);

      void activateGhost(initialIndex);

      const initialTrigger = triggers[initialIndex];

      const initialVideo = initialTrigger
        ? getTriggerVideo(initialTrigger)
        : null;

      if (initialTrigger && initialVideo) {
        initialVideo.play().catch(() => {
          // Browser may reject autoplay.
        });
      }

      document.addEventListener(
        "astro:before-swap",
        () => {
          resizeObserver.disconnect();
        },
        {
          once: true,
        },
      );
    });
  };

  initMassageTechniqueGalleries();

  document.addEventListener("astro:page-load", initMassageTechniqueGalleries);
</script>
