---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Tabs from "@/components/widgets/Tabs.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import Link from "@/components/ui/Link.astro";
import Video from "@/components/media/Video.astro";

import { massageZones, type MassageZone } from "@/data/massage-zones";
import { getMassageFullName } from "@/data/massages";
import { getMassageOfferPath } from "@/data/massage-pages";
import { getMassageZoneVisual } from "@/data/massage-zone-visuals";

// assets
import BgImageRight from "@/assets/img/olive-with-fruits-right.png";

export interface Props {
  initialActiveZone?: string;
  tone?: "default" | "muted" | "inverse";
  class?: string;
}

const zoneTabs = massageZones.map((zone) => ({
  id: zone.id,
  label: zone.shortName,
}));

const {
  initialActiveZone = massageZones[0]?.id,
  tone = "default",
  class: className,
  ...restProps
} = Astro.props;

const totalMassages = massageZones.reduce(
  (total, zone) => total + zone.massages.length,
  0,
);

const getZoneVisual = (zone: MassageZone) => {
  return getMassageZoneVisual(zone.id);
};

const initialCompactZones = massageZones.filter(
  (zone) => zone.id !== initialActiveZone,
);

const getInitialZoneSlot = (zone: MassageZone) => {
  if (zone.id === initialActiveZone) {
    return 0;
  }

  return (
    initialCompactZones.findIndex((compactZone) => compactZone.id === zone.id) +
    1
  );
};
---

<Section {...restProps} tone={tone} class:list={["massage-zones", className]}>
  <Container>
    <Stack class="massage-zones__content" space="xl">
      <Stack class="massage-zones__header" space="md">
        <span class="massage-zones__eyebrow">
          <Icon name="ic-branch" size="0.875rem" />

          <span>
            {massageZones.length} strefy · {totalMassages} usług
          </span>
        </span>

        <h2 class="massage-zones__title">
          Rodzaje masażu we Wrocławiu dopasowane do potrzeb Twojego ciała
        </h2>

        <p class="massage-zones__description">
          Wybierz strefę, która najlepiej odpowiada Twoim potrzebom.
          <br />
          Odkryj techniki i usługi stworzone z myślą o Twoim komforcie i dobrym samopoczuciu.
        </p>
      </Stack>

      <div class="massage-zones__mobile-tabs" data-zone-tabs>
        <Tabs
          items={zoneTabs}
          initialActiveId={initialActiveZone}
          ariaLabel="Wybierz strefę masażu"
          mode="switcher"
          class="massage-zones__tabs"
        />
      </div>

      <div class="massage-zones__grid" data-massage-zones>
        <div class="massage-zones__cursor" data-zone-cursor aria-hidden="true">
          <span>Otwórz</span>
        </div>

        {
          massageZones.map((zone) => {
            const visual = getZoneVisual(zone);
            const isActive = zone.id === initialActiveZone;
            const initialSlot = getInitialZoneSlot(zone);

            return (
              <article
                class:list={["massage-zones__zone", isActive && "is-active"]}
                data-zone
                data-zone-id={zone.id}
                data-zone-slot={initialSlot}
              >
                <button
                  class="massage-zones__compact"
                  type="button"
                  aria-label={`Otwórz strefę: ${zone.name}`}
                  aria-expanded={isActive ? "true" : "false"}
                  data-zone-trigger
                >
                  <Img
                    src={visual.image}
                    alt=""
                    kind="decorative"
                    class="massage-zones__compact-image"
                    widths={[320, 480, 640]}
                    sizes="(max-width: 768px) 90vw, 33vw"
                  />

                  <span class="massage-zones__compact-overlay" />

                  <span class="massage-zones__compact-content">
                    <span class="massage-zones__compact-heading">
                      <span class="massage-zones__icon-image">
                        <Img src={visual.icon} alt="" kind="decorative" />
                      </span>

                      <span class="massage-zones__compact-title">
                        {zone.name}
                      </span>
                    </span>

                    <span class="massage-zones__compact-description">
                      {zone.description}
                    </span>

                    <span class="massage-zones__compact-count">
                      {zone.massages.length}{" "}
                      {zone.massages.length === 1 ? "usługa" : "usług"}
                      <Icon
                        name="ic-arrow-right"
                        class="icon-w-f"
                        size="0.6rem"
                      />
                    </span>
                  </span>
                </button>

                <div class="massage-zones__expanded">
                  <button
                    class="massage-zones__next button button--secondary"
                    type="button"
                    aria-label="Pokaż następną strefę masażu"
                    data-zone-next
                  >
                    <span>Następna strefa</span>

                    <Icon
                      name="ic-arrow-right"
                      class="icon-w-f"
                      size="0.7rem"
                    />
                  </button>

                  <div class="massage-zones__expanded-inner">
                    <Stack as="div" space="md" class="massage-zones__feature">
                      <div class="massage-zones__feature-heading">
                        <span class="massage-zones__feature-icon">
                          <Img src={visual.icon} alt="" kind="decorative" />
                        </span>

                        <Stack as="div" space="md">
                          <h3 class="massage-zones__zone-title">{zone.name}</h3>

                          <p class="massage-zones__zone-description">
                            {zone.description}
                          </p>
                        </Stack>
                      </div>

                      <div class="massage-zones__media" data-zone-video-wrapper>
                        <Video
                          sources={visual.videoSources}
                          poster={visual.image.src}
                          label={`Film prezentujący ${zone.name}`}
                          controls={false}
                          autoplay={true}
                          muted={true}
                          loop={true}
                          playsinline={true}
                          preload="metadata"
                          class="massage-zones__video"
                          data-zone-video
                        />
                      </div>

                      <div class="massage-zones__actions">
                        <Link
                          href={`/uslugi?strefa=${zone.id}#strefy`}
                          class="button button--primary massage-zones__offer"
                        >
                          <span class="button__label">
                            <span class="button__label-front">
                              Zobacz ofertę w {zone.name}
                            </span>

                            <span class="button__label-back" aria-hidden="true">
                              Zobacz ofertę w {zone.name}
                            </span>
                          </span>

                          <Icon
                            name="ic-arrow-right"
                            class="icon-w-f"
                            size="1rem"
                          />
                        </Link>

                        <Link
                          href="tel:+1234567890"
                          data-analytics-contact-link="phone"
                          class="button button--secondary massage-zones__call"
                        >
                          Zadzwoń
                        </Link>
                      </div>
                    </Stack>

                    <div class="massage-zones__services">
                      <Img
                        src={BgImageRight}
                        alt=""
                        kind="decorative"
                        class="image-decorative image-decorative--right"
                      />

                      <ol class="massage-zones__services-list">
                        {zone.massages.map((massage, index) => (
                          <li class="massage-zones__service">
                            <Link
                              href={getMassageOfferPath(massage)}
                              class="massage-zones__service-button"
                              ariaLabel={`Zobacz ofertę: ${getMassageFullName(massage)}`}
                            >
                              <span class="massage-zones__services-box">
                                <span class="massage-zones__service-number">
                                  {String(index + 1).padStart(2, "0")}
                                </span>

                                <Stack
                                  as="span"
                                  space="sm"
                                  class="massage-zones__service-content"
                                >
                                  <span class="massage-zones__service-title">
                                    {getMassageFullName(massage)}
                                  </span>

                                  {massage.labels?.length > 0 && (
                                    <span class="massage-zones__service-tags">
                                      {massage.labels.map((label) => (
                                        <span>{label}</span>
                                      ))}
                                    </span>
                                  )}
                                </Stack>
                              </span>

                              <span class="massage-zones__service-link">
                                <span>Zobacz więcej</span>

                                <Icon
                                  name="ic-arrow-right"
                                  class="icon-w-f"
                                  size="0.6rem"
                                />
                              </span>
                            </Link>
                          </li>
                        ))}
                      </ol>

                      <div class="massage-zones__consultation">
                        <div class="massage-zones__consultation-text">
                          <Icon name="ic-info" class="icon-w-f" size="1rem" />

                          <span>
                            Nie wiesz, który masaż wybrać? Umów konsultację z
                            naszym terapeutą.
                          </span>
                        </div>

                        <Link
                          href="/kontakt"
                          class="massage-zones__consultation-link link--underline"
                        >
                          <span>Umów konsultację</span>

                          <Icon
                            name="ic-arrow-right"
                            class="icon-w-f"
                            size="0.6rem"
                          />
                        </Link>
                      </div>
                    </div>
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </Stack>
  </Container>
</Section>

<script>
  const initMassageZones = () => {
    const widgets = document.querySelectorAll<HTMLElement>(
      "[data-massage-zones]",
    );

    widgets.forEach((widget) => {
      if (widget.dataset.initialized === "true") {
        return;
      }

      widget.dataset.initialized = "true";

      const content = widget.closest<HTMLElement>(".massage-zones__content");

      const tabsWidget =
        content?.querySelector<HTMLElement>("[data-zone-tabs] [data-tabs]") ??
        null;

      const tabButtons = tabsWidget
        ? Array.from(
            tabsWidget.querySelectorAll<HTMLButtonElement>("[data-tab]"),
          )
        : [];

      const zones = Array.from(
        widget.querySelectorAll<HTMLElement>("[data-zone]"),
      );

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      const desktopSwap = window.matchMedia("(min-width: 769px)");

      const customCursor =
        widget.querySelector<HTMLElement>("[data-zone-cursor]");

      let isSwitching = false;

      const swapDuration = 950;
      const swapEasing = "cubic-bezier(0.16, 1, 0.3, 1)";

      const showCursor = () => {
        if (isSwitching || !desktopSwap.matches) {
          return;
        }

        customCursor?.classList.add("is-visible");
      };

      const hideCursor = () => {
        customCursor?.classList.remove("is-visible");
      };

      const moveCursor = (event: MouseEvent) => {
        if (!customCursor) {
          return;
        }

        customCursor.style.left = `${event.clientX}px`;

        customCursor.style.top = `${event.clientY}px`;
      };

      const getZoneById = (id: string) => {
        return zones.find((zone) => zone.dataset.zoneId === id);
      };

      const updateZoneTabs = (activeZone: HTMLElement) => {
        const activeId = activeZone.dataset.zoneId;

        if (!activeId) {
          return;
        }

        tabButtons.forEach((tab) => {
          const isActive = tab.dataset.tabId === activeId;

          tab.classList.toggle("is-active", isActive);
          tab.classList.toggle("is-current-zone", isActive);
          tab.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
      };

      const updateAria = (activeZone: HTMLElement) => {
        zones.forEach((zone) => {
          const trigger = zone.querySelector<HTMLButtonElement>(
            "[data-zone-trigger]",
          );

          trigger?.setAttribute(
            "aria-expanded",
            zone === activeZone ? "true" : "false",
          );
        });

        updateZoneTabs(activeZone);
      };

      const interpolate = (start: number, end: number, progress: number) => {
        return start + (end - start) * progress;
      };

      const getFlipData = (firstRect: DOMRect, lastRect: DOMRect) => {
        const deltaX = firstRect.left - lastRect.left;

        const deltaY = firstRect.top - lastRect.top;

        const scaleX =
          lastRect.width > 0 ? firstRect.width / lastRect.width : 1;

        const scaleY =
          lastRect.height > 0 ? firstRect.height / lastRect.height : 1;

        return {
          deltaX,
          deltaY,
          scaleX,
          scaleY,
        };
      };

      const animateOutgoingZone = (
        zone: HTMLElement,
        firstRect: DOMRect,
        lastRect: DOMRect,
      ) => {
        const { deltaX, deltaY, scaleX, scaleY } = getFlipData(
          firstRect,
          lastRect,
        );

        const nearEndProgress = 0.82;

        const nearEndX = deltaX * (1 - nearEndProgress);

        const nearEndY = deltaY * (1 - nearEndProgress);

        const nearEndScaleX = interpolate(scaleX, 1, nearEndProgress);

        const nearEndScaleY = interpolate(scaleY, 1, nearEndProgress);

        return zone.animate(
          [
            {
              offset: 0,
              transform: `translate3d(${deltaX}px, ${deltaY}px, 0) scale(${scaleX}, ${scaleY})`,
              opacity: 1,
            },
            {
              offset: 0.76,
              transform: `translate3d(${nearEndX}px, ${nearEndY}px, 0) scale(${nearEndScaleX}, ${nearEndScaleY})`,
              opacity: 1,
            },
            {
              offset: 1,
              transform: "translate3d(0, 0, 0) scale(1, 1)",
              opacity: 1,
            },
          ],
          {
            duration: swapDuration,
            easing: swapEasing,
            fill: "both",
          },
        );
      };

      const animateIncomingZone = (
        zone: HTMLElement,
        firstRect: DOMRect,
        lastRect: DOMRect,
      ) => {
        const { deltaX, deltaY, scaleX, scaleY } = getFlipData(
          firstRect,
          lastRect,
        );

        const underOffsetY = Math.min(
          36,
          Math.max(16, window.innerHeight * 0.022),
        );

        const startY = deltaY + underOffsetY;

        const middleProgress = 0.58;

        const middleX = deltaX * (1 - middleProgress);

        const middleY = deltaY * (1 - middleProgress) + underOffsetY * 0.24;

        const middleScaleX = interpolate(scaleX, 1, middleProgress);

        const middleScaleY = interpolate(scaleY, 1, middleProgress);

        const nearEndProgress = 0.86;

        const nearEndX = deltaX * (1 - nearEndProgress);

        const nearEndY = deltaY * (1 - nearEndProgress);

        const nearEndScaleX = interpolate(scaleX, 1, nearEndProgress);

        const nearEndScaleY = interpolate(scaleY, 1, nearEndProgress);

        return zone.animate(
          [
            {
              offset: 0,
              transform: `translate3d(${deltaX}px, ${startY}px, 0) scale(${scaleX}, ${scaleY})`,
              opacity: 0.68,
            },
            {
              offset: 0.55,
              transform: `translate3d(${middleX}px, ${middleY}px, 0) scale(${middleScaleX}, ${middleScaleY})`,
              opacity: 0.82,
            },
            {
              offset: 0.82,
              transform: `translate3d(${nearEndX}px, ${nearEndY}px, 0) scale(${nearEndScaleX}, ${nearEndScaleY})`,
              opacity: 0.96,
            },
            {
              offset: 1,
              transform: "translate3d(0, 0, 0) scale(1, 1)",
              opacity: 1,
            },
          ],
          {
            duration: swapDuration,
            easing: swapEasing,
            fill: "both",
          },
        );
      };

      const finishSwapClasses = (
        currentZone: HTMLElement,
        nextZone: HTMLElement,
      ) => {
        currentZone.classList.remove("is-zone-leaving");

        nextZone.classList.remove("is-zone-entering");

        widget.classList.remove("is-zone-switching");

        isSwitching = false;
      };

      const switchZoneImmediately = (
        currentZone: HTMLElement,
        nextZone: HTMLElement,
        targetSlot: string,
      ) => {
        currentZone.dataset.zoneSlot = targetSlot;

        nextZone.dataset.zoneSlot = "0";

        currentZone.classList.remove("is-active");

        nextZone.classList.add("is-active");

        updateAria(nextZone);
      };

      const switchZone = async (nextZone: HTMLElement) => {
        const currentZone = widget.querySelector<HTMLElement>(
          "[data-zone].is-active",
        );

        if (!currentZone || currentZone === nextZone || isSwitching) {
          return;
        }

        const targetSlot = nextZone.dataset.zoneSlot;

        if (!targetSlot || targetSlot === "0") {
          return;
        }

        isSwitching = true;

        hideCursor();

        /*
         * Tablet/mobile:
         * bez desktopowego FLIP.
         */
        if (!desktopSwap.matches || reducedMotion.matches) {
          switchZoneImmediately(currentZone, nextZone, targetSlot);

          isSwitching = false;

          return;
        }

        widget.classList.add("is-zone-switching");

        /*
         * FIRST.
         */
        const currentFirstRect = currentZone.getBoundingClientRect();

        const nextFirstRect = nextZone.getBoundingClientRect();

        /*
         * Zamiana tylko dwóch slotów.
         */
        currentZone.dataset.zoneSlot = targetSlot;

        nextZone.dataset.zoneSlot = "0";

        currentZone.classList.remove("is-active");

        nextZone.classList.add("is-active");

        currentZone.classList.add("is-zone-leaving");

        nextZone.classList.add("is-zone-entering");

        updateAria(nextZone);

        /*
         * Force layout po zmianie reprezentacji.
         */
        void widget.offsetHeight;

        /*
         * LAST.
         */
        const currentLastRect = currentZone.getBoundingClientRect();

        const nextLastRect = nextZone.getBoundingClientRect();

        const currentAnimation = animateOutgoingZone(
          currentZone,
          currentFirstRect,
          currentLastRect,
        );

        const nextAnimation = animateIncomingZone(
          nextZone,
          nextFirstRect,
          nextLastRect,
        );

        try {
          await Promise.all([
            currentAnimation.finished,
            nextAnimation.finished,
          ]);
        } catch {
          // Animacja mogła zostać anulowana.
        }

        finishSwapClasses(currentZone, nextZone);
      };

      const getNextZone = (currentZone: HTMLElement) => {
        const currentIndex = zones.indexOf(currentZone);

        if (currentIndex === -1) {
          return null;
        }

        const nextIndex = (currentIndex + 1) % zones.length;

        return zones[nextIndex] ?? null;
      };

      zones.forEach((zone) => {
        const trigger = zone.querySelector<HTMLButtonElement>(
          "[data-zone-trigger]",
        );

        if (trigger) {
          trigger.addEventListener("click", () => {
            hideCursor();

            void switchZone(zone);
          });

          trigger.addEventListener("mouseenter", () => {
            if (!zone.classList.contains("is-active")) {
              showCursor();
            }
          });

          trigger.addEventListener("mouseleave", hideCursor);

          trigger.addEventListener("mousemove", (event) => {
            if (!zone.classList.contains("is-active")) {
              showCursor();

              moveCursor(event);
            }
          });

          trigger.addEventListener("focus", hideCursor);
        }

        const nextButton =
          zone.querySelector<HTMLButtonElement>("[data-zone-next]");

        nextButton?.addEventListener("click", () => {
          const nextZone = getNextZone(zone);

          if (!nextZone) {
            return;
          }

          hideCursor();

          void switchZone(nextZone);
        });
      });

      tabsWidget?.addEventListener("tabs:change", (event: Event) => {
        const customEvent = event as CustomEvent<{
          id: string;
        }>;

        const id = customEvent.detail?.id;

        if (!id) {
          return;
        }

        const nextZone = getZoneById(id);

        if (!nextZone) {
          return;
        }

        void switchZone(nextZone);
      });

      widget.addEventListener("wheel", hideCursor, {
        passive: true,
      });

      widget.addEventListener("mouseleave", hideCursor);

      const initialActiveZone = widget.querySelector<HTMLElement>(
        "[data-zone].is-active",
      );

      if (initialActiveZone) {
        updateAria(initialActiveZone);
      }

      document.addEventListener(
        "astro:before-swap",
        () => {
          isSwitching = true;

          hideCursor();
        },
        {
          once: true,
        },
      );
    });
  };

  initMassageZones();

  document.addEventListener("astro:page-load", initMassageZones);
</script>
