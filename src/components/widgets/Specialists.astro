---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";

import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import Link from "@/components/ui/Link.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Radio from "@/components/form/Radio.astro";

import {
  getSpecialistBookingPath,
  specialists,
} from "@/data/specialists";

export interface Props {
  id?: string;
  mode?: "display" | "select";
  selectedSpecialistId?: string | null;
  heading?: string;
  description?: string;
  class?: string;
}

const {
  mode = "display",
  selectedSpecialistId,
  heading = "Poznaj specjalistów ORHEA",
  description = "Adrian i Aleksandra tworzą zespół ORHEA. Każda sesja rozpoczyna się od rozmowy i dopasowania pracy do aktualnych potrzeb.",
  class: className,
  ...restProps
} = Astro.props;
---

<Section
  spacing="lg"
  tone="inverse"
  {...restProps}
  class:list={["specialists", `specialists--${mode}`, className]}
>
  <Container>
    <Stack space="2xl">
      <SectionHeading
        heading={heading}
        description={description}
      />

      <div class="specialists__grid">
        {
          specialists.map((specialist) => (
            <article
              class:list={[
                "specialists__card",
                mode === "select" && selectedSpecialistId === specialist.id && "is-selected",
              ]}
              data-booking-specialist-card={mode === "select" ? "" : undefined}
              data-specialist-id={mode === "select" ? specialist.id : undefined}
              data-specialist-name={mode === "select" ? specialist.name : undefined}
            >
              <div class="specialists__media">
                <Img
                  src={specialist.image}
                  alt={specialist.imageAlt}
                  class="specialists__image"
                  widths={[360, 520, 720]}
                  sizes="(max-width: 768px) 100vw, 38vw"
                />
              </div>

              <Stack as="div" space="md" class="specialists__content">
                <h3>{specialist.name}</h3>

                <Icon name="ic-lines" class="icon-w-f vip-ritual__icon" />


                <ul class="specialists__facts">
                  {specialist.qualifications.map((qualification) => (
                    <li>
                      <Icon name="ic-branch" size="0.75rem" class="icon-w-f" />
                      <span>{qualification}</span>
                    </li>
                  ))}
                  <li>
                    <Icon name="ic-branch" size="0.75rem" class="icon-w-f" />
                    <span>{specialist.experience}</span>
                  </li>
                </ul>

                <p>{specialist.description}</p>

                {mode === "display" ? (
                  <Link
                    href={getSpecialistBookingPath(specialist.id)}
                    class="button button--primary specialists__booking"
                  >
                    <span class="button__label">
                      <span class="button__label-front">Umów</span>
                      <span class="button__label-back" aria-hidden="true">
                        Umów
                      </span>
                    </span>
                    <Icon name="ic-calendar" size="1rem" class="icon-w-f" />
                  </Link>
                ) : (
                  <Radio
                    id={`booking-specialist-${specialist.id}`}
                    name="specialistId"
                    value={specialist.id}
                    checked={selectedSpecialistId === specialist.id}
                    class="specialists__choice"
                  >
                    Wybieram: {specialist.name}
                  </Radio>
                )}
              </Stack>
            </article>
          ))
        }

        {mode === "select" && (
          <article
            class:list={[
              "specialists__card",
              "specialists__card--no-preference",
              selectedSpecialistId === null && "is-selected",
            ]}
            data-booking-specialist-card
            data-specialist-id=""
            data-specialist-name="Bez preferencji"
          >
            <Stack space="md" class="specialists__content">
              <h3>Najbliższy dostępny specjalista</h3>
              <p>ORHEA zaproponuje najbliższy dostępny termin u Adriana lub Aleksandry.</p>
              <Radio
                id="booking-specialist-no-preference"
                name="specialistId"
                value=""
                checked={selectedSpecialistId === null}
                class="specialists__choice"
              >
                Bez preferencji
              </Radio>
            </Stack>
          </article>
        )}
      </div>
    </Stack>
  </Container>
</Section>
