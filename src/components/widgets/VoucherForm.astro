---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Sidebar from "@/components/layouts/Sidebar.astro";
import Stack from "@/components/layouts/Stack.astro";
import Grid from "@/components/layouts/Grid.astro";
import Cluster from "@/components/layouts/Cluster.astro";
import FormGroup from "@/components/form/FormGroup.astro";
import FormField from "@/components/form/FormField.astro";
import Label from "@/components/form/Label.astro";
import FieldHint from "@/components/form/FieldHint.astro";
import FieldError from "@/components/form/FieldError.astro";
import Input from "@/components/form/Input.astro";
import Textarea from "@/components/form/Textarea.astro";
import Checkbox from "@/components/form/Checkbox.astro";
import Radio from "@/components/form/Radio.astro";
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import VoucherSummary from "@/components/widgets/VoucherSummary.astro";
import VoucherPreview from "@/components/widgets/VoucherPreview.astro";
import { voucherCheckoutConfig } from "@/data/vouchers";

export interface Props {
  checkoutEndpoint?: string;
  class?: string;
}

const {
  checkoutEndpoint = "/api/vouchers/checkout",
  class: className,
  ...restProps
} = Astro.props;
---

<Section {...restProps} id="personalizacja-vouchera" class:list={["voucher-form-section", className]}>
  <Container>
    <form
      id="voucher-form"
      class="voucher-form"
      data-voucher-form
      data-checkout-endpoint={checkoutEndpoint}
      data-paper-surcharge={voucherCheckoutConfig.paperVoucherSurchargePLN}
      novalidate
    >
      <input type="hidden" name="productKind" value="massage" />
      <input type="hidden" name="massageId" value="" data-voucher-massage-id />
      <input type="hidden" name="variantCode" value="" data-voucher-variant-code />

      <Sidebar side="right" width="23rem" gap="xl" class="voucher-form__layout">
        <div class="voucher-form__fields">
          <section
            class="voucher-form__step"
            aria-labelledby="voucher-selection-title"
            data-reveal="up"
          >
            <span class="voucher-form__step-marker" aria-hidden="true">A</span>
            <Stack space="md">
              <h2 id="voucher-selection-title">Wybrany voucher</h2>
              <div class="voucher-form__selection" data-form-selection>
                <p data-form-selection-empty>Nie wybrano jeszcze masażu.</p>
                <div data-form-selection-content hidden>
                  <strong data-form-selection-name></strong>
                  <span data-form-selection-duration></span>
                  <span data-form-selection-price></span>
                </div>
                <Button type="button" variant="ghost" size="sm" data-change-voucher>
                  Zmień voucher
                </Button>
              </div>
              <FieldError id="voucher-selection-error" data-voucher-selection-error />
            </Stack>
          </section>

          <section
            class="voucher-form__step"
            aria-labelledby="voucher-addons-title"
            data-voucher-addons-section
            hidden
          >
            <span class="voucher-form__step-marker" aria-hidden="true">+</span>
            <Stack space="md">
              <div>
                <h2 id="voucher-addons-title">Dodatki do vouchera</h2>
                <p>Wybierz opcjonalne dodatki do wybranego masażu.</p>
              </div>
              <p data-voucher-addons-status role="status" aria-live="polite"></p>
              <div class="voucher-addons-list" data-voucher-addons-list></div>
            </Stack>
          </section>

          <section
            class="voucher-form__step"
            aria-labelledby="buyer-data-title"
            data-reveal="up"
            style="--reveal-delay: 60ms;"
          >
            <span class="voucher-form__step-marker" aria-hidden="true">B</span>
            <FormGroup gap="lg">
              <h2 id="buyer-data-title">Twoje dane</h2>
              <Grid columns="2" gap="md" class="voucher-form__grid">
                <FormField>
                  <Label for="voucher-first-name" required>Imię</Label>
                  <Input id="voucher-first-name" name="firstName" type="text" autocomplete="given-name" minlength={2} maxlength={100} required describedby="voucher-first-name-error" />
                  <FieldError id="voucher-first-name-error" data-error-for="firstName" />
                </FormField>
                <FormField>
                  <Label for="voucher-last-name" required>Nazwisko</Label>
                  <Input id="voucher-last-name" name="lastName" type="text" autocomplete="family-name" minlength={2} maxlength={100} required describedby="voucher-last-name-error" />
                  <FieldError id="voucher-last-name-error" data-error-for="lastName" />
                </FormField>
                <FormField>
                  <Label for="voucher-email" required>E-mail</Label>
                  <Input id="voucher-email" name="email" type="email" autocomplete="email" maxlength={254} required describedby="voucher-email-hint voucher-email-error" />
                  <FieldHint id="voucher-email-hint">Na ten adres wyślemy voucher PDF po potwierdzeniu płatności.</FieldHint>
                  <FieldError id="voucher-email-error" data-error-for="email" />
                </FormField>
              </Grid>
            </FormGroup>
          </section>

          <section
            class="voucher-form__step"
            aria-labelledby="recipient-title"
            data-reveal="up"
            style="--reveal-delay: 120ms;"
          >
            <span class="voucher-form__step-marker" aria-hidden="true">C</span>
            <Stack space="lg">
              <h2 id="recipient-title">Dla kogo przygotować voucher?</h2>
              <fieldset class="voucher-form__fieldset">
                <legend class="sr-only">Odbiorca vouchera</legend>
                <Cluster gap="lg" class="voucher-form__radio-group">
                  <Radio id="voucher-recipient-self" name="recipientType" value="self" checked required>Dla mnie</Radio>
                  <Radio id="voucher-recipient-gift" name="recipientType" value="gift" required>Dla kogoś bliskiego</Radio>
                </Cluster>
              </fieldset>

              <div data-recipient-fields hidden>
                <Grid columns="2" gap="md" class="voucher-form__grid">
                  <FormField>
                    <Label for="voucher-recipient-first-name">Imię osoby obdarowanej</Label>
                    <Input id="voucher-recipient-first-name" name="recipientFirstName" type="text" autocomplete="off" minlength={2} maxlength={100} disabled describedby="voucher-recipient-first-name-error" />
                    <FieldError id="voucher-recipient-first-name-error" data-error-for="recipientFirstName" />
                  </FormField>
                  <FormField>
                    <Label for="voucher-recipient-last-name">Nazwisko osoby obdarowanej</Label>
                    <Input id="voucher-recipient-last-name" name="recipientLastName" type="text" autocomplete="off" maxlength={100} disabled />
                  </FormField>
                </Grid>
                <FormField class="voucher-form__wishes">
                  <Label for="voucher-wishes">Życzenia</Label>
                  <Textarea id="voucher-wishes" name="wishes" rows={5} maxlength={300} disabled placeholder="Dodaj krótkie życzenia do zamówienia." describedby="voucher-wishes-counter" />
                  <p id="voucher-wishes-counter" class="voucher-form__counter" data-wishes-counter>0 / 300</p>
                </FormField>
              </div>
            </Stack>
          </section>

          <section
            class="voucher-form__step"
            aria-labelledby="delivery-title"
            data-reveal="up"
            style="--reveal-delay: 180ms;"
          >
            <span class="voucher-form__step-marker" aria-hidden="true">D</span>
            <Stack space="lg">
              <h2 id="delivery-title">Jak chcesz otrzymać voucher?</h2>
              <fieldset class="voucher-form__fieldset">
                <legend class="sr-only">Sposób dostarczenia vouchera</legend>
                <Stack space="md">
                  <Radio id="voucher-delivery-electronic" name="deliveryType" value="electronic" checked required>
                    Voucher elektroniczny
                  </Radio>
                  <div data-voucher-paper-delivery>
                    <Radio id="voucher-delivery-paper" name="deliveryType" value="paper">
                      Voucher papierowy
                    </Radio>
                  </div>
                </Stack>
              </fieldset>
            </Stack>
          </section>

          <section class="voucher-form__step" data-shipping-fields hidden aria-labelledby="shipping-title">
            <span class="voucher-form__step-marker" aria-hidden="true">E</span>
            <Stack space="lg">
              <h2 id="shipping-title">Adres wysyłki</h2>
              <Grid columns="2" gap="md" class="voucher-form__grid">
                <FormField>
                  <Label for="shipping-street" required>Ulica</Label>
                  <Input id="shipping-street" name="shippingStreet" type="text" autocomplete="shipping address-line1" maxlength={150} required disabled describedby="shipping-street-error" />
                  <FieldError id="shipping-street-error" data-error-for="shippingStreet" />
                </FormField>
                <FormField>
                  <Label for="shipping-building" required>Numer budynku</Label>
                  <Input id="shipping-building" name="shippingBuilding" type="text" autocomplete="shipping address-line2" maxlength={20} required disabled describedby="shipping-building-error" />
                  <FieldError id="shipping-building-error" data-error-for="shippingBuilding" />
                </FormField>
                <FormField>
                  <Label for="shipping-apartment">Numer mieszkania</Label>
                  <Input id="shipping-apartment" name="shippingApartment" type="text" autocomplete="shipping address-line3" maxlength={20} disabled />
                </FormField>
                <FormField>
                  <Label for="shipping-postal-code" required>Kod pocztowy</Label>
                  <Input id="shipping-postal-code" name="shippingPostalCode" type="text" autocomplete="shipping postal-code" inputmode="numeric" maxlength={6} pattern="[0-9]{2}-[0-9]{3}" placeholder="00-000" required disabled describedby="shipping-postal-code-error" />
                  <FieldError id="shipping-postal-code-error" data-error-for="shippingPostalCode" />
                </FormField>
                <FormField>
                  <Label for="shipping-city" required>Miasto</Label>
                  <Input id="shipping-city" name="shippingCity" type="text" autocomplete="shipping address-level2" maxlength={100} required disabled describedby="shipping-city-error" />
                  <FieldError id="shipping-city-error" data-error-for="shippingCity" />
                </FormField>
              </Grid>
            </Stack>
          </section>
        </div>

        <div class="voucher-form__summary-column">
          <VoucherPreview />

          <VoucherSummary>
            <FormField class="voucher-form__consent">
              <Checkbox id="voucher-consent" name="termsAccepted" value="true" required describedby="voucher-consent-error">
                Zapoznałam/em się z <Link href="/regulamin" class="link--underline">Regulaminem</Link> i <Link href="/polityka-prywatnosci" class="link--underline">Polityką prywatności</Link>.
              </Checkbox>
              <FieldError id="voucher-consent-error" data-error-for="termsAccepted" />
            </FormField>
          </VoucherSummary>

          <p class="voucher-form__status" data-voucher-status role="status" aria-live="polite" tabindex="-1"></p>
        </div>
      </Sidebar>
    </form>
  </Container>
</Section>

<script>
  import { scrollToSection } from "@/lib/client/scrollToSection";

  type VoucherVariantView = {
    variantCode: string;
    duration: string;
    pricePLN: number;
  };

  type MassageSelection = {
    kind: "massage";
    massageId: string;
    variantCode: string;
    name: string;
    duration: string;
    pricePLN: number;
    isVip: boolean;
  };

  type VoucherAddonView = {
    id: string;
    name: string;
    description: string | null;
    priceGrosze: number;
    conflictingAddonIds: string[];
  };

  type VoucherCheckoutResponse = {
    success?: boolean;
    checkoutUrl?: string;
    voucherOrderId?: string;
    message?: string;
  };

  const voucherFormCleanups = new WeakMap<HTMLElement, () => void>();

  const teardownVoucherForm = (root: HTMLElement) => {
    voucherFormCleanups.get(root)?.();
  };

  const resetVoucherFormAfterHistoryRestore = (root: HTMLElement) => {
    const form = root.querySelector<HTMLFormElement>("[data-voucher-form]");
    form?.reset();

    root.querySelectorAll<HTMLElement>("[data-voucher-massage-card]").forEach((card) => {
      card.classList.remove("is-selected");
      card.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
        input.checked = false;
      });
      card.querySelector<HTMLElement>("[data-voucher-card-error]")?.replaceChildren();
    });

    const massageInput = root.querySelector<HTMLInputElement>("[data-voucher-massage-id]");
    const variantInput = root.querySelector<HTMLInputElement>("[data-voucher-variant-code]");
    const addonsList = root.querySelector<HTMLElement>("[data-voucher-addons-list]");
    if (massageInput) massageInput.value = "";
    if (variantInput) variantInput.value = "";
    addonsList?.replaceChildren();
    if (addonsList) {
      delete addonsList.dataset.loading;
      delete addonsList.dataset.error;
    }
    root.querySelector<HTMLElement>("[data-voucher-addons-section]")?.setAttribute("hidden", "");
    root.querySelector<HTMLElement>("[data-voucher-addons-status]")?.replaceChildren();
    root.querySelector<HTMLElement>("[data-voucher-selection-error]")?.replaceChildren();
    root.querySelector<HTMLElement>("[data-voucher-status]")?.replaceChildren();
    root.querySelector<HTMLElement>("[data-voucher-preview]")?.classList.remove("is-open");
    root.querySelector<HTMLButtonElement>("[data-voucher-preview-toggle]")?.setAttribute(
      "aria-expanded",
      "false",
    );
  };

  const initVoucherForms = () => {
    document.querySelectorAll<HTMLElement>("[data-voucher-flow]").forEach((root) => {
      const form = root.querySelector<HTMLFormElement>("[data-voucher-form]");
      if (!form) return;
      if (root.dataset.voucherInitialized === "true") {
        // A persisted DOM can theoretically retain the marker after an
        // interrupted navigation. Only a live instance may keep it.
        if (voucherFormCleanups.has(root)) return;
        delete root.dataset.voucherInitialized;
      }

      root.dataset.voucherInitialized = "true";

      const controller = new AbortController();
      const paperSurcharge = Number(form.dataset.paperSurcharge ?? 0);
      const money = new Intl.NumberFormat("pl-PL", { style: "currency", currency: "PLN", maximumFractionDigits: 0 });
      let selection: MassageSelection | null = null;
      let availableAddons: VoucherAddonView[] = [];
      let addonsController: AbortController | null = null;
      let addonsRequestSequence = 0;
      let submitting = false;
      let disposed = false;

      const query = <T extends Element>(selector: string) => root.querySelector<T>(selector);
      const setText = (selector: string, value: string) => {
        const node = query<HTMLElement>(selector);
        if (node) node.textContent = value;
      };
      const setPreviewText = (field: string, value: string) => {
        root.querySelectorAll<HTMLElement>(`[data-preview-field="${field}"]`).forEach((node) => {
          node.textContent = value;
        });
      };
      const setPreviewFieldVisibility = (field: string, visible: boolean) => {
        root.querySelectorAll<HTMLElement>(`[data-preview-field="${field}"]`).forEach((node) => {
          node.hidden = !visible;
        });
      };
      const setConditionalFields = (container: HTMLElement | null, visible: boolean) => {
        if (!container) return;
        container.hidden = !visible;
        container.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select").forEach((field) => {
          field.disabled = !visible;
        });
      };
      const getDeliveryType = () => {
        return form.querySelector<HTMLInputElement>('[name="deliveryType"]:checked')?.value ?? "electronic";
      };
      const selectedAddonIds = () =>
        Array.from(
          query<HTMLElement>("[data-voucher-addons-list]")?.querySelectorAll<HTMLInputElement>("input[name='addonIds']:checked") ?? [],
        ).map((input) => input.value);
      const selectedAddons = () => {
        const ids = new Set(selectedAddonIds());
        return availableAddons.filter((addon) => ids.has(addon.id));
      };
      const setPaperPreviewSide = (side: "front" | "back") => {
        root.querySelectorAll<HTMLButtonElement>("[data-preview-paper-tab]").forEach((tab) => {
          const active = tab.dataset.previewPaperTab === side;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
        });
        root.querySelectorAll<HTMLElement>("[data-preview-paper-panel]").forEach((panel) => {
          panel.hidden = panel.dataset.previewPaperPanel !== side;
        });
      };
      const updatePreview = () => {
        const preview = query<HTMLElement>("[data-voucher-preview]");
        if (!preview) return;

        const isPaper = getDeliveryType() === "paper";
        const isVip = selection?.isVip ?? false;
        const recipientType = form.querySelector<HTMLInputElement>('[name="recipientType"]:checked')?.value ?? "self";
        const firstName = form.querySelector<HTMLInputElement>('[name="firstName"]')?.value.trim() ?? "";
        const lastName = form.querySelector<HTMLInputElement>('[name="lastName"]')?.value.trim() ?? "";
        const giftFirstName = form.querySelector<HTMLInputElement>('[name="recipientFirstName"]')?.value.trim() ?? "";
        const giftLastName = form.querySelector<HTMLInputElement>('[name="recipientLastName"]')?.value.trim() ?? "";
        const wishes = form.querySelector<HTMLTextAreaElement>('[name="wishes"]')?.value.trim() ?? "";
        const recipientName = recipientType === "gift"
          ? [giftFirstName, giftLastName].filter(Boolean).join(" ") || "Dla bliskiej osoby"
          : [firstName, lastName].filter(Boolean).join(" ") || "Dla Ciebie";
        const service = selection
          ? `${selection.name}${selection.duration ? ` · ${selection.duration}` : ""}`
          : "Wybierz masaż";
        const addons = selectedAddons().map((addon) => addon.name).join(" · ");

        preview.dataset.mode = isPaper ? "paper" : "electronic";
        preview.dataset.tone = isVip ? "dark" : "light";
        root.querySelectorAll<HTMLImageElement>("[data-preview-template]").forEach((template) => {
          template.src = isVip ? "/vouchers/voucher-dark.png" : "/vouchers/voucher-light.png";
        });
        query<HTMLElement>("[data-preview-electronic]")?.toggleAttribute("hidden", isPaper);
        query<HTMLElement>("[data-preview-paper]")?.toggleAttribute("hidden", !isPaper);
        setText(
          "[data-preview-mode-hint]",
          isPaper
            ? "Poglądowy układ vouchera papierowego — finalna grafika druku zostanie dodana po dostarczeniu assetów."
            : "Wersja elektroniczna — finalny kod QR pojawi się po opłaceniu.",
        );
        setPreviewText("code", "Kod zostanie nadany po płatności");
        setPreviewText("recipient", recipientName);
        setPreviewText("service", service);
        setPreviewText("addons", addons);
        setPreviewFieldVisibility("addons", Boolean(addons));
        setPreviewText("wishes", wishes);
        setPreviewFieldVisibility("wishes", Boolean(wishes));
        setPreviewText("expiry", "Ważność zostanie podana po zakupie");
      };
      const renderAddons = () => {
        const section = query<HTMLElement>("[data-voucher-addons-section]");
        const list = query<HTMLElement>("[data-voucher-addons-list]");
        if (!section || !list) return;
        const chosen = new Set(selectedAddonIds());
        list.replaceChildren();
        section.hidden = availableAddons.length === 0 && list.dataset.loading !== "true" && list.dataset.error !== "true";
        for (const addon of availableAddons) {
          const label = document.createElement("label");
          label.className = "checkbox voucher-addon";
          const input = document.createElement("input");
          input.className = "checkbox__input";
          input.type = "checkbox";
          input.name = "addonIds";
          input.value = addon.id;
          input.checked = chosen.has(addon.id);
          const blockers = availableAddons.filter((candidate) =>
            chosen.has(candidate.id) && addon.conflictingAddonIds.includes(candidate.id),
          );
          input.disabled = !input.checked && blockers.length > 0;
          if (input.disabled) label.classList.add("checkbox--disabled");
          const control = document.createElement("span");
          control.className = "checkbox__control";
          control.setAttribute("aria-hidden", "true");
          const content = document.createElement("span");
          content.className = "checkbox__label voucher-addon__content";
          const name = document.createElement("strong");
          name.textContent = addon.name;
          const price = document.createElement("span");
          price.className = "voucher-addon__price";
          price.textContent = `+${money.format(addon.priceGrosze / 100)}`;
          content.append(name, price);
          if (addon.description) {
            const description = document.createElement("span");
            description.className = "voucher-addon__description";
            description.textContent = addon.description;
            content.append(description);
          }
          if (blockers.length > 0 && !input.checked) {
            const reason = document.createElement("span");
            reason.className = "voucher-addon__description";
            reason.textContent = `Nie można połączyć z: ${blockers.map((item) => item.name).join(", ")}`;
            content.append(reason);
          }
          label.append(input, control, content);
          list.append(label);
        }
      };
      const loadAddons = async (massageId: string) => {
        addonsController?.abort();
        availableAddons = [];
        const list = query<HTMLElement>("[data-voucher-addons-list]");
        if (list) {
          list.dataset.loading = "true";
          delete list.dataset.error;
        }
        renderAddons();
        const status = query<HTMLElement>("[data-voucher-addons-status]");
        if (status) status.textContent = "Pobieramy dodatki…";
        const controller = new AbortController();
        addonsController = controller;
        const requestId = ++addonsRequestSequence;
        try {
          const response = await fetch(`/api/vouchers/addons?${new URLSearchParams({ massageId })}`, {
            headers: { accept: "application/json" },
            signal: controller.signal,
          });
          const body = (await response.json()) as { success?: boolean; addons?: VoucherAddonView[] };
          if (controller.signal.aborted || requestId !== addonsRequestSequence) return;
          if (!response.ok || !body.success || !Array.isArray(body.addons)) throw new Error("VOUCHER_ADDONS_LOAD_FAILED");
          availableAddons = body.addons;
          if (list) delete list.dataset.loading;
          renderAddons();
          if (status) status.textContent = "";
        } catch {
          if (controller.signal.aborted || requestId !== addonsRequestSequence) return;
          availableAddons = [];
          if (list) {
            delete list.dataset.loading;
            list.dataset.error = "true";
          }
          renderAddons();
          if (status) status.textContent = "Nie udało się pobrać dodatków. Spróbuj wybrać masaż ponownie.";
        } finally {
          if (!disposed && requestId === addonsRequestSequence) {
            addonsController = null;
            updateSummary();
          }
        }
      };
      const updateSummary = () => {
        const content = query<HTMLElement>("[data-summary-content]");
        const placeholder = query<HTMLElement>("[data-summary-placeholder]");
        const submit = query<HTMLButtonElement>("[data-voucher-submit]");
        const formContent = query<HTMLElement>("[data-form-selection-content]");
        const formEmpty = query<HTMLElement>("[data-form-selection-empty]");

        if (!selection) {
          if (content) content.hidden = true;
          if (placeholder) placeholder.hidden = false;
          if (formContent) formContent.hidden = true;
          if (formEmpty) formEmpty.hidden = false;
          if (submit) submit.disabled = true;
          updatePreview();
          return;
        }

        const isPaper = getDeliveryType() === "paper";
        const deliveryLabel = isPaper ? "papierowa" : "elektroniczna";
        const surcharge = isPaper ? paperSurcharge : 0;
        const deliveryCost = 0;
        const addonsPricePLN = selectedAddons().reduce(
          (sum, addon) => sum + addon.priceGrosze / 100,
          0,
        );
        const total = selection.pricePLN + addonsPricePLN + surcharge + deliveryCost;

        if (content) content.hidden = false;
        if (placeholder) placeholder.hidden = true;
        if (formContent) formContent.hidden = false;
        if (formEmpty) formEmpty.hidden = true;
        if (submit) submit.disabled = submitting;

        setText("[data-summary-name]", selection.name);
        setText("[data-summary-duration]", selection.duration);
        setText("[data-summary-price]", money.format(selection.pricePLN));
        const addonsRow = query<HTMLElement>("[data-summary-addons-row]");
        if (addonsRow) addonsRow.hidden = addonsPricePLN === 0;
        setText("[data-summary-addons]", money.format(addonsPricePLN));
        setText("[data-summary-delivery]", deliveryLabel);
        setText("[data-summary-paper-surcharge]", surcharge ? money.format(surcharge) : "0 zł");
        setText("[data-summary-shipping]", deliveryCost ? money.format(deliveryCost) : "0 zł");
        setText("[data-summary-total]", money.format(total));
        setText("[data-form-selection-name]", selection.name);
        setText("[data-form-selection-duration]", selection.duration);
        setText("[data-form-selection-price]", money.format(selection.pricePLN));
        setText(
          "[data-summary-note]",
          isPaper
            ? "Voucher papierowy zostanie przygotowany po potwierdzeniu płatności. Wysyłka jest bezpłatna."
            : "Voucher elektroniczny zostanie wysłany jako PDF po potwierdzeniu płatności.",
        );
        updatePreview();
      };
      const clearFieldError = (field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement) => {
        field.removeAttribute("aria-invalid");
        const error = query<HTMLElement>(`[data-error-for="${field.name}"]`);
        if (error) error.textContent = "";
      };
      const getValidationMessage = (
        field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement,
      ) => {
        if (field.validity.valueMissing) return "Uzupełnij to pole.";
        if (
          field instanceof HTMLInputElement &&
          field.type === "email" &&
          field.validity.typeMismatch
        ) {
          return "Podaj poprawny adres e-mail.";
        }
        if (field.validity.tooShort) {
          return "Podaj co najmniej wymaganą liczbę znaków.";
        }

        return "Sprawdź poprawność tego pola.";
      };

      root.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const previewToggle = target.closest<HTMLButtonElement>("[data-voucher-preview-toggle]");
        if (previewToggle) {
          const preview = query<HTMLElement>("[data-voucher-preview]");
          if (!preview) return;
          const open = !preview.classList.contains("is-open");
          preview.classList.toggle("is-open", open);
          previewToggle.setAttribute("aria-expanded", String(open));
          return;
        }

        const paperTab = target.closest<HTMLButtonElement>("[data-preview-paper-tab]");
        if (paperTab) {
          const side = paperTab.dataset.previewPaperTab;
          if (side === "front" || side === "back") setPaperPreviewSide(side);
          return;
        }

        const selectButton = target.closest<HTMLButtonElement>("[data-select-voucher]");
        if (selectButton) {
          const card = selectButton.closest<HTMLElement>("[data-voucher-massage-card]");
          if (!card) return;

          let selectedVariant = card.querySelector<HTMLInputElement>('input[type="radio"]:checked');
          const variantRadios = Array.from(
            card.querySelectorAll<HTMLInputElement>('input[type="radio"]'),
          );

          if (!selectedVariant && variantRadios.length === 1) {
            variantRadios[0].checked = true;
            selectedVariant = variantRadios[0];
          }
          const cardError = card.querySelector<HTMLElement>("[data-voucher-card-error]");
          if (!selectedVariant) {
            if (cardError) cardError.textContent = "Wybierz wariant czasu i ceny.";
            card.querySelector<HTMLInputElement>('input[type="radio"]')?.focus();
            return;
          }

          const variants = JSON.parse(card.dataset.variants ?? "[]") as VoucherVariantView[];
          const variantCode = selectedVariant.value;
          const variant = variants.find((item) => item.variantCode === variantCode);
          const massageId = card.dataset.massageId;
          if (!variant || !massageId) return;

          const title = card.dataset.massageTitle ?? "Voucher ORHEA";
          const service = card.dataset.massageService;
          selection = {
            kind: "massage",
            massageId,
            variantCode,
            name: service ? `${title} — ${service}` : title,
            duration: variant.duration,
            pricePLN: variant.pricePLN,
            isVip: card.classList.contains("massage-card--vip"),
          };

          root.querySelectorAll<HTMLElement>("[data-voucher-massage-card]").forEach((item) => {
            if (item !== card) {
              const radios = item.querySelectorAll<HTMLInputElement>('input[type="radio"]');
              if (radios.length === 1) radios[0].checked = false;
            }
            item.classList.toggle("is-selected", item === card);
          });
          if (cardError) cardError.textContent = "";
          const massageInput = query<HTMLInputElement>("[data-voucher-massage-id]");
          const variantInput = query<HTMLInputElement>("[data-voucher-variant-code]");
          const selectionError = query<HTMLElement>("[data-voucher-selection-error]");
          if (massageInput) massageInput.value = massageId;
          if (variantInput) variantInput.value = variantCode;
          if (selectionError) selectionError.textContent = "";
          updateSummary();
          void loadAddons(massageId);

          scrollToSection(query<HTMLElement>("#personalizacja-vouchera"));
          return;
        }

        if (target.closest("[data-change-voucher]")) {
          scrollToSection(query<HTMLElement>("#wybor-vouchera"));
        }
      }, { signal: controller.signal });

      root.addEventListener("keydown", (event) => {
        const target = event.target;
        if (!(target instanceof HTMLButtonElement) || !target.matches("[data-preview-paper-tab]")) return;
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight" && event.key !== "Home" && event.key !== "End") return;
        const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-preview-paper-tab]"));
        const current = tabs.indexOf(target);
        if (current === -1) return;
        event.preventDefault();
        const next = event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : (current + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
        const tab = tabs[next];
        const side = tab.dataset.previewPaperTab;
        if (side === "front" || side === "back") setPaperPreviewSide(side);
        tab.focus();
      }, { signal: controller.signal });

      root.addEventListener("change", (event) => {
        const field = event.target;
        if (!(field instanceof HTMLInputElement)) return;

        if (field.name === "recipientType") {
          setConditionalFields(query<HTMLElement>("[data-recipient-fields]"), field.value === "gift");
        }

        if (field.name === "deliveryType") {
          setConditionalFields(query<HTMLElement>("[data-shipping-fields]"), field.value === "paper");
          updateSummary();
        }

        if (field.name === "addonIds") {
          renderAddons();
          updateSummary();
        }

        if (field.name.startsWith("voucher-variant-") && selection) {
          const card = field.closest<HTMLElement>("[data-voucher-massage-card]");
          if (card?.dataset.massageId === selection.massageId && card.classList.contains("is-selected")) {
            card.querySelector<HTMLButtonElement>("[data-select-voucher]")?.click();
          }
        }

        clearFieldError(field);
        updatePreview();
      }, { signal: controller.signal });

      form.addEventListener("invalid", (event) => {
        const field = event.target;
        if (!(field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement)) return;
        field.setAttribute("aria-invalid", "true");
        const error = query<HTMLElement>(`[data-error-for="${field.name}"]`);
        if (error) error.textContent = getValidationMessage(field);
      }, { capture: true, signal: controller.signal });

      form.addEventListener("input", (event) => {
        const field = event.target;
        if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
          clearFieldError(field);
        }

        if (field instanceof HTMLTextAreaElement && field.name === "wishes") {
          setText("[data-wishes-counter]", `${field.value.length} / ${field.maxLength}`);
        }
        updatePreview();
      }, { signal: controller.signal });

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (submitting) return;

        const status = query<HTMLElement>("[data-voucher-status]");
        const submit = query<HTMLButtonElement>("[data-voucher-submit]");

        if (!selection) {
          const error = query<HTMLElement>("[data-voucher-selection-error]");
          if (error) error.textContent = "Wybierz masaż i konkretny wariant vouchera.";
          query<HTMLElement>("#wybor-vouchera")?.scrollIntoView({ behavior: "auto", block: "start" });
          return;
        }

        if (!form.reportValidity()) {
          if (status) status.textContent = "Uzupełnij wymagane pola formularza.";
          return;
        }

        const endpoint = form.dataset.checkoutEndpoint;
        if (!endpoint) {
          if (status) {
            status.textContent = "Płatności online są chwilowo niedostępne.";
            status.dataset.state = "error";
            status.focus();
          }
          return;
        }

        const formData = new FormData(form);
        const getValue = (name: string) => String(formData.get(name) ?? "").trim();
        const buyerFirstName = getValue("firstName");
        const buyerLastName = getValue("lastName");
        const recipientType = getValue("recipientType");
        const recipientName = recipientType === "self"
          ? `${buyerFirstName} ${buyerLastName}`.trim()
          : [getValue("recipientFirstName"), getValue("recipientLastName")]
              .filter(Boolean)
              .join(" ");
        const message = getValue("wishes");
        const deliveryType = getDeliveryType() === "paper" ? "paper" : "electronic";
        const payload = {
          massageId: selection.massageId,
          variantCode: selection.variantCode,
          addonIds: selectedAddonIds(),
          buyer: {
            firstName: buyerFirstName,
            lastName: buyerLastName,
            email: getValue("email"),
          },
          recipient: {
            ...(recipientName ? { name: recipientName } : {}),
          },
          deliveryType,
          ...(deliveryType === "paper"
            ? {
                shippingAddress: {
                  street: getValue("shippingStreet"),
                  buildingNumber: getValue("shippingBuilding"),
                  apartmentNumber: getValue("shippingApartment") || undefined,
                  postalCode: getValue("shippingPostalCode"),
                  city: getValue("shippingCity"),
                },
              }
            : {}),
          ...(message ? { message } : {}),
        };

        submitting = true;
        form.setAttribute("aria-busy", "true");
        if (submit) submit.disabled = true;

        if (status) {
          status.textContent = "Przekierowujemy do bezpiecznej płatności…";
          status.dataset.state = "pending";
        }

        let checkoutCreated = false;

        try {
          const response = await fetch(endpoint, {
            method: "POST",
            headers: {
              accept: "application/json",
              "content-type": "application/json",
            },
            body: JSON.stringify(payload),
            signal: controller.signal,
          });

          let result: VoucherCheckoutResponse = {};

          try {
            result = (await response.json()) as VoucherCheckoutResponse;
          } catch {
            // The generic message below also covers an invalid upstream response.
          }

          if (!response.ok || !result.success || !result.checkoutUrl) {
            if (status) {
              status.textContent =
                (response.status === 400 || response.status === 503) && result.message
                  ? result.message
                  : "Nie udało się rozpocząć płatności. Spróbuj ponownie.";
              status.dataset.state = "error";
              status.focus();
            }
            return;
          }

          checkoutCreated = true;
          window.location.assign(result.checkoutUrl);
        } catch (error) {
          if (error instanceof DOMException && error.name === "AbortError") return;

          if (status) {
            status.textContent = "Nie udało się rozpocząć płatności. Sprawdź połączenie i spróbuj ponownie.";
            status.dataset.state = "error";
            status.focus();
          }
        } finally {
          if (!checkoutCreated) {
            submitting = false;
            form.removeAttribute("aria-busy");
            if (submit) submit.disabled = false;
          }
        }
      }, { signal: controller.signal });

      const cleanup = () => {
        if (disposed) return;
        disposed = true;
        addonsController?.abort();
        controller.abort();
        voucherFormCleanups.delete(root);
        delete root.dataset.voucherInitialized;
      };

      voucherFormCleanups.set(root, cleanup);

      document.addEventListener("astro:before-swap", cleanup, {
        once: true,
        signal: controller.signal,
      });
      window.addEventListener("pagehide", cleanup, {
        once: true,
        signal: controller.signal,
      });
      const initialRecipientType = form.querySelector<HTMLInputElement>('[name="recipientType"]:checked')?.value;
      setConditionalFields(query<HTMLElement>("[data-recipient-fields]"), initialRecipientType === "gift");
      setConditionalFields(query<HTMLElement>("[data-shipping-fields]"), getDeliveryType() === "paper");
      updateSummary();
    });
  };

  initVoucherForms();
  document.addEventListener("astro:page-load", initVoucherForms);
  window.addEventListener("pageshow", (event) => {
    if (!event.persisted) return;

    document.querySelectorAll<HTMLElement>("[data-voucher-flow]").forEach((root) => {
      teardownVoucherForm(root);
      resetVoucherFormAfterHistoryRestore(root);
    });
    initVoucherForms();
  });
</script>
