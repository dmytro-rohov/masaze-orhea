---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";

import SectionHeading from "@/components/ui/SectionHeading.astro";

import Tabs from "@/components/widgets/Tabs.astro";
import TabsPanel from "@/components/widgets/TabsPanel.astro";
import MassageCards from "@/components/widgets/MassageCards.astro";

import {
  massageZoneDefinitions,
  type MassageZoneId,
} from "@/data/massage-zones";

import { getVoucherMassages } from "@/server/catalog/massage-catalog.service";

export interface Props {
  initialZone?: Exclude<MassageZoneId, "vip">;
  class?: string;
}

const {
  initialZone = "ukojenie",
  class: className,
  ...restProps
} = Astro.props;

const voucherMassages = await getVoucherMassages();
const zoneOrder = massageZoneDefinitions.filter((zone) => zone.type === "standard").map((zone) => zone.id);

const voucherZones = zoneOrder.map((zoneId) => {
  const zone = massageZoneDefinitions.find(
    (item) => item.id === zoneId,
  );

  if (!zone) {
    throw new Error(
      `Voucher: brak konfiguracji strefy "${zoneId}".`,
    );
  }

  return {
    ...zone,
    massages: voucherMassages.filter(
      (massage) => massage.zoneId === zoneId,
    ),
  };
}).filter((zone) => zone.massages.length > 0);

const vipMassages = voucherMassages.filter(
  (massage) => massage.zoneId === "vip",
);


const activeZone = voucherZones.some((zone) => zone.id === initialZone)
  ? initialZone : voucherZones[0]?.id;
const tabs = voucherZones.map((zone) => ({
  id: zone.id,
  label: zone.name,
}));
---

<Section
  {...restProps}
  id="wybor-vouchera"
  class:list={[
    "voucher-selector",
    className,
  ]}
>
  <Container>
    <Stack space="2xl">
      <SectionHeading
        heading="Wybierz masaż, który chcesz podarować"
        description="Voucher będzie przypisany do wybranego masażu i konkretnego wariantu czasu."
        data-reveal="up"
      />

      <div class:list={["voucher-selector__layout", vipMassages.length === 0 && "has-no-vip"]} data-vip-selection-scope>
        {voucherZones.length > 0 && <div class="voucher-selector__main" data-vip-standard-offers>
          <Tabs
            items={tabs}
            initialActiveId={activeZone}
            ariaLabel="Strefy voucherów ORHEA"
            class="voucher-selector__tabs"
            transitionDuration={250}
          >
            {
              voucherZones.map((zone) => (
                <TabsPanel
                  id={zone.id}
                  active={zone.id === activeZone}
                  class="voucher-selector__panel"
                >
                  <MassageCards
                    dualScrollbar
                    massages={zone.massages}
                    mode="voucher-select"
                    actionLabel="Wybieram ten voucher"
                    class="voucher-selector__cards"
                  />
                </TabsPanel>
              ))
            }
          </Tabs>
        </div>}

        {voucherZones.length === 0 && vipMassages.length === 0 && (
          <p>Obecnie nie ma dostępnych voucherów na masaż.</p>
        )}

        {vipMassages.length > 0 && <aside
          class="voucher-selector__vip"
          aria-label="Voucher ORHEA VIP"
          data-vip-offer
        >
          <MassageCards
            massages={vipMassages}
            mode="voucher-select"
            actionLabel="Wybieram ORHEA VIP"
            class="voucher-selector__vip-card"
          />
        </aside>}
      </div>
    </Stack>
  </Container>
</Section>

<script>
  import { scrollToSection } from "@/lib/client/scrollToSection";

  const initVoucherSelectorScroll = () => {
    document.querySelectorAll<HTMLElement>(".voucher-selector__tabs").forEach((tabs) => {
      if (tabs.dataset.scrollInitialized === "true") return;
      tabs.dataset.scrollInitialized = "true";
      tabs.addEventListener("tabs:change", () => {
        scrollToSection(tabs.closest<HTMLElement>("#wybor-vouchera"));
      });
    });
  };

  initVoucherSelectorScroll();
  document.addEventListener("astro:page-load", initVoucherSelectorScroll);
</script>
