---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Cluster from "@/components/layouts/Cluster.astro";

import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";

import BgImage from "@assets/img/olive-with-fruits.png";
import Bgborder from "@assets/img/bg-border.png";

export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;

  primaryAction?: {
    label: string;
    href?: string;
  };

  secondaryAction?: {
    label: string;
    href: string;
  };

  image?: ImageMetadata | string;
  imageAlt?: string;

  align?: "left" | "center";
  tone?: "default" | "muted" | "inverse";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  primaryAction,
  secondaryAction,
  image,
  imageAlt = "",
  align = "left",
  tone = "default",
  class: className,
  ...restProps
} = Astro.props;

const hasImage = Boolean(image);
const hasActions = Boolean(primaryAction || secondaryAction);
---

<Section
  {...restProps}
  tone={tone}
  class:list={[
  "hero",
  hasImage && "hero--with-media",
  className,
  ]}
>
  <Container>
      <div class="hero__layout">
        <Stack class="hero__content" space="2xl">

          <Stack space="md">
            <h1 class="hero__title">{title}</h1>

            {description && (
              <p class="hero__description">
                {description}
              </p>
            )}
          </Stack>

          {hasActions && (
            <Cluster class="hero__actions" gap="md">
              {primaryAction && primaryAction.href ? (
                <a
                  class="button button--primary"
                  href={primaryAction.href}
                >
                  {primaryAction.label}
                <Icon name="ic-calendar" size="1.3rem" class="icon-w-f"/>
                </a>
              ) : primaryAction ? (
                <Button size="lg">
                  {primaryAction.label}
                </Button>
              ) : null}

              {secondaryAction && (
                <Link class="button button--secondary" href={secondaryAction.href}>
                  {secondaryAction.label}
                </Link>
              )}
            </Cluster>
          )}

          <Stack space="md">
            <Cluster gap="md" align="center">
              <Icon name="ic-leaf" size="1.5rem" class="icon-w-f" />
              <span>Indywidualne podejście</span>
            </Cluster>

            <Cluster gap="md" align="center">
              <Icon name="ic-lotus" size="1.7rem" class="icon-w-f"/>
              <span>Spokojna atmosfera</span>
            </Cluster>

            <Cluster gap="md" align="center">
              <Icon name="ic-location" size="1.5rem" class="icon-w-f"/>
              <span>Wrocław</span>
            </Cluster>
        </Stack>

        </Stack>

        <div class="hero__media">
          <Img
            src={image}
            alt={imageAlt}
            kind={imageAlt ? "content" : "decorative"}
            priority="high"
            class="hero__image image--shadow"
          />
          <Img
            src={Bgborder}
            alt=""
            kind="decorative"
            class="hero__border"
          />
        </div>
      </div>

      <Img
        src={BgImage}
        alt=""
        kind="decorative"
        class="image-decorative"
      />
  </Container>
</Section>