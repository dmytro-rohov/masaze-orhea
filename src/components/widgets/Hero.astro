---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Stack from "@/components/layouts/Stack.astro";
import Cluster from "@/components/layouts/Cluster.astro";

import Button from "@/components/ui/Button.astro";
import Link from "@/components/ui/Link.astro";
import Img from "@/components/media/Img.astro";
import Video from "@/components/media/Video.astro";
import Icon from "@/components/media/Icon.astro";

import HeroCallWidget from "@/components/widgets/HeroCallWidget.astro";

// assets
import BgImageLeft from "@assets/img/olive-with-fruits-left.png";
import HeroMaskInverse from "@assets/img/hero-mask-inverse.svg";
// import callBranchImage from "@/assets/img/call-branch.png";

type VideoSource = {
  src: string;
  type: "video/webm" | "video/mp4" | string;
};

type HeroFeature = {
  label: string;
  icon?: string;
  iconSize?: string;
};

export interface Props {
  eyebrowImage?: ImageMetadata;
  eyebrowImageAlt?: string;
  eyebrow?: string;

  title: string;
  description?: string;

  primaryAction?: {
    label: string;
    href?: string;
    icon?: string;
    iconSize?: string;
  };

  secondaryAction?: {
    label: string;
    href: string;
  };

  features?: HeroFeature[];

  image?: ImageMetadata | string;
  videoSources?: VideoSource[];

  align?: "left" | "center";
  tone?: "default" | "muted" | "inverse";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  primaryAction,
  secondaryAction,
  features = [],
  image,
  videoSources,
  align = "left",
  tone = "default",
  class: className,
  ...restProps
} = Astro.props;

const hasFeatures = features.length > 0;
const hasImage = Boolean(image);
const hasActions = Boolean(primaryAction || secondaryAction);
const poster = typeof image === "string" ? image : image?.src;
---

<Section
  {...restProps}
  tone={tone}
  style={`--hero-overlay-mask: url(${HeroMaskInverse.src});`}
  class:list={[
    "hero",
    hasImage && "hero--with-media",
    videoSources?.length && "hero--with-video",
    `hero--align-${align}`,
    className,
  ]}
>
  {
    videoSources?.length && (
      <div class="hero__background" aria-hidden="true">
        <Video
          sources={videoSources}
          poster={poster}
          autoplay
          muted
          loop
          playsinline
          controls={false}
          preload="metadata"
          class="video--cover hero__video--bg"
        />

        <div class="hero__background-overlay" />
      </div>
    )
  }

  {
    hasImage && !videoSources?.length && image && (
      <div class="hero__background" aria-hidden="true">
        <Img
          src={image}
          alt=""
          kind="decorative"
          class="hero__image--bg"
          widths={[768, 1280, 1920]}
          sizes="100vw"
        />

        <div class="hero__background-overlay" />
      </div>
    )
  }

  <Container>
    <div class="hero__layout">

<HeroCallWidget
  phone="+48 123 456 789"
  title="Zadzwoń teraz"
  eyebrow="SZYBKA REZERWACJA"
  availability="Rezerwacja online • szybki kontakt"
/>


      <Stack class="hero__content" space="2xl">
        <Stack space="md">
          {
            eyebrow && (
              <span class="hero__eyebrow">
                <Icon name="ic-branch" size="1rem" class="icon-w-f" />

                {eyebrow}
              </span>
            )
          }

          <h1 class="hero__title">
            {title}
          </h1>

          {description && <p class="hero__description">{description}</p>}
        </Stack>
        {
          hasActions && (
            <Cluster class="hero__actions" gap="md">
              {primaryAction && primaryAction.href ? (
                <Link class="button button--primary" href={primaryAction.href}>
                  <span class="button__label">
                    <span class="button__label-front">
                      {primaryAction.label}
                    </span>

                    <span class="button__label-back" aria-hidden="true">
                      {primaryAction.label}
                    </span>
                  </span>

                  {primaryAction.icon && (
                    <Icon
                      name={primaryAction.icon}
                      size={primaryAction.iconSize ?? "1rem"}
                      class="icon-w-f button__icon"
                    />
                  )}
                </Link>
              ) : primaryAction ? (
                <Button size="lg">
                  <span>{primaryAction.label}</span>
                </Button>
              ) : null}

              {secondaryAction && (
                <Link
                  class="button button--secondary"
                  href={secondaryAction.href}
                >
                  {secondaryAction.label}
                </Link>
              )}
            </Cluster>
          )
        }

        {
          hasFeatures && (
            <Stack class="hero__features" space="md">
              {features.map((feature) => (
                <Cluster class="hero__feature" gap="md" align="center">
                  {feature.icon && (
                    <Icon
                      name={feature.icon}
                      size={feature.iconSize ?? "1.5rem"}
                      class="icon-w-f"
                    />
                  )}

                  <span>{feature.label}</span>
                </Cluster>
              ))}
            </Stack>
          )
        }
      </Stack>
    </div>

    <Img
      src={BgImageLeft}
      alt=""
      kind="decorative"
      class="image-decorative image-decorative--left"
    />
  </Container>
</Section>
