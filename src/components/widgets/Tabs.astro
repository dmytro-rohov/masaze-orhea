---
export type TabItem = {
  id: string;
  label: string;
  backgroundImage?: string;
};

export interface Props {
  items: TabItem[];
  initialActiveId?: string;
  ariaLabel?: string;
  class?: string;
  transitionDuration?: number;
  mode?: "tabs" | "switcher";
}

const {
  items,
  initialActiveId = items[0]?.id,
  ariaLabel = "Zakładki",
  class: className,
  transitionDuration = 1000,
  mode = "tabs",
} = Astro.props;
---

<div
  class:list={[
    "tabs",
    `tabs--${mode}`,
    className,
  ]}
  data-tabs
  data-tabs-mode={mode}
  data-tabs-initial={initialActiveId}
  data-tabs-transition-duration={transitionDuration}
>
  <div
    class="tabs__list"
    role={mode === "tabs" ? "tablist" : "group"}
    aria-label={ariaLabel}
  >
    {
      items.map((item) => {
        const isActive = item.id === initialActiveId;

        return (
          <button
            class:list={[
              "tabs__tab",
              isActive && "is-active",
            ]}
            style={
              item.backgroundImage
                ? `--tab-background-image: url("${item.backgroundImage}")`
                : undefined
            }
            type="button"
            role={mode === "tabs" ? "tab" : undefined}
            id={mode === "tabs" ? `tab-${item.id}` : undefined}
            aria-selected={
              mode === "tabs"
                ? isActive
                  ? "true"
                  : "false"
                : undefined
            }
            aria-controls={
              mode === "tabs"
                ? `panel-${item.id}`
                : undefined
            }
            aria-pressed={
              mode === "switcher"
                ? isActive
                  ? "true"
                  : "false"
                : undefined
            }
            tabindex={mode === "tabs" ? (isActive ? 0 : -1) : undefined}
            data-tab
            data-tab-id={item.id}
          >
            <span class="tabs__tab-label">
              {item.label}
            </span>
          </button>
        );
      })
    }
  </div>

  {
    mode === "tabs" && (
      <div class="tabs__panels">
        <slot />
      </div>
    )
  }
</div>

<script>
  const initTabs = () => {
    const widgets =
      document.querySelectorAll<HTMLElement>(
        "[data-tabs]",
      );

    widgets.forEach((widget) => {
      if (widget.dataset.initialized === "true") {
        return;
      }

      widget.dataset.initialized = "true";

      const mode =
        widget.dataset.tabsMode ?? "tabs";

      const tabs = Array.from(
        widget.querySelectorAll<HTMLButtonElement>(
          "[data-tab]",
        ),
      );

      if (tabs.length === 0) {
        return;
      }

      /*
       * SWITCHER
       *
       * Nie posiada paneli.
       * Jedynie emituje zmianę ID.
       */
      if (mode === "switcher") {
        const activateSwitcher = (
          nextTab: HTMLButtonElement,
        ) => {
          const nextId =
            nextTab.dataset.tabId;

          if (!nextId) {
            return;
          }

          tabs.forEach((tab) => {
            const isActive =
              tab === nextTab;

            tab.classList.toggle(
              "is-active",
              isActive,
            );

            tab.setAttribute(
              "aria-pressed",
              isActive
                ? "true"
                : "false",
            );
          });

          widget.dispatchEvent(
            new CustomEvent(
              "tabs:change",
              {
                bubbles: true,
                detail: {
                  id: nextId,
                },
              },
            ),
          );
        };

        tabs.forEach((tab) => {
          tab.addEventListener(
            "click",
            () => {
              activateSwitcher(tab);
            },
          );
        });

        return;
      }

      /*
       * STANDARD TABS
       */
      const panels = Array.from(
        widget.querySelectorAll<HTMLElement>(
          "[data-tab-panel]",
        ),
      );

      if (panels.length === 0) {
        return;
      }

      const reducedMotion =
        window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        );

      const configuredDuration =
        Number(
          widget.dataset
            .tabsTransitionDuration,
        ) || 1100;

      const transitionDuration =
        reducedMotion.matches
          ? 0
          : configuredDuration;

      let transitionTimer:
        number | null = null;

      let isTransitioning = false;

      const clearTransitionTimer =
        () => {
          if (
            transitionTimer === null
          ) {
            return;
          }

          window.clearTimeout(
            transitionTimer,
          );

          transitionTimer = null;
        };

      const getPanelById = (
        id: string,
      ) => {
        return panels.find(
          (panel) =>
            panel.dataset.tabPanel ===
            id,
        );
      };

      const setPanelAccessibility = (
        panel: HTMLElement,
        isActive: boolean,
      ) => {
        panel.setAttribute(
          "aria-hidden",
          isActive
            ? "false"
            : "true",
        );

        panel.toggleAttribute(
          "inert",
          !isActive,
        );
      };

      const finishTransition =
        () => {
          panels.forEach(
            (panel) => {
              panel.classList.remove(
                "is-leaving",
              );
            },
          );

          widget.classList.remove(
            "is-transitioning",
          );

          isTransitioning = false;
          transitionTimer = null;
        };

      const activateTab = (
        nextTab: HTMLButtonElement,
        moveFocus = false,
      ) => {
        const nextId =
          nextTab.dataset.tabId;

        if (!nextId) {
          return;
        }

        const currentTab =
          tabs.find((tab) =>
            tab.classList.contains(
              "is-active",
            ),
          );

        if (
          currentTab === nextTab
        ) {
          if (moveFocus) {
            nextTab.focus();
          }

          return;
        }

        const nextPanel =
          getPanelById(nextId);

        if (!nextPanel) {
          return;
        }

        if (
          isTransitioning &&
          transitionDuration > 0
        ) {
          return;
        }

        clearTransitionTimer();

        const currentPanel =
          panels.find((panel) =>
            panel.classList.contains(
              "is-active",
            ),
          );

        isTransitioning = true;

        widget.classList.add(
          "is-transitioning",
        );

        if (
          currentPanel &&
          currentPanel !== nextPanel
        ) {
          currentPanel.classList.add(
            "is-leaving",
          );
        }

        tabs.forEach((tab) => {
          const isActive =
            tab === nextTab;

          tab.classList.toggle(
            "is-active",
            isActive,
          );

          tab.setAttribute(
            "aria-selected",
            isActive
              ? "true"
              : "false",
          );

          tab.tabIndex =
            isActive ? 0 : -1;
        });

        panels.forEach((panel) => {
          const isActive =
            panel === nextPanel;

          panel.classList.toggle(
            "is-active",
            isActive,
          );

          setPanelAccessibility(
            panel,
            isActive,
          );
        });

        if (moveFocus) {
          nextTab.focus();
        }

        widget.dispatchEvent(
          new CustomEvent(
            "tabs:change",
            {
              bubbles: true,
              detail: {
                id: nextId,
              },
            },
          ),
        );

        if (
          transitionDuration === 0
        ) {
          finishTransition();

          return;
        }

        transitionTimer =
          window.setTimeout(
            finishTransition,
            transitionDuration + 80,
          );
      };

      tabs.forEach((tab) => {
        tab.addEventListener(
          "click",
          () => {
            activateTab(tab);
          },
        );

        tab.addEventListener(
          "keydown",
          (event) => {
            const currentIndex =
              tabs.indexOf(tab);

            let nextIndex:
              number | null = null;

            if (
              event.key ===
                "ArrowRight" ||
              event.key ===
                "ArrowDown"
            ) {
              nextIndex =
                (
                  currentIndex + 1
                ) % tabs.length;
            }

            if (
              event.key ===
                "ArrowLeft" ||
              event.key ===
                "ArrowUp"
            ) {
              nextIndex =
                (
                  currentIndex -
                  1 +
                  tabs.length
                ) %
                tabs.length;
            }

            if (
              event.key === "Home"
            ) {
              nextIndex = 0;
            }

            if (
              event.key === "End"
            ) {
              nextIndex =
                tabs.length - 1;
            }

            if (
              nextIndex === null
            ) {
              return;
            }

            event.preventDefault();

            if (
              isTransitioning
            ) {
              clearTransitionTimer();
              finishTransition();
            }

            activateTab(
              tabs[nextIndex],
              true,
            );
          },
        );
      });

      const initialId =
        widget.dataset.tabsInitial;

      const initialTab =
        tabs.find(
          (tab) =>
            tab.dataset.tabId ===
            initialId,
        ) ??
        tabs[0];

      if (!initialTab) {
        return;
      }

      const initialPanel =
        getPanelById(
          initialTab.dataset.tabId ??
            "",
        );

      tabs.forEach((tab) => {
        const isActive =
          tab === initialTab;

        tab.classList.toggle(
          "is-active",
          isActive,
        );

        tab.setAttribute(
          "aria-selected",
          isActive
            ? "true"
            : "false",
        );

        tab.tabIndex =
          isActive ? 0 : -1;
      });

      panels.forEach((panel) => {
        const isActive =
          panel === initialPanel;

        panel.classList.toggle(
          "is-active",
          isActive,
        );

        panel.classList.remove(
          "is-leaving",
        );

        setPanelAccessibility(
          panel,
          isActive,
        );
      });
    });
  };

  initTabs();

  document.addEventListener(
    "astro:page-load",
    initTabs,
  );
</script>