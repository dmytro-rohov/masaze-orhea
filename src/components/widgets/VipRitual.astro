---
import Section from "@/components/layouts/Section.astro";
import Container from "@/components/layouts/Container.astro";
import Cluster from "@/components/layouts/Cluster.astro";
import Stack from "@/components/layouts/Stack.astro";

import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import Link from "@/components/ui/Link.astro";
import Video from "@/components/media/Video.astro";

// assets
import ritualImageBg from "@/assets/img/gold-branch.png";

import step01Webm from "@/assets/video/video-1.webm";
import step02Webm from "@/assets/video/video-2.webm";
import step03Webm from "@/assets/video/video-3.webm";
import step04Webm from "@/assets/video/video-4.webm";
import step05Webm from "@/assets/video/video-face.webm";

import step01Mp4 from "@/assets/video/video-1.mp4";
import step02Mp4 from "@/assets/video/video-2.mp4";
import step03Mp4 from "@/assets/video/video-3.mp4";
import step04Mp4 from "@/assets/video/video-4.mp4";
import step05Mp4 from "@/assets/video/video-face.mp4";

type VideoSource = {
  src: string;
  type: "video/webm" | "video/mp4";
};

type RitualStep = {
  number: string;
  label: string;
  videoSources: VideoSource[];
};

export interface Props {
  class?: string;
}

const { class: className, ...restProps } = Astro.props;

const ritualSteps: RitualStep[] = [
  {
    number: "01",
    label: "Peeling ciała",
    videoSources: [
      {
        src: step01Webm,
        type: "video/webm",
      },
      {
        src: step01Mp4,
        type: "video/mp4",
      },
    ],
  },

  {
    number: "02",
    label: "Sauna infrared",
    videoSources: [
      {
        src: step02Webm,
        type: "video/webm",
      },
      {
        src: step02Mp4,
        type: "video/mp4",
      },
    ],
  },

  {
    number: "03",
    label: "Masaż klasyczny całego ciała",
    videoSources: [
      {
        src: step03Webm,
        type: "video/webm",
      },
      {
        src: step03Mp4,
        type: "video/mp4",
      },
    ],
  },

  {
    number: "04",
    label: "Masaż twarzy, relaksacyjny",
    videoSources: [
      {
        src: step04Webm,
        type: "video/webm",
      },
      {
        src: step04Mp4,
        type: "video/mp4",
      },
    ],
  },

  {
    number: "05",
    label: "Prysznic i nakładanie kremu",
    videoSources: [
      {
        src: step05Webm,
        type: "video/webm",
      },
      {
        src: step05Mp4,
        type: "video/mp4",
      },
    ],
  },
];
---

<Section
  {...restProps}
  class:list={["vip-ritual", className]}
  data-vip-ritual
  spacing="none"
>
  <div class="vip-ritual__sticky" data-vip-sticky>
    <div class="vip-ritual__background" aria-hidden="true">
      <!-- <Img
        src={ritualImage}
        alt=""
        kind="decorative"
        class="vip-ritual__background-image"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      /> -->

      <div class="vip-ritual__video-stack">
        {
          ritualSteps.map((step, index) => (
            <Video
              sources={step.videoSources}
              controls={false}
              autoplay={false}
              muted={true}
              loop={true}
              playsinline={true}
              preload={index === 0 ? "metadata" : "none"}
              class="vip-ritual__step-video"
              data-vip-step-video={index}
            />
          ))
        }
      </div>

      <div class="vip-ritual__background-overlay"></div>
    </div>

    <div class="vip-ritual__intro" data-vip-intro>
      <Icon name="ic-bg-gd" class="icon-w-f gradient-icon" />

      <Img
        src={ritualImageBg}
        alt=""
        kind="decorative"
        class="image-decorative ritual__image-decorative image-decorative--right"
      />

      <Container>
        <Stack as="div" class="vip-ritual__intro-content" space="lg">
          <span class="vip-ritual__intro-eyebrow">
            <Icon name="ic-crown" class="icon-w-f" size="1rem" />
            4 strefy + 1 dodatkowa usługa
          </span>

          <h2 class="vip-ritual__semantic-title">
            Prawdziwy sekret chowa się w naszym pakiecie VIP
          </h2>

          <div class="vip-ritual__intro-title" aria-hidden="true">
            <span class="vip-ritual__intro-title-copy">
              Prawdziwy sekret chowa się w naszym pakiecie
            </span>

            <span
              class="vip-ritual__vip-anchor vip-ritual__vip-anchor--start"
              data-vip-start
            >
              VIP
            </span>
          </div>

          <p class="vip-ritual__intro-description">
            Zanurz się w świecie głębokiego relaksu i najwyższej jakości dotyku.
            Przewiń w dół, aby doświadczyć pełnego rytuału VIP krok po kroku.
          </p>

          <div class="vip-ritual__scroll-hint" aria-hidden="true">
            <span> Odkryj rytuał krok po kroku </span>

            <Icon name="ic-mouse" class="icon-w-f" size="3rem" />
          </div>
        </Stack>
      </Container>
    </div>

    <span class="vip-ritual__moving-vip" data-vip-word aria-hidden="true">
      VIP
    </span>

    <div class="vip-ritual__ritual" data-vip-final aria-hidden="true" inert>
      <Container>
        <div class="vip-ritual__ritual-content">
          <Stack as="div" space="xl" class="vip-ritual__ritual-main">
            <span class="vip-ritual__ritual-eyebrow">
              <Icon name="ic-crown" class="icon-w-f" size="0.8rem" />
              najbardziej ekskluzywna opcja
            </span>

            <h2 class="vip-ritual__semantic-title">Rytuał VIP</h2>

            <div class="vip-ritual__ritual-title" aria-hidden="true">
              <span class="vip-ritual__ritual-title-measurement">
                <span> Rytuał </span>

                <span
                  class="vip-ritual__vip-anchor vip-ritual__vip-anchor--end"
                  data-vip-end
                >
                  VIP
                </span>
              </span>

              <span class="vip-ritual__typed-word" data-vip-typed-word></span>

              <span class="vip-ritual__static-title"> Rytuał VIP </span>
            </div>

            <Icon name="ic-lines" class="icon-w-f vip-ritual__icon" />

            <span class="vip-ritual__duration">
              <Icon size="0.8rem" name="ic-clock" class="icon-w-f" />

              210 min
            </span>

            <p class="vip-ritual__ritual-description">
              Zanurz się w świecie głębokiego relaksu i najwyższej jakości
              <br />
              dotyku. Pozwól sobie na pełny rytuał odprężenia i regeneracji.
            </p>

            <Cluster gap="md" class="vip-ritual__actions">
              <Link href="/rezerwacja" class="button button--primary zones-tabs__vip-cta">
                <span class="button__label">
                  <span class="button__label-front"> Umów rytuał VIP </span>

                  <span class="button__label-back" aria-hidden="true">
                    Umów rytuał VIP
                  </span>
                </span>

                <Icon name="ic-arrow-right" class="icon-w-f" size="1rem" />
              </Link>

              <Link
                href="/uslugi?strefa=vip#strefy"
                class="button button--secondary vip-ritual__secondary-action"
              >
                <span> Poznaj szczegóły </span>
              </Link>
            </Cluster>
          </Stack>

          <ol class="vip-ritual__steps" data-vip-steps>
            {
              ritualSteps.map((step, index) => (
                <li
                  class="vip-ritual__step"
                  data-vip-step={index}
                  style="--step-progress: 0;"
                >
                  <span class="vip-ritual__step-number">{step.number}</span>

                  <span class="vip-ritual__step-label">{step.label}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </Container>
    </div>
  </div>
</Section>

<script>
  const clamp = (value: number, min = 0, max = 1) => {
    return Math.min(Math.max(value, min), max);
  };

  const mapRange = (value: number, inputStart: number, inputEnd: number) => {
    if (inputStart === inputEnd) {
      return 0;
    }

    return clamp((value - inputStart) / (inputEnd - inputStart));
  };

  const lerp = (start: number, end: number, progress: number) => {
    return start + (end - start) * progress;
  };

  const smoothstep = (value: number) => {
    const t = clamp(value);

    return t * t * (3 - 2 * t);
  };

  const initVipRitual = () => {
    const sections = document.querySelectorAll<HTMLElement>("[data-vip-ritual]");

    sections.forEach((section) => {
      if (section.dataset.initialized === "true") {
        return;
      }

      section.dataset.initialized = "true";

      const sticky = section.querySelector<HTMLElement>("[data-vip-sticky]");
      const intro = section.querySelector<HTMLElement>("[data-vip-intro]");
      const ritual = section.querySelector<HTMLElement>("[data-vip-final]");
      const vip = section.querySelector<HTMLElement>("[data-vip-word]");
      const startAnchor = section.querySelector<HTMLElement>("[data-vip-start]");
      const endAnchor = section.querySelector<HTMLElement>("[data-vip-end]");
      const typedWord = section.querySelector<HTMLElement>("[data-vip-typed-word]");

      const steps = Array.from(
        section.querySelectorAll<HTMLElement>("[data-vip-step]"),
      );

      const stepVideos = Array.from(
        section.querySelectorAll<HTMLVideoElement>("[data-vip-step-video]"),
      );

      if (
        !sticky ||
        !intro ||
        !ritual ||
        !vip ||
        !startAnchor ||
        !endAnchor ||
        !typedWord ||
        steps.length === 0
      ) {
        return;
      }

      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );

      const finePointer = window.matchMedia(
        "(hover: hover) and (pointer: fine)",
      );

      const word = "Rytuał";

      /*
       * Maximum VIP size.
       */
      const maxVipSizeMultiplier = 3.4;

      const vipHoldProgress = 0.34;
      const vipHoldDuration = 1100;

      let baseVipFontSize = 0;
      let maxVipFontSize = 0;

      let startX = 0;
      let startY = 0;

      let centerX = 0;
      let centerY = 0;

      let endX = 0;
      let endY = 0;

      let ticking = false;
      let activeStepIndex = -1;

      let vipHoldStarted = false;
      let vipHoldFinished = false;
      let vipHoldScrollY = 0;
      let vipHoldTimeout: number | undefined;

      let vipShinePlayed = false;

      let previousRawProgress = 0;

      /*
       * Measure start, center and end points.
       */
      const measure = () => {
        const stickyRect = sticky.getBoundingClientRect();
        const startRect = startAnchor.getBoundingClientRect();
        const endRect = endAnchor.getBoundingClientRect();

        baseVipFontSize = Number.parseFloat(
          window.getComputedStyle(vip).fontSize,
        );

        maxVipFontSize = baseVipFontSize * maxVipSizeMultiplier;

        startX = startRect.left - stickyRect.left + startRect.width / 2;
        startY = startRect.top - stickyRect.top + startRect.height / 2;

        endX = endRect.left - stickyRect.left + endRect.width / 2;
        endY = endRect.top - stickyRect.top + endRect.height / 2;

        centerX = stickyRect.width / 2;
        centerY = stickyRect.height / 2;
      };

      const getScrollableDistance = () => {
        return section.offsetHeight - sticky.clientHeight;
      };

      const getProgress = () => {
        const sectionRect = section.getBoundingClientRect();
        const scrollableDistance = getScrollableDistance();

        if (scrollableDistance <= 0) {
          return 0;
        }

        return clamp(-sectionRect.top / scrollableDistance);
      };

      const getVipHoldScrollY = () => {
        const sectionRect = section.getBoundingClientRect();
        const sectionDocumentTop = window.scrollY + sectionRect.top;
        const scrollableDistance = getScrollableDistance();

        return sectionDocumentTop + scrollableDistance * vipHoldProgress;
      };

      const isVipHolding = () => {
        return vipHoldStarted && !vipHoldFinished;
      };

      const playVipShine = () => {
        if (vipShinePlayed) {
          return;
        }

        vipShinePlayed = true;

        vip.classList.add("is-shining");

        vip.addEventListener(
          "animationend",
          () => {
            vip.classList.remove("is-shining");
          },
          {
            once: true,
          },
        );
      };

      /*
       * Keep the document exactly at the VIP peak while the hold is active.
       *
       * wheel/touchmove are blocked separately, but this is also a safety
       * fallback for scrollbar movement or other scroll sources.
       */
      const restoreVipHoldScroll = () => {
        if (!isVipHolding()) {
          return;
        }

        if (Math.abs(window.scrollY - vipHoldScrollY) <= 0.5) {
          return;
        }

        window.scrollTo({
          top: vipHoldScrollY,
          left: window.scrollX,
          behavior: "auto",
        });
      };

      const finishVipHold = () => {
        if (!isVipHolding()) {
          return;
        }

        vipHoldFinished = true;

        section.classList.remove("is-vip-holding");

        previousRawProgress = vipHoldProgress;

        requestRender();
      };

      const startVipHold = () => {
        if (
          vipHoldStarted ||
          vipHoldFinished ||
          !finePointer.matches
        ) {
          return;
        }

        vipHoldStarted = true;
        vipHoldScrollY = getVipHoldScrollY();

        window.scrollTo({
          top: vipHoldScrollY,
          left: window.scrollX,
          behavior: "auto",
        });

        section.classList.add("is-vip-holding");

        playVipShine();

        vipHoldTimeout = window.setTimeout(
          finishVipHold,
          vipHoldDuration,
        );
      };

      /*
       * Do not allow trackpad/mouse wheel momentum to accumulate
       * while VIP is being held.
       */
      const preventScrollDuringVipHold = (event: Event) => {
        if (!isVipHolding()) {
          return;
        }

        event.preventDefault();
      };

      const preventKeyboardScrollDuringVipHold = (
        event: KeyboardEvent,
      ) => {
        if (!isVipHolding()) {
          return;
        }

        const blockedKeys = [
          "ArrowDown",
          "ArrowUp",
          "PageDown",
          "PageUp",
          "Home",
          "End",
          " ",
        ];

        if (!blockedKeys.includes(event.key)) {
          return;
        }

        event.preventDefault();
      };

      const setActiveStepVideo = (nextIndex: number) => {
        if (nextIndex === activeStepIndex) {
          return;
        }

        stepVideos.forEach((video, index) => {
          const isActive = index === nextIndex;

          video.classList.toggle("is-active", isActive);

          if (isActive) {
            try {
              video.currentTime = 0;
            } catch {
              // Metadata may not be ready.
            }

            void video.play().catch(() => {
              // Autoplay failure is harmless.
            });

            return;
          }

          video.pause();
        });

        steps.forEach((step, index) => {
          step.classList.toggle("is-current", index === nextIndex);
        });

        activeStepIndex = nextIndex;
      };

      const getActiveStepIndex = (progress: number) => {
        if (progress >= 0.88) {
          return 4;
        }

        if (progress >= 0.8) {
          return 3;
        }

        if (progress >= 0.72) {
          return 2;
        }

        if (progress >= 0.64) {
          return 1;
        }

        if (progress >= 0.56) {
          return 0;
        }

        return -1;
      };

      const render = () => {
        const rawProgress = getProgress();

        /*
         * Trigger the hold only when crossing the peak while scrolling forward.
         *
         * This prevents the page from unexpectedly jumping backwards
         * when opened/reloaded already below the VIP peak.
         */
        const crossedVipPeak =
          previousRawProgress < vipHoldProgress &&
          rawProgress >= vipHoldProgress;

        if (
          crossedVipPeak &&
          !vipHoldStarted &&
          !vipHoldFinished
        ) {
          startVipHold();
        }

        /*
         * During the hold both the physical scroll and visual progress
         * stay exactly at the same 0.34 position.
         */
        const progress = isVipHolding()
          ? vipHoldProgress
          : rawProgress;

        /*
         * Intro.
         */
        const introExit = smoothstep(mapRange(progress, 0.06, 0.22));

        const darkProgress = smoothstep(mapRange(progress, 0.08, 0.3));

        /*
         * VIP reaches exact maximum at 0.34.
         */
        const vipToCenterProgress = smoothstep(
          mapRange(progress, 0.16, 0.34),
        );

        /*
         * Only after the premium hold VIP starts moving toward
         * the final title and shrinking.
         */
        const vipToFinalProgress = smoothstep(
          mapRange(progress, 0.34, 0.4),
        );

        /*
         * Typewriter starts when VIP reaches the final position.
         */
        const typingProgress = mapRange(progress, 0.4, 0.54);

        /*
         * Ritual content.
         */
        const backgroundProgress = smoothstep(
          mapRange(progress, 0.53, 0.62),
        );

        const ritualMetaProgress = smoothstep(
          mapRange(progress, 0.55, 0.64),
        );

        const ritualCopyProgress = smoothstep(
          mapRange(progress, 0.6, 0.69),
        );

        const stepProgresses = [
          smoothstep(mapRange(progress, 0.61, 0.66)),
          smoothstep(mapRange(progress, 0.68, 0.73)),
          smoothstep(mapRange(progress, 0.75, 0.8)),
          smoothstep(mapRange(progress, 0.82, 0.87)),
          smoothstep(mapRange(progress, 0.89, 0.94)),
        ];

        const stepsLineProgress = smoothstep(
          mapRange(progress, 0.63, 0.94),
        );

        /*
         * General variables.
         */
        section.style.setProperty("--intro-exit", String(introExit));

        section.style.setProperty("--dark-progress", String(darkProgress));

        section.style.setProperty(
          "--ritual-background-progress",
          String(backgroundProgress),
        );

        section.style.setProperty(
          "--ritual-meta-progress",
          String(ritualMetaProgress),
        );

        section.style.setProperty(
          "--ritual-copy-progress",
          String(ritualCopyProgress),
        );

        section.style.setProperty(
          "--steps-line-progress",
          String(stepsLineProgress),
        );

        /*
         * Ritual steps.
         */
        steps.forEach((step, index) => {
          step.style.setProperty(
            "--step-progress",
            String(stepProgresses[index] ?? 0),
          );
        });

        /*
         * Move from start to center.
         */
        const positionToCenterX = lerp(
          startX,
          centerX,
          vipToCenterProgress,
        );

        const positionToCenterY = lerp(
          startY,
          centerY,
          vipToCenterProgress,
        );

        /*
         * Move from center to final title.
         */
        const currentX = lerp(
          positionToCenterX,
          endX,
          vipToFinalProgress,
        );

        const currentY = lerp(
          positionToCenterY,
          endY,
          vipToFinalProgress,
        );

        /*
         * Grow while entering the center.
         */
        const growingFontSize = lerp(
          baseVipFontSize,
          maxVipFontSize,
          vipToCenterProgress,
        );

        /*
         * Shrink while leaving the center.
         */
        const currentFontSize = lerp(
          growingFontSize,
          baseVipFontSize,
          vipToFinalProgress,
        );

        section.style.setProperty("--vip-x", `${currentX}px`);

        section.style.setProperty("--vip-y", `${currentY}px`);

        section.style.setProperty(
          "--vip-font-size",
          `${currentFontSize}px`,
        );

        /*
         * Typewriter.
         */
        const visibleCharacters = Math.min(
          word.length,
          Math.floor(
            typingProgress * (word.length + 1),
          ),
        );

        typedWord.textContent = word.slice(
          0,
          visibleCharacters,
        );

        const isTyping =
          typingProgress > 0 &&
          typingProgress < 1;

        typedWord.classList.toggle(
          "is-typing",
          isTyping,
        );

        /*
         * Videos.
         */
        const nextActiveStepIndex =
          getActiveStepIndex(progress);

        setActiveStepVideo(
          nextActiveStepIndex,
        );

        /*
         * VIP header mode.
         */
        const sectionRect =
          section.getBoundingClientRect();

        const vipExitThreshold =
          window.innerHeight * 0.08;

        const isVipSectionActive =
          sectionRect.top <= 0 &&
          sectionRect.bottom > vipExitThreshold;

        const vipModeActive =
          isVipSectionActive &&
          darkProgress > 0.55;

        document.body.classList.toggle(
          "is-vip-mode",
          vipModeActive,
        );

        /*
         * Accessibility.
         */
        const finalIsAvailable =
          ritualCopyProgress > 0.75;

        ritual.toggleAttribute(
          "inert",
          !finalIsAvailable,
        );

        ritual.setAttribute(
          "aria-hidden",
          finalIsAvailable
            ? "false"
            : "true",
        );

        intro.setAttribute(
          "aria-hidden",
          introExit > 0.98
            ? "true"
            : "false",
        );

        previousRawProgress = isVipHolding()
          ? vipHoldProgress
          : rawProgress;

        ticking = false;
      };

      const requestRender = () => {
        if (ticking) {
          return;
        }

        ticking = true;

        requestAnimationFrame(render);
      };

      /*
       * Reduced motion.
       */
      const applyReducedMotion = () => {
        section.classList.add(
          "vip-ritual--reduced-motion",
        );

        typedWord.textContent = word;

        ritual.removeAttribute("inert");

        ritual.setAttribute(
          "aria-hidden",
          "false",
        );

        intro.setAttribute(
          "aria-hidden",
          "true",
        );

        steps.forEach((step) => {
          step.style.setProperty(
            "--step-progress",
            "1",
          );
        });

        section.style.setProperty(
          "--steps-line-progress",
          "1",
        );

        document.body.classList.remove(
          "is-vip-mode",
        );
      };

      if (reducedMotion.matches) {
        applyReducedMotion();

        return;
      }

      /*
       * Init.
       */
      measure();

      previousRawProgress = getProgress();

      /*
       * When the page is loaded/reloaded already after the premium moment,
       * do not snap the user backwards to replay it.
       */
      if (
        previousRawProgress >
        vipHoldProgress + 0.01
      ) {
        vipHoldStarted = true;
        vipHoldFinished = true;
        vipShinePlayed = true;
      }

      render();

      document.fonts?.ready.then(() => {
        measure();
        requestRender();
      });

      const resizeObserver = new ResizeObserver(() => {
        measure();
        requestRender();
      });

      resizeObserver.observe(sticky);

      const controller =
        new AbortController();

      /*
       * Trackpad / mouse wheel.
       *
       * passive:false is required because during the short VIP hold
       * we deliberately discard wheel movement.
       */
      window.addEventListener(
        "wheel",
        preventScrollDuringVipHold,
        {
          passive: false,
          signal: controller.signal,
        },
      );

      /*
       * Touch fallback.
       */
      window.addEventListener(
        "touchmove",
        preventScrollDuringVipHold,
        {
          passive: false,
          signal: controller.signal,
        },
      );

      /*
       * Keyboard scrolling fallback.
       */
      window.addEventListener(
        "keydown",
        preventKeyboardScrollDuringVipHold,
        {
          signal: controller.signal,
        },
      );

      window.addEventListener(
        "scroll",
        () => {
          if (isVipHolding()) {
            restoreVipHoldScroll();
          }

          requestRender();
        },
        {
          passive: true,
          signal: controller.signal,
        },
      );

      window.addEventListener(
        "resize",
        () => {
          measure();
          requestRender();
        },
        {
          signal: controller.signal,
        },
      );

      /*
       * Cleanup before Astro swap.
       */
      document.addEventListener(
        "astro:before-swap",
        () => {
          controller.abort();

          resizeObserver.disconnect();

          if (vipHoldTimeout !== undefined) {
            window.clearTimeout(
              vipHoldTimeout,
            );
          }

          section.classList.remove(
            "is-vip-holding",
          );

          stepVideos.forEach((video) => {
            video.pause();
          });

          document.body.classList.remove(
            "is-vip-mode",
          );
        },
        {
          once: true,
        },
      );
    });
  };

  initVipRitual();

  document.addEventListener(
    "astro:page-load",
    initVipRitual,
  );
</script>
