---
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import Radio from "@/components/form/Radio.astro";
import { getMassageVisual } from "@/data/massage-visuals";
import { getMassageOfferPath } from "@/data/massage-pages";
import {
  getMassageDurationLabel,
  getMassagePriceLabel,
  type Massage,
} from "@/data/massages";

export interface Props {
  massages: Massage[];
  actionLabel?: string;
  actionHref?: (massage: Massage) => string;
  mode?: "link" | "voucher-select" | "booking-select";
  selectedMassageId?: string;
  selectedVariantIndex?: number;
  class?: string;
}

const {
  massages,
  actionLabel = "Zobacz masaż",
  actionHref = getMassageOfferPath,
  mode = "link",
  selectedMassageId,
  selectedVariantIndex,
  class: className,
} = Astro.props;

const isSelectionMode = mode !== "link";
const selectionPrefix = mode === "booking-select" ? "booking" : "voucher";

const getVariantDuration = (variant: Massage["variants"][number]) => {
  return "durationMinutes" in variant
    ? `${variant.durationMinutes} min`
    : variant.durationLabel;
};

const getVariantCode = (variant: Massage["variants"][number]) =>
  "durationMinutes" in variant ? `${variant.durationMinutes}-min` : "vip";
---

<ul class:list={["massage-cards", `massage-cards--${mode}`, className]}>
  {
    massages.map((massage) => {
      const visual = getMassageVisual(massage);
      const href = actionHref(massage);
      const isSelected = selectedMassageId === massage.id;
      const serializedVariants = JSON.stringify(
        massage.variants.map((variant, variantIndex) => ({
          variantIndex,
          variantCode: getVariantCode(variant),
          duration: getVariantDuration(variant),
          pricePLN: variant.pricePLN,
        })),
      );

      return (
        <li
          class:list={[
            "massage-card",
            isSelectionMode && massage.zoneId === "vip" && "massage-card--vip",
            isSelected && "is-selected",
          ]}
          data-voucher-massage-card={mode === "voucher-select" ? "" : undefined}
          data-booking-massage-card={mode === "booking-select" ? "" : undefined}
          data-massage-id={isSelectionMode ? massage.id : undefined}
          data-massage-title={isSelectionMode ? massage.title : undefined}
          data-massage-service={isSelectionMode ? massage.serviceName : undefined}
          data-variants={isSelectionMode ? serializedVariants : undefined}
        >
          <article class="massage-card__inner">
            {mode === "link" ? (
              <Link
                href={href}
                class="massage-card__media-link"
                aria-label={`${actionLabel}: ${massage.serviceName ?? massage.title}`}
              >
                <div class="massage-card__media">
                  <Img
                    src={visual.cardImage}
                    alt={visual.cardImageAlt}
                    class="massage-card__image"
                    widths={[360, 520, 720]}
                    sizes="(max-width: 768px) 100vw, 33vw"
                  />
                </div>
              </Link>
            ) : (
              <div class="massage-card__media">
                <Img
                  src={visual.cardImage}
                  alt={visual.cardImageAlt}
                  class="massage-card__image"
                  widths={[360, 520, 720]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                />
              </div>
            )}

            <div class="massage-card__content">
              <div class="massage-card__copy">
                <h3 class="massage-card__title">
                  {mode === "link" ? massage.serviceName ?? massage.title : massage.title}
                </h3>
                {isSelectionMode && massage.serviceName && (
                  <p class="massage-card__service-name">{massage.serviceName}</p>
                )}
                <p class="massage-card__description">{massage.shortDescription}</p>
              </div>

              {mode === "link" ? (
                <div class="massage-card__footer">
                  <div class="massage-card__meta">
                    <span class="massage-card__meta-item">
                      <Icon name="ic-clock" size="1rem" class="icon-w-f" />
                      {getMassageDurationLabel(massage)}
                    </span>
                    <span class="massage-card__meta-item">
                      <Icon name="ic-price" size="1rem" class="icon-w-f" />
                      {getMassagePriceLabel(massage)}
                    </span>
                  </div>
                  <Link href={href} class="button button--secondary massage-card__action">
                    <span class="button__label">
                      <span class="button__label-front">{actionLabel}</span>
                      <span class="button__label-back" aria-hidden="true">{actionLabel}</span>
                    </span>
                  </Link>
                </div>
              ) : (
                <div class="massage-card__voucher-footer">
                  <fieldset class="massage-card__variants">
                    <legend class="massage-card__variants-legend">
                      {massage.variants.length > 1
                        ? "Wybierz wariant"
                        : mode === "booking-select"
                          ? "Wariant masażu"
                          : "Wariant vouchera"}
                    </legend>
                    {massage.variants.map((variant, variantIndex) => (
                      <Radio
                        id={`${selectionPrefix}-${massage.id}-${variantIndex}`}
                        name={`${selectionPrefix}-variant-${massage.id}`}
                        value={String(variantIndex)}
                        checked={
                          isSelected
                            ? selectedVariantIndex === variantIndex
                            : massage.variants.length === 1
                        }
                        required={mode === "voucher-select"}
                      >
                        <span class="massage-card__variant-copy">
                          <span>{getVariantDuration(variant)}</span>
                          <strong>{variant.pricePLN} zł</strong>
                        </span>
                      </Radio>
                    ))}
                  </fieldset>
                  <p
                    class="massage-card__selection-error"
                    data-voucher-card-error={mode === "voucher-select" ? "" : undefined}
                    data-booking-card-error={mode === "booking-select" ? "" : undefined}
                    aria-live="polite"
                  ></p>
                  <Button
                    type="button"
                    variant="secondary"
                    class="massage-card__action"
                    aria-pressed={mode === "booking-select" ? isSelected : undefined}
                    data-select-voucher={mode === "voucher-select" ? "" : undefined}
                    data-select-booking={mode === "booking-select" ? "" : undefined}
                  >
                    {mode === "booking-select" ? "Wybieram ten masaż" : "Wybieram ten voucher"}
                  </Button>
                </div>
              )}
            </div>
          </article>
        </li>
      );
    })
  }
</ul>

<script>
  const syncVipSelectionMode = () => {
    const hasSelectedVip = Array.from(
      document.querySelectorAll<HTMLElement>("[data-vip-selection-scope]"),
    ).some((scope) =>
      scope.querySelector("[data-vip-offer] .massage-card--vip.is-selected"),
    );

    document.body.classList.toggle("is-active-vip", hasSelectedVip);
    document.body.classList.toggle("is-vip-mode", hasSelectedVip);
  };

  const initVipSelectionScopes = () => {
    document
      .querySelectorAll<HTMLElement>("[data-vip-selection-scope]")
      .forEach((scope) => {
        if (scope.dataset.vipSelectionInitialized === "true") {
          return;
        }

        scope.dataset.vipSelectionInitialized = "true";

        const observer = new MutationObserver(syncVipSelectionMode);

        observer.observe(scope, {
          attributes: true,
          attributeFilter: ["class"],
          subtree: true,
        });

        document.addEventListener(
          "astro:before-swap",
          () => {
            observer.disconnect();
            document.body.classList.remove("is-active-vip");
            document.body.classList.remove("is-vip-mode");
          },
          { once: true },
        );
      });

    syncVipSelectionMode();
  };

  initVipSelectionScopes();
  document.addEventListener("astro:page-load", initVipSelectionScopes);
</script>
