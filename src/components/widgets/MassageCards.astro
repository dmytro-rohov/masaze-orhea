---
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import Link from "@/components/ui/Link.astro";
import Button from "@/components/ui/Button.astro";
import Radio from "@/components/form/Radio.astro";
import { getMassageVisual } from "@/data/massage-visuals";
import { getMassageOfferPath } from "@/data/massage-pages";
import {
  getMassageDurationLabel,
  getMassagePriceLabel,
  type Massage,
} from "@/data/massages";
import type { ImageMetadata } from "astro";

export type InquiryOffer = {
  id: string;
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
};

export interface Props {
  massages?: Massage[];
  inquiryOffers?: InquiryOffer[];
  actionLabel?: string;
  actionHref?: (massage: Massage) => string;
  mode?: "link" | "voucher-select" | "booking-select" | "inquiry-select";
  selectedMassageId?: string;
  selectedVariantIndex?: number;
  dualScrollbar?: boolean;
  class?: string;
}

const {
  massages = [],
  inquiryOffers = [],
  actionLabel = "Zobacz masaż",
  actionHref = getMassageOfferPath,
  mode = "link",
  selectedMassageId,
  selectedVariantIndex,
  dualScrollbar = false,
  class: className,
} = Astro.props;

const isSelectionMode = mode === "voucher-select" || mode === "booking-select";
const selectionPrefix = mode === "booking-select" ? "booking" : "voucher";

const getVariantDuration = (variant: Massage["variants"][number]) => {
  return "durationMinutes" in variant
    ? `${variant.durationMinutes} min`
    : variant.durationLabel;
};

const getVariantCode = (variant: Massage["variants"][number]) =>
  "durationMinutes" in variant ? `${variant.durationMinutes}-min` : "vip";
---

<div
  class:list={[
    "massage-cards-scroll",
    dualScrollbar && "massage-cards-scroll--dual",
  ]}
  data-massage-scroll-sync={dualScrollbar ? "" : undefined}
>
  {
    dualScrollbar && (
      <div
        class="massage-cards-scroll__top"
        data-massage-scroll-top
        aria-hidden="true"
      >
        <div class="massage-cards-scroll__spacer" data-massage-scroll-spacer />
      </div>
    )
  }

  <ul
    class:list={["massage-cards", `massage-cards--${mode}`, className]}
    data-massage-scroll-content={dualScrollbar ? "" : undefined}
    data-reveal="fade"
  >
    {
      massages.map((massage) => {
        const visual = getMassageVisual(massage);
        const href = actionHref(massage);
        const isSelected = selectedMassageId === massage.id;
        const serializedVariants = JSON.stringify(
          massage.variants.map((variant, variantIndex) => ({
            variantIndex,
            variantCode: getVariantCode(variant),
            duration: getVariantDuration(variant),
            pricePLN: variant.pricePLN,
          })),
        );

        return (
          <li
            class:list={[
              "massage-card",
              isSelectionMode &&
                massage.zoneId === "vip" &&
                "massage-card--vip",
              isSelected && "is-selected",
            ]}
            data-voucher-massage-card={
              mode === "voucher-select" ? "" : undefined
            }
            data-booking-massage-card={
              mode === "booking-select" ? "" : undefined
            }
            data-massage-id={isSelectionMode ? massage.id : undefined}
            data-massage-title={isSelectionMode ? massage.title : undefined}
            data-massage-service={
              isSelectionMode ? massage.serviceName : undefined
            }
            data-variants={isSelectionMode ? serializedVariants : undefined}
          >
            <article class="massage-card__inner">
              {mode === "link" ? (
                <Link
                  href={href}
                  class="massage-card__media-link"
                  aria-label={`${actionLabel}: ${massage.serviceName ?? massage.title}`}
                >
                  <div class="massage-card__media">
                    <Img
                      src={visual.cardImage}
                      alt={visual.cardImageAlt}
                      class="massage-card__image"
                      widths={[360, 520, 720]}
                      sizes="(max-width: 768px) 100vw, 33vw"
                    />
                  </div>
                </Link>
              ) : (
                <div class="massage-card__media">
                  <Img
                    src={visual.cardImage}
                    alt={visual.cardImageAlt}
                    class="massage-card__image"
                    widths={[360, 520, 720]}
                    sizes="(max-width: 768px) 100vw, 33vw"
                  />
                </div>
              )}

              <div class="massage-card__content">
                <div class="massage-card__copy">
                  <h3 class="massage-card__title">
                    {mode === "link"
                      ? (massage.serviceName ?? massage.title)
                      : massage.title}
                  </h3>
                  {isSelectionMode && massage.serviceName && (
                    <p class="massage-card__service-name">
                      {massage.serviceName}
                    </p>
                  )}
                  <p class="massage-card__description">
                    {massage.shortDescription}
                  </p>
                </div>

                {mode === "link" ? (
                  <div class="massage-card__footer">
                    <div class="massage-card__meta">
                      <span class="massage-card__meta-item">
                        <Icon name="ic-clock" size="1rem" class="icon-w-f" />
                        {getMassageDurationLabel(massage)}
                      </span>
                      <span class="massage-card__meta-item">
                        <Icon name="ic-price" size="1rem" class="icon-w-f" />
                        {getMassagePriceLabel(massage)}
                      </span>
                    </div>
                    <Link
                      href={href}
                      class="button button--secondary massage-card__action"
                    >
                      <span class="button__label">
                        <span class="button__label-front">{actionLabel}</span>
                        <span class="button__label-back" aria-hidden="true">
                          {actionLabel}
                        </span>
                      </span>
                    </Link>
                  </div>
                ) : (
                  <div class="massage-card__voucher-footer">
                    <fieldset class="massage-card__variants">
                      <legend class="massage-card__variants-legend">
                        {massage.variants.length > 1
                          ? "Wybierz wariant"
                          : mode === "booking-select"
                            ? "Wariant masażu"
                            : "Wariant vouchera"}
                      </legend>
                      {massage.variants.map((variant, variantIndex) => (
                        <Radio
                          id={`${selectionPrefix}-${massage.id}-${variantIndex}`}
                          name={`${selectionPrefix}-variant-${massage.id}`}
                          value={
                            mode === "voucher-select"
                              ? getVariantCode(variant)
                              : String(variantIndex)
                          }
                          checked={
                            isSelected
                              ? selectedVariantIndex === variantIndex
                              : false
                          }
                          required={mode === "voucher-select"}
                        >
                          <span class="massage-card__variant-copy">
                            <span>{getVariantDuration(variant)}</span>
                            <strong>{variant.pricePLN} zł</strong>
                          </span>
                        </Radio>
                      ))}
                    </fieldset>
                    <p
                      class="massage-card__selection-error"
                      data-voucher-card-error={
                        mode === "voucher-select" ? "" : undefined
                      }
                      data-booking-card-error={
                        mode === "booking-select" ? "" : undefined
                      }
                      aria-live="polite"
                    />
                    <Button
                      type="button"
                      variant="secondary"
                      class="massage-card__action"
                      aria-pressed={
                        mode === "booking-select" ? isSelected : undefined
                      }
                      data-select-voucher={
                        mode === "voucher-select" ? "" : undefined
                      }
                      data-select-booking={
                        mode === "booking-select" ? "" : undefined
                      }
                    >
                      {mode === "booking-select"
                        ? "Wybieram ten masaż"
                        : "Wybieram ten voucher"}
                    </Button>
                  </div>
                )}
              </div>
            </article>
          </li>
        );
      })
    }
    {
      mode === "inquiry-select" &&
        inquiryOffers.map((offer) => (
          <li
            class="massage-card massage-card--inquiry"
            data-inquiry-offer-card
            data-inquiry-type={offer.id}
            data-inquiry-title={offer.title}
          >
            <article class="massage-card__inner">
              <div class="massage-card__media">
                <Img
                  src={offer.image}
                  alt={offer.imageAlt}
                  class="massage-card__image"
                  widths={[360, 520, 720]}
                  sizes="(max-width: 768px) 100vw, 33vw"
                />
              </div>

              <div class="massage-card__content">
                <div class="massage-card__copy">
                  <h3 class="massage-card__title">{offer.title}</h3>
                  <p class="massage-card__description">{offer.description}</p>
                </div>

                <Button
                  type="button"
                  variant="secondary"
                  class="massage-card__action"
                  aria-pressed="false"
                  data-select-inquiry
                >
                  {actionLabel}
                </Button>
              </div>
            </article>
          </li>
        ))
    }
  </ul>
</div>

<script>
  const syncVipSelectionMode = () => {
    const hasSelectedVip = Array.from(
      document.querySelectorAll<HTMLElement>("[data-vip-selection-scope]"),
    ).some((scope) =>
      scope.querySelector("[data-vip-offer] .massage-card--vip.is-selected"),
    );

    const hasPersistentVipMode =
      document.body.classList.contains("is-vip-service");

    const shouldUseVipMode = hasPersistentVipMode || hasSelectedVip;

    if (shouldUseVipMode) {
      clearVipSpotlight();
    }

    document.body.classList.toggle("is-active-vip", shouldUseVipMode);

    document.body.classList.toggle("is-vip-mode", shouldUseVipMode);
  };

  const updateVipSpotlightPosition = (vipOffer: HTMLElement) => {
    const rect = vipOffer.getBoundingClientRect();

    const centerX = rect.left + rect.width / 2;

    const centerY = rect.top + rect.height / 2;

    const radius = Math.max(rect.width, rect.height) * 0.64;

    document.body.style.setProperty("--vip-spotlight-x", `${centerX}px`);

    document.body.style.setProperty("--vip-spotlight-y", `${centerY}px`);

    document.body.style.setProperty("--vip-spotlight-radius", `${radius}px`);
  };

  const clearVipSpotlight = () => {
    document.body.classList.remove("is-vip-spotlight");

    document.body.style.removeProperty("--vip-spotlight-x");

    document.body.style.removeProperty("--vip-spotlight-y");

    document.body.style.removeProperty("--vip-spotlight-radius");
  };

  const initVipSelectionScopes = () => {
    document
      .querySelectorAll<HTMLElement>("[data-vip-selection-scope]")
      .forEach((scope) => {
        if (scope.dataset.vipSelectionInitialized === "true") {
          return;
        }

        scope.dataset.vipSelectionInitialized = "true";

        const controller = new AbortController();

        const vipOffer = scope.querySelector<HTMLElement>("[data-vip-offer]");

        const observer = new MutationObserver(syncVipSelectionMode);

        const hoverMedia = window.matchMedia(
          "(min-width: 64.0625rem) and (hover: hover) and (pointer: fine)",
        );

        observer.observe(scope, {
          attributes: true,
          attributeFilter: ["class"],
          subtree: true,
        });

        const activateSpotlight = () => {
          if (!vipOffer || !hoverMedia.matches) {
            return;
          }

          if (document.body.classList.contains("is-active-vip")) {
            return;
          }

          updateVipSpotlightPosition(vipOffer);

          document.body.classList.add("is-vip-spotlight");
        };

        const deactivateSpotlight = () => {
          clearVipSpotlight();
        };

        const activateKeyboardSpotlight = () => {
          if (!vipOffer || !hoverMedia.matches) {
            return;
          }

          if (document.body.classList.contains("is-active-vip")) {
            return;
          }

          const focusedElement = document.activeElement;

          if (
            !(focusedElement instanceof HTMLElement) ||
            !vipOffer.contains(focusedElement) ||
            !focusedElement.matches(":focus-visible")
          ) {
            return;
          }

          updateVipSpotlightPosition(vipOffer);
          document.body.classList.add("is-vip-spotlight");
        };

        vipOffer?.addEventListener("pointerenter", activateSpotlight, {
          signal: controller.signal,
        });

        vipOffer?.addEventListener("pointerleave", deactivateSpotlight, {
          signal: controller.signal,
        });

        vipOffer?.addEventListener("focusin", activateKeyboardSpotlight, {
          signal: controller.signal,
        });

        vipOffer?.addEventListener(
          "focusout",
          () => {
            requestAnimationFrame(() => {
              if (!vipOffer.matches(":has(:focus-visible)")) {
                clearVipSpotlight();
              }
            });
          },
          {
            signal: controller.signal,
          },
        );

        window.addEventListener(
          "resize",
          () => {
            if (
              vipOffer &&
              document.body.classList.contains("is-vip-spotlight")
            ) {
              updateVipSpotlightPosition(vipOffer);
            }
          },
          {
            signal: controller.signal,
          },
        );

        window.addEventListener(
          "scroll",
          () => {
            if (
              vipOffer &&
              document.body.classList.contains("is-vip-spotlight")
            ) {
              updateVipSpotlightPosition(vipOffer);
            }
          },
          {
            passive: true,
            signal: controller.signal,
          },
        );

        document.addEventListener(
          "astro:before-swap",
          () => {
            observer.disconnect();
            controller.abort();

            clearVipSpotlight();

            document.body.classList.remove("is-active-vip");

            document.body.classList.remove("is-vip-mode");
          },
          {
            once: true,
            signal: controller.signal,
          },
        );
      });

    syncVipSelectionMode();
  };

  const initMassageScrollSync = () => {
    document
      .querySelectorAll<HTMLElement>("[data-massage-scroll-sync]")
      .forEach((root) => {
        if (root.dataset.massageScrollInitialized === "true") {
          return;
        }

        root.dataset.massageScrollInitialized = "true";

        const topScroller = root.querySelector<HTMLElement>(
          "[data-massage-scroll-top]",
        );

        const content = root.querySelector<HTMLElement>(
          "[data-massage-scroll-content]",
        );

        const spacer = root.querySelector<HTMLElement>(
          "[data-massage-scroll-spacer]",
        );

        if (!topScroller || !content || !spacer) {
          return;
        }

        const controller = new AbortController();

        let frame: number | null = null;

        let syncing = false;

        const updateScrollbar = () => {
          const scrollWidth = content.scrollWidth;

          const clientWidth = content.clientWidth;

          const hasOverflow = scrollWidth > clientWidth + 1;

          spacer.style.width = `${scrollWidth}px`;

          topScroller.hidden = !hasOverflow;

          if (!hasOverflow) {
            topScroller.scrollLeft = 0;
            return;
          }

          topScroller.scrollLeft = content.scrollLeft;
        };

        const requestUpdate = () => {
          if (frame !== null) {
            return;
          }

          frame = window.requestAnimationFrame(() => {
            updateScrollbar();
            frame = null;
          });
        };

        const requestDelayedUpdate = () => {
          requestUpdate();

          window.requestAnimationFrame(() => {
            window.requestAnimationFrame(requestUpdate);
          });
        };

        topScroller.addEventListener(
          "scroll",
          () => {
            if (syncing) {
              return;
            }

            syncing = true;

            content.scrollLeft = topScroller.scrollLeft;

            syncing = false;
          },
          {
            passive: true,
            signal: controller.signal,
          },
        );

        content.addEventListener(
          "scroll",
          () => {
            if (syncing) {
              return;
            }

            syncing = true;

            topScroller.scrollLeft = content.scrollLeft;

            syncing = false;
          },
          {
            passive: true,
            signal: controller.signal,
          },
        );

        const resizeObserver = new ResizeObserver(requestUpdate);

        resizeObserver.observe(root);
        resizeObserver.observe(content);

        document.addEventListener("tabs:change", requestDelayedUpdate, {
          signal: controller.signal,
        });

        window.addEventListener("resize", requestDelayedUpdate, {
          signal: controller.signal,
        });

        root.querySelectorAll("img").forEach((image) => {
          if (image instanceof HTMLImageElement && !image.complete) {
            image.addEventListener("load", requestUpdate, {
              once: true,
              signal: controller.signal,
            });
          }
        });

        requestDelayedUpdate();

        document.addEventListener(
          "astro:before-swap",
          () => {
            if (frame !== null) {
              window.cancelAnimationFrame(frame);

              frame = null;
            }

            resizeObserver.disconnect();
            controller.abort();
          },
          {
            once: true,
            signal: controller.signal,
          },
        );
      });
  };

  const initMassageCards = () => {
    initVipSelectionScopes();
    initMassageScrollSync();
  };

  initMassageCards();

  document.addEventListener("astro:page-load", initMassageCards);
</script>
