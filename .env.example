# Contact delivery modes:
# console - logs message in terminal
# resend  - sends email using Resend
CONTACT_DELIVERY_MODE=console

# Resend email delivery
RESEND_API_KEY=
# In development, use a developer-owned test inbox as the recipient.
CONTACT_TO_EMAIL=
# A Resend test sender such as ORHEA <onboarding@resend.dev> can be used locally.
CONTACT_FROM_EMAIL=

# Booking customer notifications after admin mutations
# console - logs the message locally; resend - sends customer email
BOOKING_EMAIL_DELIVERY_MODE=console
BOOKING_EMAIL_FROM="ORHEA <onboarding@resend.dev>"

# Voucher delivery after a successful Stripe payment
# console - logs delivery locally; resend - sends customer email
VOUCHER_EMAIL_DELIVERY_MODE=resend
VOUCHER_EMAIL_FROM=

# Admin V1 authentication
# Password hash format: scrypt$<base64url-salt>$<base64url-hash>
# Administrator usernames must be unique.
# ADMIN_SESSION_SECRET must contain at least 32 random characters.
ADMIN_OWNER_USERNAME=
ADMIN_OWNER_PASSWORD_HASH=
ADMIN_ADRIAN_USERNAME=
ADMIN_ADRIAN_PASSWORD_HASH=
ADMIN_ALEKSANDRA_USERNAME=
ADMIN_ALEKSANDRA_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Google Calendar service account and temporary write-test endpoint
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_CALENDAR_TEST_ID=
GOOGLE_CALENDAR_TEST_API_KEY=

# Google Sheets reports (separate OAuth integration from Google Calendar)
# OAuth consent must include Google Sheets and Google Drive scopes.
GOOGLE_REPORTS_CLIENT_ID=
GOOGLE_REPORTS_CLIENT_SECRET=
GOOGLE_REPORTS_REFRESH_TOKEN=
# Must match the Google account that owns generated report files.
GOOGLE_REPORTS_OWNER_EMAIL=
# Optional. If empty, reports are created in the account's Drive root.
GOOGLE_REPORTS_FOLDER_ID=
