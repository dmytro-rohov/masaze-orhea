{
  "name": "astro-builder",
  "type": "module",
  "version": "0.0.2",
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.js",
    "dev": "astro dev",
    "start": "node ./dist/server/entry.mjs",
    "tokens": "tsx src/design-system/utils/cssVars.ts",
    "build-icons": "node scripts/build-icons.js",
    "build:fonts": "node scripts/build-fonts.js",
    "build:fonts:latin": "node scripts/build-fonts.js latin",
    "build:fonts:cyrillic": "node scripts/build-fonts.js cyrillic",
    "build:fonts:all": "node scripts/build-fonts.js all",
    "build:system": "npm run tokens && npm run build-icons && npm run build:fonts:latin",
    "build": "npm run build:system && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint:scss": "stylelint \"src/**/*.scss\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:scss && npm run lint:js",
    "validate": "npm run lint && npm run check && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed-db.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^178.1.1",
    "pg": "^8.23.0",
    "resend": "^6.18.1",
    "stripe": "^22.6.2",
    "swiper": "^14.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "fs-extra": "^11.3.3",
    "globals": "^17.9.0",
    "sass": "^1.97.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "svgo": "^4.0.0",
    "svgstore": "^3.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
